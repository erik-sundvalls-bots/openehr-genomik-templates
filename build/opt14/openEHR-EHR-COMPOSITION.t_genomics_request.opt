  <component_ontologies archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Referring diagnosis</items>
        <items id="description">Problem / diagnosis motivating the request (typically ICD-10).</items>
      </items>
      <items code="at0002">
        <items id="text">Problem/Diagnosis name</items>
        <items id="description">Identification of the problem or diagnosis, by name.</items>
      </items>
      <items code="at0003">
        <items id="text">Date/time clinically recognised</items>
        <items id="description">Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.</items>
      </items>
      <items code="at0005">
        <items id="text">Severity</items>
        <items id="description">An assessment of the overall severity of the problem or diagnosis.</items>
      </items>
      <items code="at0009">
        <items id="text">Clinical description</items>
        <items id="description">Narrative description about the problem or diagnosis.</items>
      </items>
      <items code="at0012">
        <items id="text">Body site</items>
        <items id="description">Identification of a simple body site for the location of the problem or diagnosis.</items>
      </items>
      <items code="at0030">
        <items id="text">Date/time of resolution</items>
        <items id="description">Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.</items>
      </items>
      <items code="at0039">
        <items id="text">Structured body site</items>
        <items id="description">A structured anatomical location for the problem or diagnosis.</items>
      </items>
      <items code="at0043">
        <items id="text">Specific details</items>
        <items id="description">Details that are additionally required to record as unique attributes of this problem or diagnosis.</items>
      </items>
      <items code="at0046">
        <items id="text">Status</items>
        <items id="description">Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.</items>
      </items>
      <items code="at0047">
        <items id="text">Mild</items>
        <items id="description">The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.</items>
      </items>
      <items code="at0048">
        <items id="text">Moderate</items>
        <items id="description">The problem or diagnosis causes interference with normal activity or will damage health if left untreated.</items>
      </items>
      <items code="at0049">
        <items id="text">Severe</items>
        <items id="description">The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.</items>
      </items>
      <items code="at0069">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the problem or diagnosis not captured in other fields.</items>
      </items>
      <items code="at0070">
        <items id="text">Last updated</items>
        <items id="description">The date this problem or diagnosis was last updated.</items>
      </items>
      <items code="at0071">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
      </items>
      <items code="at0072">
        <items id="text">Course description</items>
        <items id="description">Narrative description about the course of the problem or diagnosis since onset.</items>
      </items>
      <items code="at0073">
        <items id="text">Diagnostic certainty</items>
        <items id="description">The level of confidence in the identification of the diagnosis.</items>
      </items>
      <items code="at0074">
        <items id="text">Suspected</items>
        <items id="description">The diagnosis has been identified with a low level of certainty.</items>
      </items>
      <items code="at0075">
        <items id="text">Probable</items>
        <items id="description">The diagnosis has been identified with a high level of certainty.</items>
      </items>
      <items code="at0076">
        <items id="text">Confirmed</items>
        <items id="description">The diagnosis has been confirmed against recognised criteria.</items>
      </items>
      <items code="at0077">
        <items id="text">Date/time of onset</items>
        <items id="description">Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.</items>
      </items>
      <items code="at0078">
        <items id="text">Cause</items>
        <items id="description">A cause, set of causes, or manner of causation of the problem or diagnosis.</items>
      </items>
      <items code="at0079">
        <items id="text">Variant</items>
        <items id="description">Specific variant or subtype of the Diagnosis, if relevant.</items>
      </items>
      <items code="at0080">
        <items id="text">Impact</items>
        <items id="description">Overall assessment of the impact of a health problem for the specific patient.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Remitterande diagnos</items>
        <items id="description">Problem / diagnos som motiverar remissen (typiskt ICD-10).</items>
      </items>
      <items code="at0002">
        <items id="text">Benämning på problem/diagnos</items>
        <items id="description">Problemets eller diagnosens benämning.</items>
      </items>
      <items code="at0003">
        <items id="text">Datum och tid för klinisk bekräftelse</items>
        <items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först bekräftades av sjukvårdspersonal.</items>
      </items>
      <items code="at0005">
        <items id="text">Allvarlighetsgrad</items>
        <items id="description">En bedömning av problemets eller diagnosens totala allvarlighetsgrad.</items>
      </items>
      <items code="at0009">
        <items id="text">Klinisk beskrivning</items>
        <items id="description">Beskrivning av problemet eller diagnosen.</items>
      </items>
      <items code="at0012">
        <items id="text">Kroppslokalisation</items>
        <items id="description">Identifiering av problemets eller diagnosens anatomiska lokalisation.</items>
      </items>
      <items code="at0030">
        <items id="text">Datum och tid för tillfrisknande</items>
        <items id="description">Av sjukvårdspersonal uppskattat eller faktiskt datum och tid för tillfrisknande eller remission.</items>
      </items>
      <items code="at0039">
        <items id="text">Strukturerad kroppslokalisation</items>
        <items id="description">En strukturerad anatomisk lokalisation för problemet eller diagnosen.</items>
      </items>
      <items code="at0043">
        <items id="text">Specifika detaljer</items>
        <items id="description">Ytterligare detaljer som krävs för att dokumentera de egenskaper som är unika för problemet eller diagnosen.</items>
      </items>
      <items code="at0046">
        <items id="text">Status</items>
        <items id="description">Strukturerade specifika detaljer om den diagnostiska processen såsom plats, område, episod eller arbetsflöde.</items>
      </items>
      <items code="at0047">
        <items id="text">Lindrig</items>
        <items id="description">Problemet eller diagnosen påverkar inte normal aktivitet och kan inte orsaka skador på hälsan utan behandling.</items>
      </items>
      <items code="at0048">
        <items id="text">Måttlig</items>
        <items id="description">Problemet eller diagnosen stör normal aktivitet och kan skada hälsan utan behandling.</items>
      </items>
      <items code="at0049">
        <items id="text">Svår</items>
        <items id="description">Problemet eller diagnosen förhindrar normal aktivitet och kan allvarligt skada hälsan utan behandling.</items>
      </items>
      <items code="at0069">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligare beskrivning av problemet eller diagnosen som inte dokumenterats i andra fält.</items>
      </items>
      <items code="at0070">
        <items id="text">Senast uppdaterad</items>
        <items id="description">Datum då dokumentation om problemet eller diagnosen senast uppdaterades.</items>
      </items>
      <items code="at0071">
        <items id="text">Tilläggsinformation</items>
        <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
      </items>
      <items code="at0072">
        <items id="text">Förlopp</items>
        <items id="description">Beskrivning av problemets eller diagnosens förlopp sedan debuten.</items>
      </items>
      <items code="at0073">
        <items id="text">Diagnostisk säkerhet</items>
        <items id="description">Graden av säkerhet vid fastställande av diagnosen.</items>
      </items>
      <items code="at0074">
        <items id="text">Misstänkt</items>
        <items id="description">Diagnosen har bekräftats med en låg grad av säkerhet.</items>
      </items>
      <items code="at0075">
        <items id="text">Sannolik</items>
        <items id="description">Diagnosen har bekräftats med en hög grad av säkerhet.</items>
      </items>
      <items code="at0076">
        <items id="text">Bekräftad</items>
        <items id="description">Diagnosen har bekräftats utifrån kända kriterier.</items>
      </items>
      <items code="at0077">
        <items id="text">Datum och tid för debut</items>
        <items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.</items>
      </items>
      <items code="at0078">
        <items id="text">Orsak</items>
        <items id="description">En eller flera orsaker till problemet eller diagnosen, eller dess uppkomstsätt.</items>
      </items>
      <items code="at0079">
        <items id="text">Specificering</items>
        <items id="description">Specificering av diagnosen, där det är relevant.</items>
      </items>
      <items code="at0080">
        <items id="text">Påverkan</items>
        <items id="description">Övergripande bedömning av hur ett hälsoproblem påverkar patienten.</items>
      </items>
    </term_definitions>
  </component_ontologies>
</template>
