archetype (adl_version=1.4; rm_release=1.0.4; generated)
    openEHR-EHR-CLUSTER.genomic_copy_number_variant-cancer.v1

specialize
    openEHR-EHR-CLUSTER.genomic_copy_number_variant.v1

concept
    [at0000.1]    -- Genomic copy number variant (cancer)

language
    original_language = <[ISO_639-1::en]>
    translations = <
            ["sv"] = <
                language = <[ISO_639-1::sv]>
                author = <
                    ["name"] = <"Erik Sundvall / RCC Genomik (draft)">
                    ["organisation"] = <"Regionala cancercentrum i samverkan / Karolinska">
                >
            >
