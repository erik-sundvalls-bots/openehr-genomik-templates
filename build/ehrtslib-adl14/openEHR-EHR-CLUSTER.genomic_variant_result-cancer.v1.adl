                    description = <"Variant bedömd som troligen germline.">
                >
                ["at0.5"] = <
                    text = <"Okänt ursprung">
                    description = <"Genetiskt ursprung ej fastställt.">
                >
                ["at0.10"] = <
                    text = <"Tier I-A">
