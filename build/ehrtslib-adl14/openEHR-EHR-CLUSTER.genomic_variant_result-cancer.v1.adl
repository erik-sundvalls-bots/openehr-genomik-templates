                    text = <"Missense-variant">
                    description = <"Sekvensvariant som ändrar en eller flera baser och ger en annan aminosyrasekvens med bibehållen längd. (SO:0001583)">
                >
                ["at0.41"] = <
                    text = <"Nonsensvariant (stop gained)">
                    description = <"Sekvensvariant där minst en bas i ett kodon ändras så att ett förtida stoppkodon uppstår och transkriptet förkortas. (SO:0001587)">
                >
                ["at0.42"] = <
                    text = <"Läsramsförskjutningsvariant">
                    description = <"Sekvensvariant som bryter den translationella läsramen eftersom antalet insererade eller deleterade nukleotider inte är en multipel av tre. (SO:0001589)">
                >
                ["at0.43"] = <
                    text = <"Synonym variant">
                    description = <"Sekvensvariant som inte ändrar den kodade aminosyran. (SO:0001819)">
                >
                ["at0.44"] = <
                    text = <"Förlust av startkodon">
                    description = <"Kodonvariant som ändrar minst en bas i det kanoniska startkodonet. (SO:0002012)">
                >
                ["at0.45"] = <
                    text = <"Förlust av stoppkodon">
                    description = <"Sekvensvariant där minst en bas i stoppkodonet ändras så att transkriptet förlängs. (SO:0001578)">
                >
                ["at0.46"] = <
                    text = <"Insertion i läsram">
                    description = <"Icke-synonym variant i läsram som infogar baser i den kodande sekvensen. (SO:0001821)">
                >
                ["at0.47"] = <
                    text = <"Deletion i läsram">
                    description = <"Icke-synonym variant i läsram som tar bort baser från den kodande sekvensen. (SO:0001822)">
                >
