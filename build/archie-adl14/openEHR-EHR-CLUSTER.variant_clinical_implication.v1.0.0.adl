archetype (adl_version=1.4; rm_release=1.1.0; generated)
    openEHR-EHR-CLUSTER.variant_clinical_implication.v1


concept
    [at0001]    -- Variant clinical implication


language
    original_language = <[ISO_639-1::en]>
    translations = <
        ["sv"] = <
            language = <[ISO_639-1::sv]>
            author = <
                ["name"] = <"Erik Sundvall / RCC Genomik (draft)">
                ["organisation"] = <"Regionala cancercentrum i samverkan / Karolinska">
            >
        >
    >

description
    original_author = <
        ["name"] = <"Erik Sundvall / RCC Genomik (draft)">
        ["organisation"] = <"Regionala cancercentrum i samverkan">
        ["email"] = <"erik.sundvall@regionstockholm.se">
        ["date"] = <"2026-10-15">
    >
    lifecycle_state = <"unmanaged">
    custodian_namespace = <"se.rcc">
    custodian_organisation = <"Regionala cancercentrum i samverkan">
    licence = <"Creative Commons Attribution-ShareAlike 4.0 International">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Reusable cluster for diagnostic or therapeutic implications of a genomic variant, with identifier, status, implication type, and optional linked therapy/diagnosis text. Designed for nesting under genomic_variant_result-cancer Clinical implication slot, aligning with FHIR Genomics IG DiagnosticImplication and TherapeuticImplication Observations.">
            keywords = <"implication", "diagnostic", "therapeutic", "genomic", "FHIR Genomics">
            use = <"Include 0..* under a variant result. Use Implication type to distinguish diagnostic vs therapeutic. Status mirrors FHIR Observation.status. Identifier supports FHIR-style linkage (Observation.identifier).">
            misuse = <"Do not use as a standalone clinical diagnosis — use EVALUATION.problem_diagnosis for patient diagnoses. Do not encode ASCO/ESCAT here when those elements exist on the parent variant specialisation.">
            copyright = <"© Regionala cancercentrum i samverkan">
        >
        ["sv"] = <
            language = <[ISO_639-1::sv]>
            purpose = <"Återanvändbart kluster för diagnostisk eller terapeutisk implikation av en genomisk variant.">
            keywords = <"implikation", "diagnostisk", "terapeutisk", "genomik">
            use = <"Inkludera 0..* under ett variantresultat. Använd Implikationstyp för att skilja diagnostisk vs terapeutisk.">
            misuse = <"Använd inte som fristående klinisk diagnos.">
            copyright = <"© Regionala cancercentrum i samverkan">
        >
    >

definition
    CLUSTER[at0001] matches {    -- Variant clinical implication
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- Implication identifier
                value matches {
                    DV_IDENTIFIER[at0003]
                }
            }
            ELEMENT[at0004] occurrences matches {1} matches {    -- Implication type
                value matches {
                    DV_CODED_TEXT[at0005] matches {
                        defining_code matches {[local::at1, at2]}
                    }
                }
            }
            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Status
                value matches {
                    DV_CODED_TEXT[at0007] matches {
                        defining_code matches {[local::at3, at4, at5, at6]}
                    }
                }
            }
            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Summary
                value matches {
                    DV_TEXT[at0009]
                }
            }
            ELEMENT[at0010] occurrences matches {0..*} matches {    -- Related therapy or finding
                value matches {
                    DV_TEXT[at0011]
                    DV_CODED_TEXT[at0012]
                }
            }
            ELEMENT[at0013] occurrences matches {0..1} matches {    -- Linked variant reference
                value matches {
                    DV_URI[at0014]
                    DV_IDENTIFIER[at0015]
                }
            }
        }
    }

ontology
    term_definitions = <
        ["en"] = <
            items = <
            ["at0001"] = <
                text = <"Variant clinical implication">
                description = <"A diagnostic or therapeutic implication derived from a genomic variant finding.">
            >
            ["at0002"] = <
                text = <"Implication identifier">
                description = <"Business identifier for this implication entry (FHIR Observation.identifier).">
            >
            ["at0004"] = <
                text = <"Implication type">
                description = <"Whether this implication is diagnostic or therapeutic.">
            >
            ["at0006"] = <
                text = <"Status">
                description = <"Lifecycle status of the implication (e.g. preliminary, final, amended).">
            >
            ["at0008"] = <
                text = <"Summary">
                description = <"Free-text summary of the clinical implication.">
            >
            ["at0010"] = <
                text = <"Related therapy or finding">
                description = <"Associated drug, therapy class, or diagnostic finding text/code.">
            >
            ["at0013"] = <
                text = <"Linked variant reference">
                description = <"Optional explicit link back to the source variant when implications are stored separately.">
            >
            ["at1"] = <
                text = <"Diagnostic">
                description = <"Implication affects diagnosis, subtype, or prognosis classification.">
            >
            ["at2"] = <
                text = <"Therapeutic">
                description = <"Implication affects treatment choice or eligibility.">
            >
