  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.anatomical_location.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Anatomical location</items>
        <items id="description">Body site and laterality of collection.</items>
      </items>
      <items code="at0001">
        <items id="text">Body site name</items>
        <items id="description">Identification of a single physical site either on, or within, the human body.</items>
      </items>
      <items code="at0002">
        <items id="text">Laterality</items>
        <items id="description">The side of the body on which the identified body site is located.</items>
      </items>
      <items code="at0003">
        <items id="text">Left</items>
        <items id="description">Left side of the body.</items>
      </items>
      <items code="at0004">
        <items id="text">Right</items>
        <items id="description">Right side of the body.</items>
      </items>
      <items code="at0023">
        <items id="text">Description</items>
        <items id="description">Narrative description that can be used to further refine and support the 'Body site name'.</items>
      </items>
      <items code="at0053">
        <items id="text">Alternative structure</items>
        <items id="description">Additional detail about the anatomical site using alternative approaches to describe the same body site.</items>
      </items>
      <items code="at0054">
        <items id="text">Multimedia representation</items>
        <items id="description">Image or other media used to support identification of the body site.</items>
      </items>
      <items code="at0055">
        <items id="text">Anatomical Line</items>
        <items id="description">Additional detail using theoretical lines drawn through anatomical structures used to provide a consistent reference point on the human body.</items>
      </items>
      <items code="at0056">
        <items id="text">Midaxillary line</items>
        <items id="description">Line running vertically down the surface of the body, passing through the apex of the axilla.</items>
      </items>
      <items code="at0057">
        <items id="text">Anterior axillary line</items>
        <items id="description">Line running vertically down the surface of the body, passing through the anterior axillary skinfold.</items>
      </items>
      <items code="at0058">
        <items id="text">Posterior axillary line</items>
        <items id="description">Line running vertically down the surface of the body, passing through the posterior axillary skinfold.</items>
      </items>
      <items code="at0059">
        <items id="text">Mid-clavicular line</items>
        <items id="description">Line running vertically down the surface of the body, parallel to the midline and passing through the midpoint of the clavicle.</items>
      </items>
      <items code="at0060">
        <items id="text">Mid-pupillary line</items>
        <items id="description">Line running vertically down the face through the midpoint of the pupil when looking directly forward.</items>
      </items>
      <items code="at0062">
        <items id="text">Midline</items>
        <items id="description">Line running vertically which divides the body into left and right portions, passing through the head, spinal cord, and umbilicus. Alternatively it can refer to a line dividing a body part into two equal portions, for example a digit.</items>
      </items>
      <items code="at0063">
        <items id="text">Mid-scapular line</items>
        <items id="description">Line running vertically down the posterior surface of the body, parallel to the midline and passing through the inferior point of the scapula.</items>
      </items>
      <items code="at0064">
        <items id="text">Aspect</items>
        <items id="description">Qualifying detail about the specific aspect of the identified body site.</items>
      </items>
      <items code="at0065">
        <items id="text">Specific site</items>
        <items id="description">Additional detail using a specific region or a point on, or within, the identified body site.</items>
      </items>
      <items code="at0067">
        <items id="text">Medial</items>
        <items id="description">Towards the midline of the body site.</items>
      </items>
      <items code="at0068">
        <items id="text">Lateral</items>
        <items id="description">Towards the side, or edge, of the body site.</items>
      </items>
      <items code="at0069">
        <items id="text">Superior</items>
        <items id="description">Above the body site, often meaning towards the head.</items>
      </items>
      <items code="at0070">
        <items id="text">Inferior</items>
        <items id="description">Below the body site, often meaning towards the feet.</items>
      </items>
      <items code="at0071">
        <items id="text">Anterior</items>
        <items id="description">Towards the front, or ventral surface, of the body site.</items>
      </items>
      <items code="at0072">
        <items id="text">Posterior</items>
        <items id="description">Towards the back, or dorsal surface, of the body site.</items>
      </items>
      <items code="at0073">
        <items id="text">Proximal</items>
        <items id="description">More central or closer to the point of attachment, and usually describing part of a limb, digit or appendage.</items>
      </items>
      <items code="at0074">
        <items id="text">Distal</items>
        <items id="description">More peripheral, or further from the point of attachment, and usually describing part of a limb, digit or appendage.</items>
      </items>
      <items code="at0075">
        <items id="text">Palmar</items>
        <items id="description">Towards the palm of the hand.</items>
      </items>
      <items code="at0076">
        <items id="text">Plantar</items>
        <items id="description">Towards the sole of the foot.</items>
      </items>
      <items code="at0077">
        <items id="text">Mid</items>
        <items id="description">In the middle of the body site.</items>
      </items>
      <items code="at0078">
        <items id="text">Oral</items>
        <items id="description">Towards the mouth. Usually used to describe locations within the digestive system.</items>
      </items>
      <items code="at0079">
        <items id="text">Anal</items>
        <items id="description">Towards the anus. Usually used to describe locations within the digestive system.</items>
      </items>
      <items code="at0080">
        <items id="text">Deep</items>
        <items id="description">Away from the surface of the body site.</items>
      </items>
      <items code="at0081">
        <items id="text">Superficial</items>
        <items id="description">Towards the surface of the body site.</items>
      </items>
      <items code="at0082">
        <items id="text">Dorsal</items>
        <items id="description">Towards the back of the hand or top of the foot. To be used as opposites of palmar or plantar, not as a synonym of posterior.</items>
      </items>
      <items code="at0083">
        <items id="text">Right and left</items>
        <items id="description">Both the right and left sides of the body, or involving both sides of a paired organ, body structure, or anatomical region.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Anatomisk lokalisation</items>
        <items id="description">Kroppsplats och lateralitet vid provtagning.</items>
      </items>
      <items code="at0001">
        <items id="text">Kroppslokalisation</items>
        <items id="description">Identifiering av enskilt fysiskt ställe på eller i människokroppen.</items>
      </items>
      <items code="at0002">
        <items id="text">Lateralitiet</items>
        <items id="description">Den sidan av kroppen där det identifierade kroppstället är lokaliserad. 
  </items>
      </items>
      <items code="at0003">
        <items id="text">Vänster</items>
        <items id="description">Kroppens vänster sida.</items>
      </items>
      <items code="at0004">
        <items id="text">Höger</items>
        <items id="description">Kroppens högra sida.</items>
      </items>
      <items code="at0023">
        <items id="text">Beskrivning</items>
        <items id="description">Beskrivning för att ytterligare specificera och detaljera "Namn på kroppsställe".</items>
      </items>
      <items code="at0053">
        <items id="text">Alternativ kroppsstruktur</items>
        <items id="description">Ytterligare information om den anatomiska lokalisationen med hjälp av ett alternativt sätt för att beskriva samma kroppsstruktur.</items>
      </items>
      <items code="at0054">
        <items id="text">Multimediarepresentation</items>
        <items id="description">Bild eller annat medium som används för att stödja identifiering av kroppslokalisation.</items>
      </items>
      <items code="at0055">
        <items id="text">Anatomisk linje</items>
        <items id="description">Ytterligare detaljer med hjälp av teoretiska linjer ritade genom anatomiska strukturer som används för att ge en konsekvent referenspunkt på människokroppen.</items>
      </items>
      <items code="at0056">
        <items id="text">Mellersta axillarlinjen</items>
        <items id="description">En vertikal linje som går över kroppsytan genom axillspetsen.</items>
      </items>
      <items code="at0057">
        <items id="text">Främre axillarlinjen</items>
        <items id="description">En linje som löper vertikalt ner över kroppens yta och passerar genom det främre axillära hudvecket.</items>
      </items>
      <items code="at0058">
        <items id="text">Bakre axillarlinje</items>
        <items id="description">En linje som löper vertikalt ner över kroppens yta och passerar genom det bakre axillära hudvecket.</items>
      </items>
      <items code="at0059">
        <items id="text">Medioklavikularlinje</items>
        <items id="description">En linje som löper vertikalt ner på kroppens yta, parallellt med mittlinjen och passerar genom nyckelbenets mittpunkt.</items>
      </items>
      <items code="at0060">
        <items id="text">Mellersta pupillinjen</items>
        <items id="description">En linje som löper vertikalt längs ansiktet genom pupillens mittpunkt när man tittar direkt framåt.</items>
      </items>
      <items code="at0062">
        <items id="text">Mittlinje</items>
        <items id="description">En vertikal linje som delar in kroppen i vänster och höger halva. Den går genom huvud, ryggmärg och navel. Alternativt åsyftas en linje som delar in en kroppsdel i två lika stora delar, exempelvis en tå eller ett finger.</items>
      </items>
      <items code="at0063">
        <items id="text">Mellersta skapularlinjen</items>
        <items id="description">En linje som löper vertikalt längs kroppens bakre yta, parallellt med mittlinjen och passerar genom den lägre punkten på skulderbladet.</items>
      </items>
      <items code="at0064">
        <items id="text">Del</items>
        <items id="description">Kvalificerande detalj om den specifika delen av den identifierade kroppstället.
  
  </items>
      </items>
      <items code="at0065">
        <items id="text">Preciserad kroppslokalisation</items>
        <items id="description">Ytterligare detalj angiven som ett specifikt område eller en punkt på eller i den identifierade kropplokalisationen.</items>
      </items>
      <items code="at0067">
        <items id="text">Medial</items>
        <items id="description">Mot mittlinjen av kroppslokalisationen.</items>
      </items>
      <items code="at0068">
        <items id="text">Lateral</items>
        <items id="description">Mot sida eller kant av kroppslokalisationen.</items>
      </items>
      <items code="at0069">
        <items id="text">Superior</items>
        <items id="description">Ovanför kroppslokalisationen, ofta i betydelsen i riktning mot huvudet.</items>
      </items>
      <items code="at0070">
        <items id="text">Inferior</items>
        <items id="description">Nedanför kroppslokalisationen, ofta i betydelsen i riktning mot fötterna.</items>
      </items>
      <items code="at0071">
        <items id="text">Främre</items>
        <items id="description">Mot den främre eller ventrala ytan av kroppslokalisationen.</items>
      </items>
      <items code="at0072">
        <items id="text">Bakre</items>
        <items id="description">Bakre delen eller dorsala ytan av kroppslokalisationen.</items>
      </items>
      <items code="at0073">
        <items id="text">Proximal</items>
        <items id="description">Mer central eller närmare fastsättningspunkten, vanligtvis en beskrivning av en del av extremitet, finger, tå eller bihang.</items>
      </items>
      <items code="at0074">
        <items id="text">Distal</items>
        <items id="description">Mer perifert, eller längre bort från fästsättningspunkten, och beskriver vanligtvis en del av extremitet, finger, tå eller bihang.</items>
      </items>
      <items code="at0075">
        <items id="text">Palmar</items>
        <items id="description">I riktning mot handflatan.</items>
      </items>
      <items code="at0076">
        <items id="text">Plantar</items>
        <items id="description">I riktning mot fotsulan.</items>
      </items>
      <items code="at0077">
        <items id="text">I mitten av</items>
        <items id="description">I mitten av kroppslokalisationen.</items>
      </items>
      <items code="at0078">
        <items id="text">Oral</items>
        <items id="description">I riktning mot munnen. Används vanligtvis för att beskriva platser i matspjälkningssystemet.
  
  </items>
      </items>
      <items code="at0079">
        <items id="text">Anal</items>
        <items id="description">I riktning mot anus. Används vanligtvis för att beskriva lokalisation inom matspjälkningssystemet.</items>
      </items>
      <items code="at0080">
        <items id="text">Djup</items>
        <items id="description">I riktning bort från kroppslokalisationens yta.</items>
      </items>
      <items code="at0081">
        <items id="text">Ytlig</items>
        <items id="description">I riktning mot kroppslokalisationens yta.</items>
      </items>
      <items code="at0082">
        <items id="text">Dorsal</items>
        <items id="description">I riktning mot handens baksida eller fotens ovansida. Används som motsats till palmar och plantar, inte som en synonym till bakre.</items>
      </items>
      <items code="at0083">
        <items id="text">Höger och vänster</items>
        <items id="description">Både höger och vänster sida av kroppen, eller omfattande båda sidor av ett parigt organ, en kroppsstruktur eller en anatomisk region.</items>
      </items>
    </term_definitions>
    <term_bindings terminology="SNOMED-CT">
      <items code="at0002">
        <value>
          <terminology_id>
            <value>SNOMED-CT</value>
          </terminology_id>
          <code_string>272741003</code_string>
        </value>
      </items>
      <items code="at0003">
        <value>
          <terminology_id>
            <value>SNOMED-CT</value>
          </terminology_id>
          <code_string>7771000</code_string>
        </value>
      </items>
      <items code="at0004">
        <value>
          <terminology_id>
            <value>SNOMED-CT</value>
          </terminology_id>
          <code_string>24028007</code_string>
        </value>
      </items>
      <items code="at0083">
        <value>
          <terminology_id>
            <value>SNOMED-CT</value>
          </terminology_id>
          <code_string>51440002</code_string>
        </value>
      </items>
    </term_bindings>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.specimen_processing.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Specimen processing</items>
        <items id="description">Fixation and other processing (e.g. FFPE); in Additional details slot.</items>
      </items>
      <items code="at0071">
        <items id="text">Sequence</items>
        <items id="description">The sequence number within a multi-step sequence.</items>
      </items>
      <items code="at0074">
        <items id="text">Method</items>
        <items id="description">The technique or method used to process the specimen.</items>
      </items>
      <items code="at0086">
        <items id="text">Process activity</items>
        <items id="description">Details of a single activity carried out during a multi-step process.</items>
      </items>
      <items code="at0088">
        <items id="text">Device details</items>
        <items id="description">Details of the device used in the processing activity.</items>
      </items>
      <items code="at0089">
        <items id="text">Description</items>
        <items id="description">A narrative description of the processing activity.</items>
      </items>
      <items code="at0091">
        <items id="text">Additive</items>
        <items id="description">Identification of a substance used in the processing.</items>
      </items>
      <items code="at0092">
        <items id="text">Process activity details</items>
        <items id="description">Details about a single activity within a multistep process.</items>
      </items>
      <items code="at0093">
        <items id="text">Additional details</items>
        <items id="description">Additional details about the processing of a specimen.</items>
      </items>
      <items code="at0094">
        <items id="text">Process name</items>
        <items id="description">The name of the processing activity.</items>
      </items>
      <items code="at0095">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the processing of a specimen not captured in other fields.</items>
      </items>
      <items code="at0096">
        <items id="text">Start date/time</items>
        <items id="description">The date and time when the process activity started.</items>
      </items>
      <items code="at0097">
        <items id="text">End date/time</items>
        <items id="description">The date and time when the process activity ended.</items>
      </items>
      <items code="">
        <items id="text">Fixation method</items>
        <items id="description">Coded fixation / preservation method.</items>
      </items>
      <items code="at0.1">
        <items id="text">Formalin-Fixed Paraffin-Embedded</items>
        <items id="description">Fixation / preservation method.</items>
      </items>
      <items code="at0.2">
        <items id="text">Fresh (unfixed, incl. frozen)</items>
        <items id="description">Fixation / preservation method.</items>
      </items>
      <items code="at0.3">
        <items id="text">Other</items>
        <items id="description">Fixation / preservation method.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Provbearbetning</items>
        <items id="description">Fixering och annan bearbetning (t.ex. FFPE); i Additional details-slot.</items>
      </items>
      <items code="at0071">
        <items id="text">Ordningsnummer</items>
        <items id="description">Ordningsnumret inom en process i flera steg.</items>
      </items>
      <items code="at0074">
        <items id="text">Metod</items>
        <items id="description">Tekniken eller metoden som används för att bearbeta provet.</items>
      </items>
      <items code="at0086">
        <items id="text">Processaktivitet</items>
        <items id="description">Detaljer om en enskild aktivitet i en process i flera steg.</items>
      </items>
      <items code="at0088">
        <items id="text">Instrumentdetaljer</items>
        <items id="description">Detaljer om instrumentet som används i bearbetningsaktiviteten.</items>
      </items>
      <items code="at0089">
        <items id="text">Beskrivning</items>
        <items id="description">Fritextbeskrivning av bearbetningsaktiviteten.</items>
      </items>
      <items code="at0091">
        <items id="text">Tillsats</items>
        <items id="description">Identifiering av en substans som används i bearbetningen.</items>
      </items>
      <items code="at0092">
        <items id="text">Detaljer om processaktivitet</items>
        <items id="description">Detaljer om en enskild aktivitet i en process i flera steg.</items>
      </items>
      <items code="at0093">
        <items id="text">Ytterligare detaljer</items>
        <items id="description">Ytterligare detaljer om bearbetningen av ett prov.</items>
      </items>
      <items code="at0094">
        <items id="text">Processnamn</items>
        <items id="description">Namnet på bearbetningsaktiviteten.</items>
      </items>
      <items code="at0095">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligare fritext om bearbetningen av ett prov som inte fångats i andra fält.</items>
      </items>
      <items code="at0096">
        <items id="text">Startdatum/-tid</items>
        <items id="description">Datum och tid då processaktiviteten startade.</items>
      </items>
      <items code="at0097">
        <items id="text">Slutdatum/-tid</items>
        <items id="description">Datum och tid då processaktiviteten avslutades.</items>
      </items>
      <items code="">
        <items id="text">Fixeringsmetod</items>
        <items id="description">Kodad fixerings-/konserveringsmetod.</items>
      </items>
      <items code="at0.1">
        <items id="text">Formalinfixerad paraffinbäddad vävnad</items>
        <items id="description">Fixation / preservation method.</items>
      </items>
      <items code="at0.2">
        <items id="text">Färsk/ofixerad vävnad (inkl. fryst)</items>
        <items id="description">Fixation / preservation method.</items>
      </items>
      <items code="at0.3">
        <items id="text">Annat</items>
        <items id="description">Fixation / preservation method.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.laboratory_test_analyte.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">TMB</items>
        <items id="description">Tumor mutational burden analyte (mut/Mb).</items>
      </items>
      <items code="at0001">
        <items id="text">Analyte result</items>
        <items id="description">The value of the analyte result.</items>
      </items>
      <items code="at0003">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the analyte result, not captured in other fields.</items>
      </items>
      <items code="at0004">
        <items id="text">Reference range guidance</items>
        <items id="description">Additional advice on the applicability of the reference range to this result or may carry text or coded textual guidance as to whether the result is within the normal range.</items>
      </items>
      <items code="at0005">
        <items id="text">Result status</items>
        <items id="description">The status of the analyte result value.</items>
      </items>
      <items code="at0006">
        <items id="text">Result status time</items>
        <items id="description">The date and time that the analyte result was issued for the recorded ‘Result status’.</items>
      </items>
      <items code="at0014">
        <items id="text">Analyte result detail</items>
        <items id="description">Further detail regarding an individual result.</items>
      </items>
      <items code="at0015">
        <items id="text">Registered</items>
        <items id="description">The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.</items>
      </items>
      <items code="at0016">
        <items id="text">Partial</items>
        <items id="description">This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.</items>
      </items>
      <items code="at0017">
        <items id="text">Preliminary</items>
        <items id="description">Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.</items>
      </items>
      <items code="at0018">
        <items id="text">Final</items>
        <items id="description">The Test result is complete and verified by an authorised person.</items>
      </items>
      <items code="at0019">
        <items id="text">Corrected</items>
        <items id="description">The result has been modified subsequent to being Final, and is complete and verified by an authorised person. This is a sub-category of 'Amended'.</items>
      </items>
      <items code="at0020">
        <items id="text">Amended</items>
        <items id="description">The result has been modified subsequent to being Final, and is complete and verified by an authorised person, and result data has been changed.</items>
      </items>
      <items code="at0021">
        <items id="text">Appended</items>
        <items id="description">Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.</items>
      </items>
      <items code="at0022">
        <items id="text">Entered in error</items>
        <items id="description">The Test Result has been withdrawn following previous Final release.</items>
      </items>
      <items code="at0023">
        <items id="text">Cancelled</items>
        <items id="description">The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').</items>
      </items>
      <items code="at0024">
        <items id="text">Analyte name</items>
        <items id="description">The name of the analyte result.</items>
      </items>
      <items code="at0025">
        <items id="text">Validation time</items>
        <items id="description">The date and time that the analyte result was validated in the laboratory by a healthcare practitioner.</items>
      </items>
      <items code="at0026">
        <items id="text">Specimen</items>
        <items id="description">Identification of the specimen used for the analyte result.</items>
      </items>
      <items code="at0027">
        <items id="text">Analyte result sequence</items>
        <items id="description">The intended position of this analyte result within the overall sequence of analyte results.</items>
      </items>
      <items code="at0028">
        <items id="text">Test method</items>
        <items id="description">Description about the method used to perform the test on this analyte only.</items>
      </items>
      <items code="at0031">
        <items id="text">Analysis performed time</items>
        <items id="description">The date and time when the analyte result was performed in the laboratory by a healthcare practitioner.</items>
      </items>
      <items code="at0032">
        <items id="text">Accredited</items>
        <items id="description">Indicates whether the analytical method used for this analyte is accredited.</items>
      </items>
      <items code="">
        <items id="text">Analyte name</items>
        <items id="description">Fixed to TMB / Tumor mutational burden.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">TMB</items>
        <items id="description">Tumörmutationsbörda (mut/Mb).</items>
      </items>
      <items code="at0001">
        <items id="text">Analysresultat</items>
        <items id="description">Analysresultatets värde</items>
      </items>
      <items code="at0003">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligare fritext om analysresultatet som inte fångas av andra dataelement.</items>
      </items>
      <items code="at0004">
        <items id="text">Vägledning för referensintervall</items>
        <items id="description">Ytterligare vägledning för information om referensintervallet är tillämpbart för detta resultat. Kan innehålla text eller kodad text med råd om huruvida resultatet ligger inom det normala intervallet.
  </items>
      </items>
      <items code="at0005">
        <items id="text">Resultatstatus</items>
        <items id="description">Status för analysresultatet.</items>
      </items>
      <items code="at0006">
        <items id="text">Tidsangivelse för resultatstatus</items>
        <items id="description">Datum och tid då analysresultatet utfärdades för den aktuella resultatstatusen.</items>
      </items>
      <items code="at0014">
        <items id="text">Detaljer om analysresultat</items>
        <items id="description">Ytterligare detaljer om ett enskilt analysresultat.</items>
      </items>
      <items code="at0015">
        <items id="text">Registrerad</items>
        <items id="description">Analysen är registrerad i laboratoriesystemet, men resultatet är ej ännu tillgängligt.
  
  </items>
      </items>
      <items code="at0016">
        <items id="text">Partiellt resultat</items>
        <items id="description">Detta är ett partiellt (dvs. initialt eller preliminärt) testresultat: Data i resultatet kan vara ofullständiga eller obekräftade.</items>
      </items>
      <items code="at0017">
        <items id="text">Preliminärt resultat</items>
        <items id="description">Verifierade tidiga resultat är tillgängliga, men inte alla resultat är slutgiltiga. Detta är en underkategori av "Partiellt resultat".</items>
      </items>
      <items code="at0018">
        <items id="text">Slutgiltigt resultat</items>
        <items id="description">Testresultatet är fullständigt och verifierat av en auktoriserad person.</items>
      </items>
      <items code="at0019">
        <items id="text">Slutgiltigt resultat, korrigerat</items>
        <items id="description">Resultatet har korrigerats efter att tidigare ha varit markerat som slutgiltigt. Detta är en underkategori av "Slutgiltigt resultat, reviderat".</items>
      </items>
      <items code="at0020">
        <items id="text">Slutgiltigt resultat, reviderat</items>
        <items id="description">Resultatet har reviderats och ändrats efter att tidigare ha varit markerat som slutgiltigt.</items>
      </items>
      <items code="at0021">
        <items id="text">Slutgiltigt resultat, tillägg</items>
        <items id="description">Efter att ha slutförts har resultatrapporten ändrats genom att nytt innehåll har inkluderats. Det befintliga innehållet är oförändrat. Detta är en underkategori av ”Slutgiltigt svar, reviderat”.</items>
      </items>
      <items code="at0022">
        <items id="text">Felaktigt registrerat resultat</items>
        <items id="description">Analysresultatet har dragits tillbaka efter att ha varit i status "Slutgiltigt resultat".</items>
      </items>
      <items code="at0023">
        <items id="text">Avbrutet</items>
        <items id="description">Resultatet är inte tillgängligt eftersom testet inte har startats eller inte slutförts (kallas även ibland för "inställt").</items>
      </items>
      <items code="at0024">
        <items id="text">Analysnamn</items>
        <items id="description">Namnet på analysen.</items>
      </items>
      <items code="at0025">
        <items id="text">Tidpunkt för validering</items>
        <items id="description">Datum och tid då analysresultatet validerades medicinskt i laboratoriet.
  </items>
      </items>
      <items code="at0026">
        <items id="text">Provmaterial</items>
        <items id="description">Identifiering av det provmaterial som använts för analysresultatet.</items>
      </items>
      <items code="at0027">
        <items id="text">Rapporteringsordning</items>
        <items id="description">Den faktiska positionen för ett enskilt analysresultat i den totala rapporteringsordningen.
  
  
  
  </items>
      </items>
      <items code="at0028">
        <items id="text">Testmetod</items>
        <items id="description">Beskrivning av metoden som har använts för att utföra testet specifikt för denna analyt.
  </items>
      </items>
      <items code="at0031">
        <items id="text">*Analysis performed time (en)</items>
        <items id="description">*The date and time when the analyte result was performed in the laboratory by a healthcare practitioner. (en)</items>
      </items>
      <items code="at0032">
        <items id="text">*Accredited (en)</items>
        <items id="description">*Indicates whether the analytical method used for this analyte is accredited. (en)</items>
      </items>
      <items code="">
        <items id="text">Analytnamn</items>
        <items id="description">Låst till TMB / Tumörmutationsbörda.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.genomic_variant_result-cancer.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Genomic variant result</items>
        <items id="description">Findings and annotations related to one variant found in a human individual by a sequencing test.</items>
      </items>
      <items code="at0001">
        <items id="text">Bioinformatic analysis workflow</items>
        <items id="description">Structured details about the bioinformatic analysis workflow or the protocol that is used.</items>
      </items>
      <items code="at0002">
        <items id="text">Reference genome</items>
        <items id="description">Structured details about the specific version of the human sequence assembly used for annotation.</items>
      </items>
      <items code="at0008">
        <items id="text">Transcript</items>
        <items id="description">Structured details about the transcript which is potentially affected by the variant.</items>
      </items>
      <items code="at0009">
        <items id="text">Transcript reference sequence</items>
        <items id="description">Structured details about the transcribed reference sequence.</items>
      </items>
      <items code="at0010">
        <items id="text">DNA region name</items>
        <items id="description">The human readable name for the region of interest.</items>
      </items>
      <items code="at0011">
        <items id="text">DNA change</items>
        <items id="description">Description of the variation at the DNA level following the HGVS nomenclature.</items>
      </items>
      <items code="at0012">
        <items id="text">Amino acid change</items>
        <items id="description">Description of the variation at the protein level following the HGVS nomenclature.</items>
      </items>
      <items code="at0013">
        <items id="text">Amino acid change type</items>
        <items id="description">Codified type for associated amino acid marker.</items>
      </items>
      <items code="at0015">
        <items id="text">Predicted impact</items>
        <items id="description">Estimate of the effects that the variant may have on the transcript.</items>
      </items>
      <items code="at0016">
        <items id="text">Predicted impact knowledge base</items>
        <items id="description">Structured details about the reference used to calculate the predicted impact.</items>
      </items>
      <items code="at0017">
        <items id="text">Score</items>
        <items id="description">The calculated value.</items>
      </items>
      <items code="at0018">
        <items id="text">Qualitative prediction</items>
        <items id="description">Human readable version of the predicted impact.</items>
      </items>
      <items code="at0019">
        <items id="text">Gene</items>
        <items id="description">Structured details about the gene carrying the variant.</items>
      </items>
      <items code="at0020">
        <items id="text">Gene symbol</items>
        <items id="description">The official gene symbol approved by the HGNC, which is a short abbreviated form of the gene name.</items>
      </items>
      <items code="at0021">
        <items id="text">Gene name</items>
        <items id="description">The full gene name approved by the HGNC that conveys the character or function of the gene.</items>
      </items>
      <items code="at0023">
        <items id="text">Best transcript candidate</items>
        <items id="description">The ID of the transcript with the highest predicted impact.</items>
      </items>
      <items code="at0024">
        <items id="text">Conservation</items>
        <items id="description">Structured details about the evolutionary conservation.</items>
      </items>
      <items code="at0025">
        <items id="text">Conservation score knowledge base</items>
        <items id="description">Structured details about the reference used to calculate the conservation score.</items>
      </items>
      <items code="at0026">
        <items id="text">Score</items>
        <items id="description">The conservation score.</items>
      </items>
      <items code="at0028">
        <items id="text">Allele depth</items>
        <items id="description">The number of reads that support the reported variant.</items>
      </items>
      <items code="at0029">
        <items id="text">Population allele frequency details</items>
        <items id="description">The relative frequency of a particular allele in the population.</items>
      </items>
      <items code="at0030">
        <items id="text">Population allele frequency knowledge base</items>
        <items id="description">Structured details about the database used to calculate the allele frequency.</items>
      </items>
      <items code="at0031">
        <items id="text">Population allele frequency</items>
        <items id="description">The population allele frequency.</items>
      </items>
      <items code="at0039">
        <items id="text">Genotype</items>
        <items id="description">Genotype encoded as allele values.</items>
      </items>
      <items code="at0040">
        <items id="text">Allelic state</items>
        <items id="description">The level of occurrence of a single DNA marker within a set of chromosomes.</items>
      </items>
      <items code="at0041">
        <items id="text">Genotype quality</items>
        <items id="description">Conditional genotype quality, encoded as a Phred quality.</items>
      </items>
      <items code="at0045">
        <items id="text">Structured variant</items>
        <items id="description">Structured description of the genomic variant.</items>
      </items>
      <items code="at0047">
        <items id="text">Allele frequency</items>
        <items id="description">The relative frequency of an allele at a particular locus.</items>
      </items>
      <items code="at0052">
        <items id="text">Functional impact</items>
        <items id="description">Interpretation of the variation linked to a specific paper.</items>
      </items>
      <items code="at0053">
        <items id="text">Source</items>
        <items id="description">The reference to the specific research paper.</items>
      </items>
      <items code="at0054">
        <items id="text">Impact</items>
        <items id="description">Single word or phrase describing the reported impact of the specific variant.</items>
      </items>
      <items code="at0056">
        <items id="text">Copy number overlap</items>
        <items id="description">The fraction of gene region covered by copy number.</items>
      </items>
      <items code="at0057">
        <items id="text">Part of fusion</items>
        <items id="description">States if the gene is part of a fusion gene and if it is the first or second part of the fusion gene.</items>
      </items>
      <items code="at0058">
        <items id="text">ACMG classification</items>
        <items id="description">The clinical significance according to the ACMG recommendations.</items>
      </items>
      <items code="at0059">
        <items id="text">Fusion exon</items>
        <items id="description">The number of the exon which is part of the fusion.</items>
      </items>
      <items code="at0060">
        <items id="text">Read depth</items>
        <items id="description">The total number of reads mapped at this specific location.</items>
      </items>
      <items code="at0061">
        <items id="text">VCF quality filter</items>
        <items id="description">Structured details about the quality filters that have been applied to the data.</items>
      </items>
      <items code="at0062">
        <items id="text">Filter name</items>
        <items id="description">Name of the quality filter.</items>
      </items>
      <items code="at0063">
        <items id="text">Description</items>
        <items id="description">Quality filter extended description.</items>
      </items>
      <items code="at0064">
        <items id="text">Filter passed</items>
        <items id="description">Did the variant pass the quality filter?</items>
      </items>
      <items code="at0067">
        <items id="text">Strand bias ratio</items>
        <items id="description">The ratio of the strand bias.</items>
      </items>
      <items code="at0068">
        <items id="text">Strand bias p-value</items>
        <items id="description">The Phred-scaled p-value of the strand bias.</items>
      </items>
      <items code="at0069">
        <items id="text">Genotype probability</items>
        <items id="description">A comma separated list of the log10-scaled genotype likelihoods for all possible genotypes, given the reference and the alternate alleles.</items>
      </items>
      <items code="at0070">
        <items id="text">Specimen identifier</items>
        <items id="description">Identification of the specimen used for the genomic result.</items>
      </items>
      <items code="at0071">
        <items id="text">Pathogenic</items>
        <items id="description">Pathogenic variant.</items>
      </items>
      <items code="at0072">
        <items id="text">Likely pathogenic</items>
        <items id="description">Likely pathogenic variant.</items>
      </items>
      <items code="at0073">
        <items id="text">Uncertain significance</items>
        <items id="description">Variant of uncertain significance.</items>
      </items>
      <items code="at0074">
        <items id="text">Likely benign</items>
        <items id="description">Likely benign variant.</items>
      </items>
      <items code="at0075">
        <items id="text">Benign</items>
        <items id="description">Benign variant.</items>
      </items>
      <items code="at0076">
        <items id="text">Heteroplasmic</items>
        <items id="description">Heteroplasmic.</items>
      </items>
      <items code="at0077">
        <items id="text">Homoplasmic</items>
        <items id="description">Homoplasmic.</items>
      </items>
      <items code="at0078">
        <items id="text">Homozygous</items>
        <items id="description">Homozygous.</items>
      </items>
      <items code="at0079">
        <items id="text">Heterozygous</items>
        <items id="description">Heterozygous.</items>
      </items>
      <items code="at0080">
        <items id="text">Hemizygous</items>
        <items id="description">Hemizygous.</items>
      </items>
      <items code="at0085">
        <items id="text">Wild type</items>
        <items id="description">The sequence at a given position is identical to the reference sequence.</items>
      </items>
      <items code="at0086">
        <items id="text">Deletion</items>
        <items id="description">A deletion in the amino acid sequence.</items>
      </items>
      <items code="at0087">
        <items id="text">Duplication</items>
        <items id="description">A duplication in the amino acid sequence.</items>
      </items>
      <items code="at0088">
        <items id="text">Frameshift</items>
        <items id="description">A frameshift in the amino acid sequence.</items>
      </items>
      <items code="at0089">
        <items id="text">Initiating methionine</items>
        <items id="description">A variant in a sequence affecting the translation initiation codon.</items>
      </items>
      <items code="at0090">
        <items id="text">Insertion</items>
        <items id="description">An insertion in the amino acid sequence.</items>
      </items>
      <items code="at0091">
        <items id="text">Insertion and deletion</items>
        <items id="description">An insertion/deletion in the amino acid sequence.</items>
      </items>
      <items code="at0092">
        <items id="text">Missense</items>
        <items id="description">One amino acid is replaced by another amino acid.</items>
      </items>
      <items code="at0093">
        <items id="text">Nonsense</items>
        <items id="description">An amino acid is replaced by a translational stop codon (termination codon).</items>
      </items>
      <items code="at0094">
        <items id="text">Silent</items>
        <items id="description">A variant in a DNA sequence that does not change the amino acid sequence of the encoded protein.</items>
      </items>
      <items code="at0095">
        <items id="text">Stop codon mutation</items>
        <items id="description">A variant in a sequence affecting the translational stop codon.</items>
      </items>
      <items code="at0096">
        <items id="text">First</items>
        <items id="description">First part of a fusion gene.</items>
      </items>
      <items code="at0097">
        <items id="text">Second</items>
        <items id="description">Second part of a fusion gene.</items>
      </items>
      <items code="at0098">
        <items id="text">Additional details</items>
        <items id="description">Additional details to be captured.</items>
      </items>
      <items code="at0099">
        <items id="text">Distance from splicing site</items>
        <items id="description">Distance in nucleotides between mutation and exon–intron junction.</items>
      </items>
      <items code="at0100">
        <items id="text">RNA change</items>
        <items id="description">Description of the variation at the RNA level following the HGVS nomenclature.</items>
      </items>
      <items code="at0101">
        <items id="text">Variant</items>
        <items id="description">Description of the variation at the genomic level following the HGVS nomenclature.</items>
      </items>
      <items code="at0102">
        <items id="text">Variant identification</items>
        <items id="description">A reference to a specific variation recorded into an external biological variation database.</items>
      </items>
      <items code="at9000">
        <items id="text">Qualified real</items>
        <items id="description">Qualified real</items>
      </items>
      <items code="at0000.1">
        <items id="text">Genomic variant result (cancer)</items>
        <items id="description">Cancer genomic finding with ASCO/AMP, ESCAT, origin, and clinical implications.</items>
      </items>
      <items code="at0.9000">
        <items id="text">Genetic origin</items>
        <items id="description">Whether the variant is somatic, germline, likely somatic, likely germline, or unknown. Aligns with FHIR Genomics Observation.component:genomic-allele-origin.</items>
      </items>
      <items code="at0.9001">
        <items id="text">ASCO/AMP clinical significance tier</items>
        <items id="description">Somatic clinical significance according to ASCO/AMP/CAP tiering (Tier I–IV). Complements parent ACMG classification which targets germline pathogenicity.</items>
      </items>
      <items code="at0.9002">
        <items id="text">ESCAT therapeutic relevance</items>
        <items id="description">ESMO Scale for Clinical Actionability of molecular Targets (ESCAT) tier for therapeutic decision support.</items>
      </items>
      <items code="at0.9003">
        <items id="text">Exon number</items>
        <items id="description">Exon number affected by the variant (general; parent Fusion exon remains for fusion-specific context).</items>
      </items>
      <items code="at0.9004">
        <items id="text">Karyotype (ISCN)</items>
        <items id="description">ISCN karyotype string describing chromosomal rearrangement or CNV notation.</items>
      </items>
      <items code="at0.6">
        <items id="text">Molecular consequence</items>
        <items id="description">Predicted molecular consequence using Sequence Ontology (e.g. missense_variant, stop_gained). Aligns with FHIR Genomics Observation.component:molecular-consequence.</items>
      </items>
      <items code="at0.7">
        <items id="text">Clinical implication</items>
        <items id="description">Diagnostic and/or therapeutic implication for this variant.</items>
      </items>
      <items code="at0.1">
        <items id="text">Somatic</items>
        <items id="description">Variant acquired in somatic (non-germline) tissue.</items>
      </items>
      <items code="at0.2">
        <items id="text">Germline</items>
        <items id="description">Variant present in germline.</items>
      </items>
      <items code="at0.3">
        <items id="text">Likely somatic</items>
        <items id="description">Variant assessed as likely somatic.</items>
      </items>
      <items code="at0.4">
        <items id="text">Likely germline</items>
        <items id="description">Variant assessed as likely germline.</items>
      </items>
      <items code="at0.5">
        <items id="text">Unknown origin</items>
        <items id="description">Genetic origin not determined.</items>
      </items>
      <items code="at0.10">
        <items id="text">Tier I-A</items>
        <items id="description">Strong clinical significance: FDA-approved therapy / guideline recommendation.</items>
      </items>
      <items code="at0.11">
        <items id="text">Tier I-B</items>
        <items id="description">Strong clinical significance: professional society recommendation.</items>
      </items>
      <items code="at0.12">
        <items id="text">Tier I-C</items>
        <items id="description">Strong clinical significance: expert consensus or well-powered study.</items>
      </items>
      <items code="at0.13">
        <items id="text">Tier I-D</items>
        <items id="description">Strong clinical significance: preclinical evidence.</items>
      </items>
      <items code="at0.14">
        <items id="text">Tier II</items>
        <items id="description">Potential clinical significance: investigational or other tumour type.</items>
      </items>
      <items code="at0.15">
        <items id="text">Tier III</items>
        <items id="description">Unknown clinical significance (somatic VUS equivalent).</items>
      </items>
      <items code="at0.16">
        <items id="text">Tier IV</items>
        <items id="description">Benign or likely benign / passenger mutation.</items>
      </items>
      <items code="at0.20">
        <items id="text">ESCAT Tier I-A</items>
        <items id="description">Ready for routine use — RCT evidence.</items>
      </items>
      <items code="at0.21">
        <items id="text">ESCAT Tier I-B</items>
        <items id="description">Ready for routine use — single-arm trial.</items>
      </items>
      <items code="at0.22">
        <items id="text">ESCAT Tier I-C</items>
        <items id="description">Ready for routine use — basket trial.</items>
      </items>
      <items code="at0.23">
        <items id="text">ESCAT Tier II-A</items>
        <items id="description">Investigational — retrospective evidence.</items>
      </items>
      <items code="at0.24">
        <items id="text">ESCAT Tier II-B</items>
        <items id="description">Investigational — response without survival data.</items>
      </items>
      <items code="at0.25">
        <items id="text">ESCAT Tier III-A</items>
        <items id="description">Hypothetical — evidence from other tumour type.</items>
      </items>
      <items code="at0.26">
        <items id="text">ESCAT Tier III-B</items>
        <items id="description">Hypothetical — similar molecular alteration.</items>
      </items>
      <items code="at0.27">
        <items id="text">ESCAT Tier IV-A</items>
        <items id="description">Preclinical — in vitro/vivo evidence.</items>
      </items>
      <items code="at0.28">
        <items id="text">ESCAT Tier IV-B</items>
        <items id="description">Preclinical — in silico prediction.</items>
      </items>
      <items code="at0.29">
        <items id="text">ESCAT Tier V</items>
        <items id="description">Combination — response without clinical benefit.</items>
      </items>
      <items code="at0.30">
        <items id="text">ESCAT Tier X</items>
        <items id="description">No evidence for actionability.</items>
      </items>
      <items code="at0.40">
        <items id="text">missense_variant</items>
        <items id="description">A sequence variant that changes one or more bases, resulting in a different amino acid sequence but where the length is preserved. (SO:0001583)</items>
      </items>
      <items code="at0.41">
        <items id="text">stop_gained</items>
        <items id="description">A sequence variant whereby at least one base of a codon is changed, resulting in a premature stop codon, leading to a shortened transcript. (SO:0001587)</items>
      </items>
      <items code="at0.42">
        <items id="text">frameshift_variant</items>
        <items id="description">A sequence variant which causes a disruption of the translational reading frame, because the number of nucleotides inserted or deleted is not a multiple of three. (SO:0001589)</items>
      </items>
      <items code="at0.43">
        <items id="text">synonymous_variant</items>
        <items id="description">A sequence variant where there is no resulting change to the encoded amino acid. (SO:0001819)</items>
      </items>
      <items code="at0.44">
        <items id="text">start_lost</items>
        <items id="description">A codon variant that changes at least one base of the canonical start codon. (SO:0002012)</items>
      </items>
      <items code="at0.45">
        <items id="text">stop_lost</items>
        <items id="description">A sequence variant where at least one base of the terminator codon (stop) is changed, resulting in an elongated transcript. (SO:0001578)</items>
      </items>
      <items code="at0.46">
        <items id="text">inframe_insertion</items>
        <items id="description">An inframe non synonymous variant that inserts bases into in the coding sequence. (SO:0001821)</items>
      </items>
      <items code="at0.47">
        <items id="text">inframe_deletion</items>
        <items id="description">An inframe non synonymous variant that deletes bases from the coding sequence. (SO:0001822)</items>
      </items>
      <items code="at0045.0">
        <items id="text">Deletion-insertion variant</items>
        <items id="description">Indel structured detail.</items>
      </items>
      <items code="at0098.0">
        <items id="text">Translocation / fusion structure</items>
        <items id="description">Structural detail for rearrangements (draft; REVIEWSUSPENDED on CKM).</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Genomiskt variantresultat</items>
        <items id="description">Fynd och annoteringar för en variant som påvisats hos en individ genom ett sekvenseringstest.</items>
      </items>
      <items code="at0001">
        <items id="text">Bioinformatiskt analysflöde</items>
        <items id="description">Strukturerade detaljer om det bioinformatiska analysflödet eller protokollet som används.</items>
      </items>
      <items code="at0002">
        <items id="text">Referensgenom</items>
        <items id="description">Strukturerade detaljer om den specifika versionen av den humana sekvensassemblyn som används för annotering.</items>
      </items>
      <items code="at0008">
        <items id="text">Transkript</items>
        <items id="description">Strukturerade detaljer om transkriptet som potentiellt påverkas av varianten.</items>
      </items>
      <items code="at0009">
        <items id="text">Transkriptets referenssekvens</items>
        <items id="description">Strukturerade detaljer om den transkriberade referenssekvensen.</items>
      </items>
      <items code="at0010">
        <items id="text">DNA-regionens namn</items>
        <items id="description">Läsbart namn på den aktuella regionen.</items>
      </items>
      <items code="at0011">
        <items id="text">DNA-förändring</items>
        <items id="description">Beskrivning av variationen på DNA-nivå enligt HGVS-nomenklaturen.</items>
      </items>
      <items code="at0012">
        <items id="text">Aminosyraförändring</items>
        <items id="description">Beskrivning av variationen på proteinnivå enligt HGVS-nomenklaturen.</items>
      </items>
      <items code="at0013">
        <items id="text">Typ av aminosyraförändring</items>
        <items id="description">Kodad typ för den tillhörande aminosyramarkören.</items>
      </items>
      <items code="at0015">
        <items id="text">Predicerad påverkan</items>
        <items id="description">Uppskattning av vilka effekter varianten kan ha på transkriptet.</items>
      </items>
      <items code="at0016">
        <items id="text">Kunskapskälla för predicerad påverkan</items>
        <items id="description">Strukturerade detaljer om referensen som används för att beräkna predicerad påverkan.</items>
      </items>
      <items code="at0017">
        <items id="text">Poäng</items>
        <items id="description">Det beräknade värdet.</items>
      </items>
      <items code="at0018">
        <items id="text">Kvalitativ prediktion</items>
        <items id="description">Läsbar version av den predicerade påverkan.</items>
      </items>
      <items code="at0019">
        <items id="text">Gen</items>
        <items id="description">Strukturerade detaljer om genen som bär varianten.</items>
      </items>
      <items code="at0020">
        <items id="text">Gensymbol</items>
        <items id="description">Den officiella gensymbolen godkänd av HGNC, en kort förkortning av gennamnet.</items>
      </items>
      <items code="at0021">
        <items id="text">Gennamn</items>
        <items id="description">Det fullständiga gennamnet godkänt av HGNC som beskriver genens karaktär eller funktion.</items>
      </items>
      <items code="at0023">
        <items id="text">Bästa transkriptkandidat</items>
        <items id="description">ID för transkriptet med högst predicerad påverkan.</items>
      </items>
      <items code="at0024">
        <items id="text">Konservering</items>
        <items id="description">Strukturerade detaljer om evolutionär konservering.</items>
      </items>
      <items code="at0025">
        <items id="text">Kunskapskälla för konserveringspoäng</items>
        <items id="description">Strukturerade detaljer om referensen som används för att beräkna konserveringspoängen.</items>
      </items>
      <items code="at0026">
        <items id="text">Poäng</items>
        <items id="description">Konserveringspoängen.</items>
      </items>
      <items code="at0028">
        <items id="text">Alleldjup</items>
        <items id="description">Antal läsningar som stöder den rapporterade varianten.</items>
      </items>
      <items code="at0029">
        <items id="text">Detaljer om allelfrekvens i population</items>
        <items id="description">Den relativa frekvensen av en viss allel i populationen.</items>
      </items>
      <items code="at0030">
        <items id="text">Kunskapskälla för allelfrekvens i population</items>
        <items id="description">Strukturerade detaljer om databasen som används för att beräkna allelfrekvensen.</items>
      </items>
      <items code="at0031">
        <items id="text">Allelfrekvens i population</items>
        <items id="description">Allelfrekvensen i populationen.</items>
      </items>
      <items code="at0039">
        <items id="text">Genotyp</items>
        <items id="description">Genotyp kodad som allelvärden.</items>
      </items>
      <items code="at0040">
        <items id="text">Allelstatus</items>
        <items id="description">Förekomstnivån för en enskild DNA-markör inom en uppsättning kromosomer.</items>
      </items>
      <items code="at0041">
        <items id="text">Genotypkvalitet</items>
        <items id="description">Betingad genotypkvalitet, kodad som Phred-kvalitet.</items>
      </items>
      <items code="at0045">
        <items id="text">Strukturerad variant</items>
        <items id="description">Strukturerad beskrivning av den genomiska varianten.</items>
      </items>
      <items code="at0047">
        <items id="text">Allelfrekvens</items>
        <items id="description">Den relativa frekvensen av en allel i ett visst locus.</items>
      </items>
      <items code="at0052">
        <items id="text">Funktionell påverkan</items>
        <items id="description">Tolkning av variationen kopplad till en specifik artikel.</items>
      </items>
      <items code="at0053">
        <items id="text">Källa</items>
        <items id="description">Referens till den specifika forskningsartikeln.</items>
      </items>
      <items code="at0054">
        <items id="text">Påverkan</items>
        <items id="description">Ord eller fras som beskriver den rapporterade påverkan av den specifika varianten.</items>
      </items>
      <items code="at0056">
        <items id="text">Kopietalsöverlapp</items>
        <items id="description">Andelen av genregionen som täcks av kopietalet.</items>
      </items>
      <items code="at0057">
        <items id="text">Del av fusion</items>
        <items id="description">Anger om genen ingår i en fusionsgen och om den är första eller andra delen av fusionsgenen.</items>
      </items>
      <items code="at0058">
        <items id="text">ACMG-klassificering</items>
        <items id="description">Klinisk signifikans enligt ACMG:s rekommendationer.</items>
      </items>
      <items code="at0059">
        <items id="text">Fusionsexon</items>
        <items id="description">Numret på exonet som ingår i fusionen.</items>
      </items>
      <items code="at0060">
        <items id="text">Läsdjup</items>
        <items id="description">Totalt antal läsningar mappade på denna specifika position.</items>
      </items>
      <items code="at0061">
        <items id="text">VCF-kvalitetsfilter</items>
        <items id="description">Strukturerade detaljer om kvalitetsfilter som tillämpats på data.</items>
      </items>
      <items code="at0062">
        <items id="text">Filternamn</items>
        <items id="description">Kvalitetsfiltrets namn.</items>
      </items>
      <items code="at0063">
        <items id="text">Beskrivning</items>
        <items id="description">Utökad beskrivning av kvalitetsfiltret.</items>
      </items>
      <items code="at0064">
        <items id="text">Filter godkänt</items>
        <items id="description">Passerade varianten kvalitetsfiltret?</items>
      </items>
      <items code="at0067">
        <items id="text">Strängbiaskvot</items>
        <items id="description">Kvoten för strängbias.</items>
      </items>
      <items code="at0068">
        <items id="text">p-värde för strängbias</items>
        <items id="description">Phred-skalat p-värde för strängbias.</items>
      </items>
      <items code="at0069">
        <items id="text">Genotypsannolikhet</items>
        <items id="description">Kommaseparerad lista med log10-skalade genotypsannolikheter för alla möjliga genotyper, givet referens- och alternativa alleler.</items>
      </items>
      <items code="at0070">
        <items id="text">Providentifierare</items>
        <items id="description">Identifiering av provet som använts för det genomiska resultatet.</items>
      </items>
      <items code="at0071">
        <items id="text">Patogen</items>
        <items id="description">Patogen variant.</items>
      </items>
      <items code="at0072">
        <items id="text">Sannolikt patogen</items>
        <items id="description">Sannolikt patogen variant.</items>
      </items>
      <items code="at0073">
        <items id="text">Oklar signifikans</items>
        <items id="description">Variant av oklar signifikans.</items>
      </items>
      <items code="at0074">
        <items id="text">Sannolikt benign</items>
        <items id="description">Sannolikt benign variant.</items>
      </items>
      <items code="at0075">
        <items id="text">Benign</items>
        <items id="description">Benign variant.</items>
      </items>
      <items code="at0076">
        <items id="text">Heteroplasmisk</items>
        <items id="description">Heteroplasmisk.</items>
      </items>
      <items code="at0077">
        <items id="text">Homoplasmisk</items>
        <items id="description">Homoplasmisk.</items>
      </items>
      <items code="at0078">
        <items id="text">Homozygot</items>
        <items id="description">Homozygot.</items>
      </items>
      <items code="at0079">
        <items id="text">Heterozygot</items>
        <items id="description">Heterozygot.</items>
      </items>
      <items code="at0080">
        <items id="text">Hemizygot</items>
        <items id="description">Hemizygot.</items>
      </items>
      <items code="at0085">
        <items id="text">Vildtyp</items>
        <items id="description">Sekvensen på en given position är identisk med referenssekvensen.</items>
      </items>
      <items code="at0086">
        <items id="text">Deletion</items>
        <items id="description">En deletion i aminosyrasekvensen.</items>
      </items>
      <items code="at0087">
        <items id="text">Duplikation</items>
        <items id="description">En duplikation i aminosyrasekvensen.</items>
      </items>
      <items code="at0088">
        <items id="text">Läsramsförskjutning</items>
        <items id="description">En läsramsförskjutning i aminosyrasekvensen.</items>
      </items>
      <items code="at0089">
        <items id="text">Initierande metionin</items>
        <items id="description">En variant som påverkar translationens startkodon.</items>
      </items>
      <items code="at0090">
        <items id="text">Insertion</items>
        <items id="description">En insertion i aminosyrasekvensen.</items>
      </items>
      <items code="at0091">
        <items id="text">Insertion och deletion</items>
        <items id="description">En insertion/deletion i aminosyrasekvensen.</items>
      </items>
      <items code="at0092">
        <items id="text">Missense</items>
        <items id="description">En aminosyra ersätts av en annan aminosyra.</items>
      </items>
      <items code="at0093">
        <items id="text">Nonsens</items>
        <items id="description">En aminosyra ersätts av ett translationellt stoppkodon (terminationskodon).</items>
      </items>
      <items code="at0094">
        <items id="text">Tyst</items>
        <items id="description">En variant i DNA-sekvensen som inte ändrar aminosyrasekvensen i det kodade proteinet.</items>
      </items>
      <items code="at0095">
        <items id="text">Stoppkodonmutation</items>
        <items id="description">En variant som påverkar translationens stoppkodon.</items>
      </items>
      <items code="at0096">
        <items id="text">Första</items>
        <items id="description">Första delen av en fusionsgen.</items>
      </items>
      <items code="at0097">
        <items id="text">Andra</items>
        <items id="description">Andra delen av en fusionsgen.</items>
      </items>
      <items code="at0098">
        <items id="text">Ytterligare detaljer</items>
        <items id="description">Ytterligare detaljer som ska registreras.</items>
      </items>
      <items code="at0099">
        <items id="text">Avstånd från splitsningsställe</items>
        <items id="description">Avstånd i nukleotider mellan mutationen och exon–intron-gränsen.</items>
      </items>
      <items code="at0100">
        <items id="text">RNA-förändring</items>
        <items id="description">Beskrivning av variationen på RNA-nivå enligt HGVS-nomenklaturen.</items>
      </items>
      <items code="at0101">
        <items id="text">Variant</items>
        <items id="description">Beskrivning av variationen på genomisk nivå enligt HGVS-nomenklaturen.</items>
      </items>
      <items code="at0102">
        <items id="text">Variantidentifiering</items>
        <items id="description">Referens till en specifik variation registrerad i en extern biologisk variationsdatabas.</items>
      </items>
      <items code="at9000">
        <items id="text">Kvalificerat reellt tal</items>
        <items id="description">Kvalificerat reellt tal</items>
      </items>
      <items code="at0000.1">
        <items id="text">Genetiskt variantresultat (cancer)</items>
        <items id="description">Cancergenomiskt fynd med ASCO/AMP, ESCAT, ursprung och kliniska implikationer.</items>
      </items>
      <items code="at0.9000">
        <items id="text">Genetiskt ursprung</items>
        <items id="description">Om varianten är somatisk, germline, troligen somatisk, troligen germline eller okänd.</items>
      </items>
      <items code="at0.9001">
        <items id="text">ASCO/AMP klinisk signifikans-tier</items>
        <items id="description">Somatisk klinisk signifikans enligt ASCO/AMP/CAP (Tier I–IV). Komplement till förälderns ACMG-klassificering.</items>
      </items>
      <items code="at0.9002">
        <items id="text">ESCAT behandlingsrelevans</items>
        <items id="description">ESMO ESCAT-nivå för terapeutiskt beslutsstöd.</items>
      </items>
      <items code="at0.9003">
        <items id="text">Exonnummer</items>
        <items id="description">Exonnummer som påverkas av varianten.</items>
      </items>
      <items code="at0.9004">
        <items id="text">Karyotyp (ISCN)</items>
        <items id="description">ISCN-karyotypsträng för kromosomavvikelse eller CNV-notation.</items>
      </items>
      <items code="at0.6">
        <items id="text">Molekylär konsekvens</items>
        <items id="description">Förutsagd molekylär konsekvens enligt Sequence Ontology.</items>
      </items>
      <items code="at0.7">
        <items id="text">Klinisk implikation</items>
        <items id="description">Diagnostisk och/eller terapeutisk implikation för varianten.</items>
      </items>
      <items code="at0.1">
        <items id="text">Somatisk</items>
        <items id="description">Variant förvärvad i somatisk vävnad.</items>
      </items>
      <items code="at0.2">
        <items id="text">Germline</items>
        <items id="description">Variant i germline.</items>
      </items>
      <items code="at0.3">
        <items id="text">Troligen somatisk</items>
        <items id="description">Variant bedömd som troligen somatisk.</items>
      </items>
      <items code="at0.4">
        <items id="text">Troligen germline</items>
        <items id="description">Variant bedömd som troligen germline.</items>
      </items>
      <items code="at0.5">
        <items id="text">Okänt ursprung</items>
        <items id="description">Genetiskt ursprung ej fastställt.</items>
      </items>
      <items code="at0.10">
        <items id="text">Tier I-A</items>
        <items id="description">Stark klinisk signifikans: FDA-godkänd behandling / riktlinjerek.</items>
      </items>
      <items code="at0.11">
        <items id="text">Tier I-B</items>
        <items id="description">Stark klinisk signifikans: professionell riktlinjerek.</items>
      </items>
      <items code="at0.12">
        <items id="text">Tier I-C</items>
        <items id="description">Stark klinisk signifikans: expertkonsensus / välpowrad studie.</items>
      </items>
      <items code="at0.13">
        <items id="text">Tier I-D</items>
        <items id="description">Stark klinisk signifikans: preklinisk evidens.</items>
      </items>
      <items code="at0.14">
        <items id="text">Tier II</items>
        <items id="description">Potentiell klinisk signifikans: investigationell eller annan tumörtyp.</items>
      </items>
      <items code="at0.15">
        <items id="text">Tier III</items>
        <items id="description">Okänd klinisk signifikans (somatisk VUS-ekvivalent).</items>
      </items>
      <items code="at0.16">
        <items id="text">Tier IV</items>
        <items id="description">Benign eller troligen benign / passager-mutation.</items>
      </items>
      <items code="at0.20">
        <items id="text">ESCAT Tier I-A</items>
        <items id="description">Redo för rutin — RCT-evidens.</items>
      </items>
      <items code="at0.21">
        <items id="text">ESCAT Tier I-B</items>
        <items id="description">Redo för rutin — single-arm-studie.</items>
      </items>
      <items code="at0.22">
        <items id="text">ESCAT Tier I-C</items>
        <items id="description">Redo för rutin — basket-studie.</items>
      </items>
      <items code="at0.23">
        <items id="text">ESCAT Tier II-A</items>
        <items id="description">Investigationell — retrospektiv evidens.</items>
      </items>
      <items code="at0.24">
        <items id="text">ESCAT Tier II-B</items>
        <items id="description">Investigationell — respons utan överlevnadsdata.</items>
      </items>
      <items code="at0.25">
        <items id="text">ESCAT Tier III-A</items>
        <items id="description">Hypotetisk — evidens från annan tumörtyp.</items>
      </items>
      <items code="at0.26">
        <items id="text">ESCAT Tier III-B</items>
        <items id="description">Hypotetisk — liknande molekylär förändring.</items>
      </items>
      <items code="at0.27">
        <items id="text">ESCAT Tier IV-A</items>
        <items id="description">Preklinisk — in vitro/vivo-evidens.</items>
      </items>
      <items code="at0.28">
        <items id="text">ESCAT Tier IV-B</items>
        <items id="description">Preklinisk — in silico-prediktion.</items>
      </items>
      <items code="at0.29">
        <items id="text">ESCAT Tier V</items>
        <items id="description">Kombination — respons utan klinisk nytta.</items>
      </items>
      <items code="at0.30">
        <items id="text">ESCAT Tier X</items>
        <items id="description">Ingen evidens för åtgärdbarhet.</items>
      </items>
      <items code="at0.40">
        <items id="text">Missense-variant</items>
        <items id="description">Sekvensvariant som ändrar en eller flera baser och ger en annan aminosyrasekvens med bibehållen längd. (SO:0001583)</items>
      </items>
      <items code="at0.41">
        <items id="text">Nonsensvariant (stop gained)</items>
        <items id="description">Sekvensvariant där minst en bas i ett kodon ändras så att ett förtida stoppkodon uppstår och transkriptet förkortas. (SO:0001587)</items>
      </items>
      <items code="at0.42">
        <items id="text">Läsramsförskjutningsvariant</items>
        <items id="description">Sekvensvariant som bryter den translationella läsramen eftersom antalet insererade eller deleterade nukleotider inte är en multipel av tre. (SO:0001589)</items>
      </items>
      <items code="at0.43">
        <items id="text">Synonym variant</items>
        <items id="description">Sekvensvariant som inte ändrar den kodade aminosyran. (SO:0001819)</items>
      </items>
      <items code="at0.44">
        <items id="text">Förlust av startkodon</items>
        <items id="description">Kodonvariant som ändrar minst en bas i det kanoniska startkodonet. (SO:0002012)</items>
      </items>
      <items code="at0.45">
        <items id="text">Förlust av stoppkodon</items>
        <items id="description">Sekvensvariant där minst en bas i stoppkodonet ändras så att transkriptet förlängs. (SO:0001578)</items>
      </items>
      <items code="at0.46">
        <items id="text">Insertion i läsram</items>
        <items id="description">Icke-synonym variant i läsram som infogar baser i den kodande sekvensen. (SO:0001821)</items>
      </items>
      <items code="at0.47">
        <items id="text">Deletion i läsram</items>
        <items id="description">Icke-synonym variant i läsram som tar bort baser från den kodande sekvensen. (SO:0001822)</items>
      </items>
      <items code="at0045.0">
        <items id="text">Deletions-insertionsvariant</items>
        <items id="description">Indel – strukturerad detalj.</items>
      </items>
      <items code="at0098.0">
        <items id="text">Translokation / fusionsstruktur</items>
        <items id="description">Strukturdetalj för rearrangemang (utkast).</items>
      </items>
    </term_definitions>
