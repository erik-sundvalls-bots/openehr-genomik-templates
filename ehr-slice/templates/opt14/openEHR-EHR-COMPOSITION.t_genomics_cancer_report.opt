  <component_ontologies archetype_id="openEHR-EHR-OBSERVATION.laboratory_test_result.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Genomic laboratory test result</items>
        <items id="description">Laboratory test result constrained for cancer genomics: specimens, assay, variants and biomarkers.</items>
      </items>
      <items code="at0002">
        <items id="text">Any event</items>
        <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
      </items>
      <items code="at0005">
        <items id="text">Test name</items>
        <items id="description">Name of the laboratory investigation performed on the specimen(s).</items>
      </items>
      <items code="at0017">
        <items id="text">Receiving laboratory</items>
        <items id="description">Laboratory organisation (HSA identifiers).</items>
      </items>
      <items code="at0035">
        <items id="text">Distribution list</items>
        <items id="description">Details of additional clinicians or organisations who require a copy of the test result.</items>
      </items>
      <items code="at0037">
        <items id="text">Partial</items>
        <items id="description">This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.</items>
      </items>
      <items code="at0038">
        <items id="text">Final</items>
        <items id="description">The Test result is complete and verified by an authorised person.</items>
      </items>
      <items code="at0040">
        <items id="text">Amended</items>
        <items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.</items>
      </items>
      <items code="at0057">
        <items id="text">Conclusion</items>
        <items id="description">Narrative description of the key findings.</items>
      </items>
      <items code="at0062">
        <items id="text">Requester order identifier</items>
        <items id="description">The local identifier assigned by the requesting clinical system.</items>
      </items>
      <items code="at0063">
        <items id="text">Receiver order identifier</items>
        <items id="description">The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).</items>
      </items>
      <items code="at0065">
        <items id="text">Specimen</items>
        <items id="description">Source and/or extracted specimen (parent–child via Parent specimen identifier).</items>
      </items>
      <items code="at0068">
        <items id="text">Laboratory internal identifier</items>
        <items id="description">A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.</items>
      </items>
      <items code="at0073">
        <items id="text">Overall test status</items>
        <items id="description">The status of the laboratory test result as a whole.</items>
      </items>
      <items code="at0074">
        <items id="text">Cancelled</items>
        <items id="description">The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').</items>
      </items>
      <items code="at0075">
        <items id="text">Overall test status timestamp</items>
        <items id="description">The date and/or time that ‘Overall test status’ was issued.</items>
      </items>
      <items code="at0077">
        <items id="text">Diagnostic service category</items>
        <items id="description">The diagnostic service or discipline that is responsible for the laboratory test result.</items>
      </items>
      <items code="at0090">
        <items id="text">Requester</items>
        <items id="description">Details of the clinician or organisation requesting the laboratory test result.</items>
      </items>
      <items code="at0094">
        <items id="text">Test request details</items>
        <items id="description">Details about the test request.</items>
      </items>
      <items code="at0097">
        <items id="text">Genomic variant result (cancer)</items>
        <items id="description">Cancer genomic finding with ASCO/AMP, ESCAT, origin, and clinical implications.</items>
      </items>
      <items code="at0098">
        <items id="text">Test diagnosis</items>
        <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.</items>
      </items>
      <items code="at0100">
        <items id="text">Clinical information provided</items>
        <items id="description">Description of clinical information available at the time of interpretation of results.</items>
      </items>
      <items code="at0101">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the test result not captured in other fields.</items>
      </items>
      <items code="at0106">
        <items id="text">Original test requested name</items>
        <items id="description">Name of the original laboratory test requested.</items>
      </items>
      <items code="at0107">
        <items id="text">Registered</items>
        <items id="description">The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.</items>
      </items>
      <items code="at0110">
        <items id="text">Sequencing / panel device</items>
        <items id="description">Device or panel product when not nested under sequencing_assay.</items>
      </items>
      <items code="at0111">
        <items id="text">Point-of-care test</items>
        <items id="description">This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.</items>
      </items>
      <items code="at0113">
        <items id="text">Confounding factors</items>
        <items id="description">Issues or circumstances that impact on the accurate interpretation of the measurement or test result.</items>
      </items>
      <items code="at0114">
        <items id="text">Structured confounding factors</items>
        <items id="description">Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.</items>
      </items>
      <items code="at0115">
        <items id="text">Corrected</items>
        <items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.</items>
      </items>
      <items code="at0116">
        <items id="text">Entered in error</items>
        <items id="description">The Test Result has been withdrawn following previous Final release.</items>
      </items>
      <items code="at0117">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
      </items>
      <items code="at0118">
        <items id="text">Multimedia representation</items>
        <items id="description">Digital image, video or diagram representing the test result.</items>
      </items>
      <items code="at0119">
        <items id="text">Appended</items>
        <items id="description">Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.</items>
      </items>
      <items code="at0120">
        <items id="text">Preliminary</items>
        <items id="description">Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.</items>
      </items>
      <items code="at0121">
        <items id="text">Test method</items>
        <items id="description">Description about the method used to perform the test.</items>
      </items>
      <items code="at0122">
        <items id="text">Structured test diagnosis</items>
        <items id="description">A structured or complex diagnosis for the laboratory test.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Genomiskt laboratorieresultat</items>
        <items id="description">Laboratorieresultat begränsat för cancergenomik: prover, assay, varianter och biomarkörer.</items>
      </items>
      <items code="at0002">
        <items id="text">Ospecificerad händelse</items>
        <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
      </items>
      <items code="at0005">
        <items id="text">Undersökningsnamn</items>
        <items id="description">Namnet på den laboratorieundersökning eller -analys som utförts på provmaterialet.</items>
      </items>
      <items code="at0017">
        <items id="text">Mottagande laboratorium</items>
        <items id="description">Laboratorieorganisation (HSA-identiteter).</items>
      </items>
      <items code="at0035">
        <items id="text">Distributionslista</items>
        <items id="description">Detaljer om ytterligare kliniker eller organisationer som behöver en kopia av undersökningsresultatet.</items>
      </items>
      <items code="at0037">
        <items id="text">Partiell</items>
        <items id="description">Detta är ett partiellt undersökningsresultat, dvs. initialt, interim eller preliminärt. Resultatdata kan vara ofullständiga eller obekräftade.</items>
      </items>
      <items code="at0038">
        <items id="text">Slutgiltig</items>
        <items id="description">Undersökningsresultatet är fullständigt och verifierat av ansvarig person alternativt autoverifierat maskinellt.</items>
      </items>
      <items code="at0040">
        <items id="text">Reviderad</items>
        <items id="description">Det slutgiltiga undersökningsresultatet har reviderats. Denna status har underkategorierna "Rättad" och "Utökad".</items>
      </items>
      <items code="at0057">
        <items id="text">Tolkning av resultat</items>
        <items id="description">Berättande textuell beskrivning av de viktigaste resultaten.</items>
      </items>
      <items code="at0062">
        <items id="text">Beställarens beställningsidentifierare</items>
        <items id="description">Den lokala identifierare som tilldelats av det begärande kliniska systemet.</items>
      </items>
      <items code="at0063">
        <items id="text">Mottagarens beställningsidenitifierare</items>
        <items id="description">Den lokala identifierare som tilldelats beställningen av ordermottagningssystemet, vanligtvis av laboratorieinformationssystemet (LIS).</items>
      </items>
      <items code="at0065">
        <items id="text">Prov</items>
        <items id="description">Ursprungs- och/eller extraherat prov (förälder–barn via föräldraprovidentitet).</items>
      </items>
      <items code="at0068">
        <items id="text">Laboratoriets interna identifierare</items>
        <items id="description">En lokal identifierare som tilldelats av det mottagande laboratorieinformationssystemet (LIS) för att spåra analysprocessen.</items>
      </items>
      <items code="at0073">
        <items id="text">Status undersökningsresultat</items>
        <items id="description">Status för undersökningsresultaten som helhet.</items>
      </items>
      <items code="at0074">
        <items id="text">Avbruten</items>
        <items id="description">Resultatet är inte tillgängligt eftersom undersökningen inte har startats eller inte slutförts.</items>
      </items>
      <items code="at0075">
        <items id="text">Tidpunkt för status undersökningsresultat</items>
        <items id="description">Datum och tid för utfärdandet av övergripande resultatstatus.</items>
      </items>
      <items code="at0077">
        <items id="text">Laboratoriedisciplin</items>
        <items id="description">Den diagnostiska organisationsenhet, laboratoriedisciplin eller underdisciplin som ansvarar för laboratorieresultatet.
  </items>
      </items>
      <items code="at0090">
        <items id="text">Beställare</items>
        <items id="description">Uppgifter om den kliniker eller organisation som beställt undersökningen.</items>
      </items>
      <items code="at0094">
        <items id="text">Beställningsdetaljer</items>
        <items id="description">Detaljer om beställningen.</items>
      </items>
      <items code="at0097">
        <items id="text">Genetiskt variantresultat (cancer)</items>
        <items id="description">Cancergenomiskt fynd med ASCO/AMP, ESCAT, ursprung och kliniska implikationer.</items>
      </items>
      <items code="at0098">
        <items id="text">Undersökningsdiagnos</items>
        <items id="description">Ett ord, en fras eller en kort beskrivning som representerar den kliniska betydelsen eller konsekvensen av laboratorietestresultatet.
  </items>
      </items>
      <items code="at0100">
        <items id="text">Tillgänglig klinisk information</items>
        <items id="description">Beskrivning av den kliniska information som finns tillgänglig vid tolkningen av resultaten.</items>
      </items>
      <items code="at0101">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligare textuell beskrivning som inte registrerats i andra fält.</items>
      </items>
      <items code="at0106">
        <items id="text">Ursprungligt undersökningsnamn</items>
        <items id="description">Namn på den ursprungligen beställda undersökningen eller analysen.</items>
      </items>
      <items code="at0107">
        <items id="text">Registrerad</items>
        <items id="description">Undersökningen är registrerad i laboratorieinformationssystemet, men resultatet finns för närvarande inte.
  
  </items>
      </items>
      <items code="at0110">
        <items id="text">Sekvenserings-/panelenhet</items>
        <items id="description">Enhet eller panelprodukt när den inte nästlas under sequencing_assay.</items>
      </items>
      <items code="at0111">
        <items id="text">Patientnära analys</items>
        <items id="description">Indikerar om analysen utfördes som en patientnära analys (PNA), det vill säga på vårdenhet, istället för en mer formell laboratorietjänst.</items>
      </items>
      <items code="at0113">
        <items id="text">Möjliga felkällor</items>
        <items id="description">Villkor eller omständigheter som påverkar tolkningen av laboratorieresultatet.</items>
      </items>
      <items code="at0114">
        <items id="text">Strukturerade möjliga felkällor</items>
        <items id="description">Mer information om problem eller omständigheter som kan påverka tolkningen av mätningen eller testresultatet.</items>
      </items>
      <items code="at0115">
        <items id="text">Rättad</items>
        <items id="description">Det slutgiltiga undersökningsresultatet har rättats. Detta är en underkategori av "Reviderad".</items>
      </items>
      <items code="at0116">
        <items id="text">Felregistrerad</items>
        <items id="description">Undersökningsresultatet har dragits tillbaka efter att ha varit i status "Slutgiltig".</items>
      </items>
      <items code="at0117">
        <items id="text">Ytterligare information</items>
        <items id="description">Ytterligare information som krävs för att registrera lokalt definierat innehåll eller för anpassning till andra referensmodeller.
  </items>
      </items>
      <items code="at0118">
        <items id="text">Multimedia</items>
        <items id="description">Digital bild, video eller diagram som representerar undersökningsresultatet.</items>
      </items>
      <items code="at0119">
        <items id="text">Utökat</items>
        <items id="description">Det slutgiltiga undersökningsresultatet har ändrats genom att nytt innehåll har inkluderats. Det befintliga innehållet är oförändrat. Detta är en underkategori av "Reviderad".</items>
      </items>
      <items code="at0120">
        <items id="text">Preliminär</items>
        <items id="description">Verifierade tidiga resultat är tillgängliga, men inte alla resultat är slutgiltiga. Detta är en underkategori av status "Partiell".</items>
      </items>
      <items code="at0121">
        <items id="text">Undersökningsmetod</items>
        <items id="description">Beskrivning av den metod som använts för att utföra undersökningen eller analysen.</items>
      </items>
      <items code="at0122">
        <items id="text">Strukturerad undersökningsdiagnos</items>
        <items id="description">En strukturerad eller komplex diagnos för laboratorieundersökningen.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.specimen.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Specimen</items>
        <items id="description">Source and/or extracted specimen (parent–child via Parent specimen identifier).</items>
      </items>
      <items code="at0001">
        <items id="text">Laboratory specimen identifier</items>
        <items id="description">A unique identifier of the specimen, normally assigned by the laboratory.</items>
      </items>
      <items code="at0003">
        <items id="text">Parent specimen identifier</items>
        <items id="description">Unique identifier of the parent specimen, where the specimen is split into sub-samples.</items>
      </items>
      <items code="at0005">
        <items id="text">Hazard warning</items>
        <items id="description">Identified health risk or biohazard to the collector or laboratory staff due to exposure to, or contact with, the specimen.</items>
      </items>
      <items code="at0007">
        <items id="text">Collection method</items>
        <items id="description">The method of collection used.</items>
      </items>
      <items code="at0008">
        <items id="text">Sampling context</items>
        <items id="description">The context in which the specimen is collected.</items>
      </items>
      <items code="at0013">
        <items id="text">Anatomical location</items>
        <items id="description">Body site and laterality of collection.</items>
      </items>
      <items code="at0015">
        <items id="text">Collection date/time</items>
        <items id="description">The date and time that collection has been ordered to take place or has taken place.</items>
      </items>
      <items code="at0027">
        <items id="text">Physical properties</items>
        <items id="description">Physical dimensions, mass or non-measurable properties of the specimen.</items>
      </items>
      <items code="at0029">
        <items id="text">Specimen type</items>
        <items id="description">The type of specimen.</items>
      </items>
      <items code="at0034">
        <items id="text">Date/time received</items>
        <items id="description">The date and time that the sample was received at the laboratory.</items>
      </items>
      <items code="at0041">
        <items id="text">Adequacy for testing</items>
        <items id="description">Information about whether the specimen was adequate for testing.</items>
      </items>
      <items code="at0042">
        <items id="text">Specimen quality issue</items>
        <items id="description">A specific quality issue with a specimen.</items>
      </items>
      <items code="at0045">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the specimen not captured in other fields.</items>
      </items>
      <items code="at0052">
        <items id="text">Haemolysed</items>
        <items id="description">The specimen was haemolysed.</items>
      </items>
      <items code="at0053">
        <items id="text">Lipaemic</items>
        <items id="description">The specimen was lipaemic.</items>
      </items>
      <items code="at0054">
        <items id="text">Incorrect additive</items>
        <items id="description">An incorrect additive such as a transport medium or preservative was added to the specimen.</items>
      </items>
      <items code="at0055">
        <items id="text">Insufficient amount</items>
        <items id="description">The available amount of specimen was insufficient to undertake the examination.</items>
      </items>
      <items code="at0062">
        <items id="text">Satisfactory</items>
        <items id="description">The specimen is of sufficient quality to allow reporting.</items>
      </items>
      <items code="at0063">
        <items id="text">Unsatisfactory - analysed</items>
        <items id="description">The specimen is unsatisfactory but has been analysed.</items>
      </items>
      <items code="at0064">
        <items id="text">Unsatisfactory - not analysed</items>
        <items id="description">The specimen is unsatisfactory and has not been analysed.</items>
      </items>
      <items code="at0067">
        <items id="text">Collection setting</items>
        <items id="description">Identification of the physical setting in which the specimen is collected.</items>
      </items>
      <items code="at0068">
        <items id="text">Processing details</items>
        <items id="description">Structured details about preparation or processing of the specimen.</items>
      </items>
      <items code="at0070">
        <items id="text">Specimen collector identifier</items>
        <items id="description">Identifier of the person or organisation responsible for collecting the specimen.</items>
      </items>
      <items code="at0071">
        <items id="text">Specimen collector details</items>
        <items id="description">The person or organisation responsible for collecting the specimen.</items>
      </items>
      <items code="at0079">
        <items id="text">Collection description</items>
        <items id="description">Narrative description about the collection of the specimen.</items>
      </items>
      <items code="at0080">
        <items id="text">Number of containers</items>
        <items id="description">The total number of physical units holding this specimen.</items>
      </items>
      <items code="at0083">
        <items id="text">Specimen processing</items>
        <items id="description">Fixation and other processing (e.g. FFPE); in Additional details slot.</items>
      </items>
      <items code="at0085">
        <items id="text">Container details</items>
        <items id="description">Details about containers used.</items>
      </items>
      <items code="at0087">
        <items id="text">Source site</items>
        <items id="description">Identification of the body site or other location from where the specimen is collected.</items>
      </items>
      <items code="at0088">
        <items id="text">External identifier</items>
        <items id="description">A unique identifier of the specimen, assigned by a party external to the laboratory.</items>
      </items>
      <items code="at0089">
        <items id="text">Icteric</items>
        <items id="description">The specimen was icteric.</items>
      </items>
      <items code="at0090">
        <items id="text">Handling error</items>
        <items id="description">An error arose when handling the specimen. For example: Incorrect storage, broken container.</items>
      </items>
      <items code="at0091">
        <items id="text">Age</items>
        <items id="description">The specimen was too old to analyse or to analyse accurately.</items>
      </items>
      <items code="at0092">
        <items id="text">Technical failure</items>
        <items id="description">The specimen could not be analysed for technical reasons.</items>
      </items>
      <items code="at0093">
        <items id="text">Transport details</items>
        <items id="description">Structured details about transport of the specimen.</items>
      </items>
      <items code="at0094">
        <items id="text">Clotted</items>
        <items id="description">The specimen was clotted.</items>
      </items>
      <items code="at0095">
        <items id="text">Incorrectly labelled</items>
        <items id="description">The specimen was labelled incorrectly.</items>
      </items>
      <items code="at0096">
        <items id="text">Digital representation</items>
        <items id="description">Structured details about a digital representation of the specimen.</items>
      </items>
      <items code="at0097">
        <items id="text">Specimen description</items>
        <items id="description">Narrative description about the specimen being examined.</items>
      </items>
      <items code="at0098">
        <items id="text">Specimen label</items>
        <items id="description">A name or label describing the specimen.</items>
      </items>
      <items code="at0099">
        <items id="text">Number of fragments</items>
        <items id="description">The number of tissue fragments comprising the specimen.</items>
      </items>
      <items code="at0100">
        <items id="text">Storage details</items>
        <items id="description">Structured details about the storage of the specimen.</items>
      </items>
      <items code="at0.1">
        <items id="text">Blood venous</items>
        <items id="description">HL7 v2 0487: BLDV.</items>
      </items>
      <items code="at0.2">
        <items id="text">Marrow</items>
        <items id="description">HL7 v2 0487: MAR.</items>
      </items>
      <items code="at0.3">
        <items id="text">Tissue</items>
        <items id="description">HL7 v2 0487: TISS.</items>
      </items>
      <items code="at0.4">
        <items id="text">Tumor</items>
        <items id="description">HL7 v2 0487: TUMOR.</items>
      </items>
      <items code="at0.5">
        <items id="text">Pleural fluid</items>
        <items id="description">HL7 v2 0487: PLR.</items>
      </items>
      <items code="at0.6">
        <items id="text">Fluid, Abdomen</items>
        <items id="description">HL7 v2 0487: FGA.</items>
      </items>
      <items code="at0.7">
        <items id="text">Cerebrospinal fluid</items>
        <items id="description">HL7 v2 0487: CSF.</items>
      </items>
      <items code="at0.8">
        <items id="text">Bone</items>
        <items id="description">HL7 v2 0487: BON.</items>
      </items>
      <items code="at0.9">
        <items id="text">Skin</items>
        <items id="description">HL7 v2 0487: SKN.</items>
      </items>
      <items code="at0.10">
        <items id="text">Bile Fluid</items>
        <items id="description">HL7 v2 0487: BIFL.</items>
      </items>
      <items code="at0.11">
        <items id="text">Cervical Mucus</items>
        <items id="description">HL7 v2 0487: CVM.</items>
      </items>
      <items code="at0.12">
        <items id="text">Urine</items>
        <items id="description">HL7 v2 0487: UR.</items>
      </items>
      <items code="at0.13">
        <items id="text">Stool = Fecal</items>
        <items id="description">HL7 v2 0487: STL.</items>
      </items>
      <items code="at0.14">
        <items id="text">DNA</items>
        <items id="description">Extracted material.</items>
      </items>
      <items code="at0.15">
        <items id="text">RNA</items>
        <items id="description">Extracted material.</items>
      </items>
      <items code="at0.16">
        <items id="text">Circulating tumour DNA (ctDNA)</items>
        <items id="description">Extracted material.</items>
      </items>
      <items code="at0.17">
        <items id="text">Circulating tumour RNA (ctRNA)</items>
        <items id="description">Extracted material.</items>
      </items>
      <items code="at0.18">
        <items id="text">Cell-free DNA (cfDNA)</items>
        <items id="description">Extracted material.</items>
      </items>
      <items code="at0.30">
        <items id="text">Resection (procedure)</items>
        <items id="description">Collection technique.</items>
      </items>
      <items code="at0.31">
        <items id="text">Excision (procedure)</items>
        <items id="description">Collection technique.</items>
      </items>
      <items code="at0.32">
        <items id="text">Core needle biopsy</items>
