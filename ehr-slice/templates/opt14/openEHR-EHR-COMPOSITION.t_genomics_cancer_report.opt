        <items id="description">Målvarianten förekommer inte.</items>
      </items>
      <items code="at0006">
        <items id="text">Ingen bestämning</items>
        <items id="description">Data saknas för att bekräfta förekomst/frånvaro av varianten.</items>
      </items>
      <items code="at0007">
        <items id="text">Obestämbart</items>
        <items id="description">Resultatet är obestämbart.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.translocation_variant.v0">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Translocation / fusion structure</items>
        <items id="description">Structural detail for rearrangements (draft; REVIEWSUSPENDED on CKM).</items>
      </items>
      <items code="at0003">
        <items id="text">Breakpoint position 1</items>
        <items id="description">Position of first breakpoint relative to start of "Chromosome 1".</items>
      </items>
      <items code="at0004">
        <items id="text">Breakpoint position 2</items>
        <items id="description">Position of second breakpoint relative to start of "Chromosome 2".</items>
      </items>
      <items code="at0005">
        <items id="text">Strand 1</items>
        <items id="description">A value of "+" indicates that the chromosomal segment at the second breakpoint is connected to the chromosomal segment at the first breakpoint right of "Breakpoint position 1". A value of "-" indicates that the chromosomal segment at the second breakpoint is connected to the chromosomal segment of the first breakpoint left of "Breakpoint position 1".</items>
      </items>
      <items code="at0006">
        <items id="text">Strand 2</items>
        <items id="description">A value of "+" indicates that the chromosomal segment at the first breakpoint is connected to the chromosomal segment at the second breakpoint right of "Breakpoint position 2". A value of "-" indicates that the chromosomal segment at the first breakpoint is connected to the chromosomal segment of the second breakpoint left of "Breakpoint position 2".</items>
      </items>
      <items code="at0007">
        <items id="text">Reference sequence 1</items>
        <items id="description">Chromosome of first breakpoint.</items>
      </items>
      <items code="at0008">
        <items id="text">Reference sequence 2</items>
        <items id="description">Chromosome of second breakpoint.</items>
      </items>
      <items code="at0009">
        <items id="text">HGVS term</items>
        <items id="description">The description of the variant using the recommendations of the accepted HGVS nomeclature named extension ISCN.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Translokation / fusionsstruktur</items>
        <items id="description">Strukturdetalj för rearrangemang (utkast).</items>
      </items>
      <items code="at0003">
        <items id="text">Brytpunktsposition 1</items>
        <items id="description">Position för första brytpunkten relativt början av "Kromosom 1".</items>
      </items>
      <items code="at0004">
        <items id="text">Brytpunktsposition 2</items>
        <items id="description">Position för andra brytpunkten relativt början av "Kromosom 2".</items>
      </items>
      <items code="at0005">
        <items id="text">Sträng 1</items>
        <items id="description">Värdet "+" anger att kromosomsegmentet vid andra brytpunkten är kopplat till kromosomsegmentet vid första brytpunkten till höger om "Brytpunktsposition 1". Värdet "-" anger att det är kopplat till vänster om "Brytpunktsposition 1".</items>
      </items>
      <items code="at0006">
        <items id="text">Sträng 2</items>
        <items id="description">Värdet "+" anger att kromosomsegmentet vid första brytpunkten är kopplat till kromosomsegmentet vid andra brytpunkten till höger om "Brytpunktsposition 2". Värdet "-" anger att det är kopplat till vänster om "Brytpunktsposition 2".</items>
      </items>
      <items code="at0007">
        <items id="text">Referenssekvens 1</items>
        <items id="description">Kromosom för första brytpunkten.</items>
      </items>
      <items code="at0008">
        <items id="text">Referenssekvens 2</items>
        <items id="description">Kromosom för andra brytpunkten.</items>
      </items>
      <items code="at0009">
        <items id="text">HGVS-term</items>
        <items id="description">Beskrivning av varianten enligt rekommendationerna i den accepterade HGVS-nomenklaturens utvidgning ISCN.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.variant_clinical_implication.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Clinical implication</items>
        <items id="description">Diagnostic and/or therapeutic implication for this variant.</items>
      </items>
      <items code="at9001">
        <items id="text">Implication identifier</items>
        <items id="description">Business identifier for this implication entry (FHIR Observation.identifier).</items>
      </items>
      <items code="at9003">
        <items id="text">Implication type</items>
        <items id="description">Whether this implication is diagnostic or therapeutic.</items>
      </items>
      <items code="at9005">
        <items id="text">Status</items>
        <items id="description">Lifecycle status of the implication (e.g. preliminary, final, amended).</items>
      </items>
      <items code="at0007">
        <items id="text">Summary</items>
        <items id="description">Free-text summary of the clinical implication.</items>
      </items>
      <items code="at0009">
        <items id="text">Related therapy or finding</items>
        <items id="description">Associated drug, therapy class, or diagnostic finding text/code.</items>
      </items>
      <items code="at0012">
        <items id="text">Linked variant reference</items>
        <items id="description">Optional explicit link back to the source variant when implications are stored separately.</items>
      </items>
      <items code="at9000">
        <items id="text">Diagnostic</items>
        <items id="description">Implication affects diagnosis, subtype, or prognosis classification.</items>
      </items>
      <items code="at0001">
        <items id="text">Therapeutic</items>
        <items id="description">Implication affects treatment choice or eligibility.</items>
      </items>
      <items code="at0002">
        <items id="text">Preliminary</items>
        <items id="description">Implication is preliminary.</items>
      </items>
      <items code="at0003">
        <items id="text">Final</items>
        <items id="description">Implication is final.</items>
      </items>
      <items code="at0004">
        <items id="text">Amended</items>
        <items id="description">Implication has been amended.</items>
      </items>
      <items code="at0005">
        <items id="text">Cancelled</items>
        <items id="description">Implication cancelled / entered in error.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Klinisk implikation</items>
        <items id="description">Diagnostisk och/eller terapeutisk implikation för varianten.</items>
      </items>
      <items code="at9001">
        <items id="text">Implikationsidentifierare</items>
        <items id="description">Verksamhetsidentifierare för implikationsposten.</items>
      </items>
      <items code="at9003">
        <items id="text">Implikationstyp</items>
        <items id="description">Om implikationen är diagnostisk eller terapeutisk.</items>
      </items>
      <items code="at9005">
        <items id="text">Status</items>
        <items id="description">Livscykelstatus för implikationen.</items>
      </items>
      <items code="at0007">
        <items id="text">Sammanfattning</items>
        <items id="description">Fritextsammanfattning av den kliniska implikationen.</items>
      </items>
      <items code="at0009">
        <items id="text">Relaterad behandling eller fynd</items>
        <items id="description">Associerat läkemedel, behandlingsklass eller diagnostiskt fynd.</items>
      </items>
      <items code="at0012">
        <items id="text">Länkad variantreferens</items>
        <items id="description">Valfri explicit länk tillbaka till källvarianten.</items>
      </items>
      <items code="at9000">
        <items id="text">Diagnostisk</items>
        <items id="description">Implikation påverkar diagnos, subtyp eller prognosklassificering.</items>
      </items>
      <items code="at0001">
        <items id="text">Terapeutisk</items>
        <items id="description">Implikation påverkar behandlingsval eller behörighet.</items>
      </items>
      <items code="at0002">
        <items id="text">Preliminär</items>
        <items id="description">Implikationen är preliminär.</items>
      </items>
      <items code="at0003">
        <items id="text">Slutgiltig</items>
        <items id="description">Implikationen är slutgiltig.</items>
      </items>
      <items code="at0004">
        <items id="text">Ändrad</items>
        <items id="description">Implikationen har ändrats.</items>
      </items>
      <items code="at0005">
        <items id="text">Makulerad</items>
        <items id="description">Implikationen makulerad / felaktigt registrerad.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.organisation.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Receiving laboratory</items>
        <items id="description">Laboratory organisation (HSA identifiers).</items>
      </items>
      <items code="at0001">
        <items id="text">Name</items>
        <items id="description">The unstructured name or label for the organisation.</items>
      </items>
      <items code="at0002">
        <items id="text">Contact person</items>
        <items id="description">Details about one or more people within the organisation.</items>
      </items>
      <items code="at0003">
        <items id="text">Identifier</items>
        <items id="description">Identifier associated with the organisation.</items>
      </items>
      <items code="at0004">
        <items id="text">Role</items>
        <items id="description">The relationship or role of the organisation to the individual or subject of care.</items>
      </items>
      <items code="at0005">
        <items id="text">Address</items>
        <items id="description">Details about an address for the organisation.</items>
      </items>
      <items code="at0017">
        <items id="text">Additional details</items>
        <items id="description">Additional details about the organisation.</items>
      </items>
      <items code="at0019">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the organisation not captured in other fields.</items>
      </items>
      <items code="at0021">
        <items id="text">Parent organisation</items>
        <items id="description">A larger organisation of which this organisation is a child or subsidiary.</items>
      </items>
      <items code="at0022">
        <items id="text">Electronic communication</items>
        <items id="description">Details about one or more types of electronic communication for the organisation.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Mottagande laboratorium</items>
        <items id="description">Laboratorieorganisation (HSA-identiteter).</items>
      </items>
      <items code="at0001">
        <items id="text">Namn</items>
        <items id="description">Namnet som en organisation är känd under.</items>
      </items>
      <items code="at0002">
        <items id="text">Kontaktperson</items>
        <items id="description">Uppgifter om en eller flera kontaktpersoner inom organisationen.</items>
      </items>
      <items code="at0003">
        <items id="text">Identifierare</items>
        <items id="description">Identifierare associerad med organisationen.</items>
      </items>
      <items code="at0004">
        <items id="text">Roll</items>
        <items id="description">Organisationens relation till eller roll gentemot vårdtagaren.</items>
      </items>
      <items code="at0005">
        <items id="text">Adress</items>
        <items id="description">Organisationens adressuppgifter.</items>
      </items>
      <items code="at0017">
        <items id="text">Ytterligare detaljer</items>
        <items id="description">Ytterligare uppgifter om organisationen.</items>
      </items>
      <items code="at0019">
        <items id="text">Kommentar</items>
        <items id="description">Kommentarer avseende organisationen som inte beskrivs i övriga datafält.</items>
      </items>
      <items code="at0021">
        <items id="text">Överordnad organisation</items>
        <items id="description">Den större organisation som denna organisation är en del i.</items>
      </items>
      <items code="at0022">
        <items id="text">Elektronisk kommunikation</items>
        <items id="description">Ett eller flera elektroniska kommunikationssätt som organisationen använder.</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.sequencing_assay-genomic_study.v0">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Sequencing assay</items>
        <items id="description">An assay that uses sequencing technology to infer the sequence of a nucleic acid (DNA, RNA).</items>
      </items>
      <items code="at0001">
        <items id="text">Sequencing type</items>
        <items id="description">Name of the technology used for sequencing analysis.</items>
      </items>
      <items code="at0002">
        <items id="text">Kit name</items>
        <items id="description">Name of the kit used for the experiment.</items>
      </items>
      <items code="at0003">
        <items id="text">Nucleic acid</items>
        <items id="description">Type of nucleic acid used for sequencing, e.g. DNA, RNA or cf-DNA.</items>
      </items>
      <items code="at0006">
        <items id="text">Tested Gene</items>
        <items id="description">List of all tested genes, if panel sequencing was performed.</items>
      </items>
      <items code="at0007">
        <items id="text">Gene symbol</items>
        <items id="description">The official gene symbol approved by the HGNC, which is a short abbreviated form of the gene name.</items>
      </items>
      <items code="at0022">
        <items id="text">DNA</items>
        <items id="description" />
      </items>
      <items code="at0023">
        <items id="text">RNA</items>
        <items id="description" />
      </items>
      <items code="at0024">
        <items id="text">cf-DNA</items>
        <items id="description" />
      </items>
      <items code="at0025">
        <items id="text">Gene reference sequence</items>
        <items id="description">Structured details on the reference sequence of the gene.</items>
      </items>
      <items code="at0026">
        <items id="text">Extensions</items>
        <items id="description">Additional details to be captured.</items>
      </items>
      <items code="at0030">
        <items id="text">Tested Region</items>
        <items id="description">If panel sequencing was performed, this cluster is used to report the region(s) of interest for sequencing studies as one genomic range that identifies the parts of the reference sequence that are sequenced.</items>
      </items>
      <items code="at0031">
        <items id="text">Chromosome label</items>
        <items id="description">The chromosome of the tested region.</items>
      </items>
      <items code="at0032">
        <items id="text">Start</items>
        <items id="description">Start position of the tested region.</items>
      </items>
      <items code="at0033">
        <items id="text">End</items>
        <items id="description">End position of the tested region.</items>
      </items>
      <items code="at0035">
        <items id="text">Reference sequence of region</items>
        <items id="description">Structured details on the reference sequence of the region.</items>
      </items>
      <items code="at0036">
        <items id="text">Sequencing device</items>
        <items id="description">The technology platform used to perform nucleic acid sequencing.</items>
      </items>
      <items code="at0037">
        <items id="text">Comment</items>
        <items id="description">Comment on the sequencing assay that was not captured in other fields.</items>
      </items>
      <items code="at0038">
        <items id="text">Reference genome</items>
        <items id="description">Structured details about the specific version of the human sequence assembly used for annotation.</items>
      </items>
      <items code="at0039">
        <items id="text">Bioinformatic analysis</items>
        <items id="description">Structured details about the bioinformatic analysis workflow steps or the protocols that is used (e.g., devices, software, pipelines).</items>
      </items>
      <items code="at0064">
        <items id="text">Chromosome 1</items>
        <items id="description">Chromosome 1.</items>
      </items>
