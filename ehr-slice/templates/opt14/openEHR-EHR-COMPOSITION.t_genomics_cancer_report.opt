                <archetype_id>
                  <value>openEHR-EHR-CLUSTER.sequencing_assay-genomic_study.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                  <items id="text">Sequencing assay</items>
                  <items id="description">An assay that uses sequencing technology to infer the sequence of a nucleic acid (DNA, RNA).</items>
                </term_definitions>
                <term_definitions code="at0001">
                  <items id="text">Sequencing type</items>
                  <items id="description">Name of the technology used for sequencing analysis.</items>
                </term_definitions>
                <term_definitions code="at0002">
                  <items id="text">Kit name</items>
                  <items id="description">Name of the kit used for the experiment.</items>
                </term_definitions>
                <term_definitions code="at0003">
                  <items id="text">Nucleic acid</items>
                  <items id="description">Type of nucleic acid used for sequencing, e.g. DNA, RNA or cf-DNA.</items>
                </term_definitions>
                <term_definitions code="at0006">
                  <items id="text">Tested Gene</items>
                  <items id="description">List of all tested genes, if panel sequencing was performed.</items>
                </term_definitions>
                <term_definitions code="at0007">
                  <items id="text">Gene symbol</items>
                  <items id="description">The official gene symbol approved by the HGNC, which is a short abbreviated form of the gene name.</items>
                </term_definitions>
                <term_definitions code="at0022">
                  <items id="text">DNA</items>
                  <items id="description" />
                </term_definitions>
                <term_definitions code="at0023">
                  <items id="text">RNA</items>
                  <items id="description" />
                </term_definitions>
                <term_definitions code="at0024">
                  <items id="text">cf-DNA</items>
                  <items id="description" />
                </term_definitions>
                <term_definitions code="at0025">
                  <items id="text">Gene reference sequence</items>
                  <items id="description">Structured details on the reference sequence of the gene.</items>
                </term_definitions>
                <term_definitions code="at0026">
                  <items id="text">Extensions</items>
                  <items id="description">Additional details to be captured.</items>
                </term_definitions>
                <term_definitions code="at0030">
                  <items id="text">Tested Region</items>
                  <items id="description">If panel sequencing was performed, this cluster is used to report the region(s) of interest for sequencing studies as one genomic range that identifies the parts of the reference sequence that are sequenced.</items>
                </term_definitions>
                <term_definitions code="at0031">
                  <items id="text">Chromosome label</items>
                  <items id="description">The chromosome of the tested region.</items>
                </term_definitions>
                <term_definitions code="at0032">
                  <items id="text">Start</items>
                  <items id="description">Start position of the tested region.</items>
                </term_definitions>
                <term_definitions code="at0033">
                  <items id="text">End</items>
                  <items id="description">End position of the tested region.</items>
                </term_definitions>
                <term_definitions code="at0035">
                  <items id="text">Reference sequence of region</items>
                  <items id="description">Structured details on the reference sequence of the region.</items>
                </term_definitions>
                <term_definitions code="at0036">
                  <items id="text">Sequencing device</items>
                  <items id="description">The technology platform used to perform nucleic acid sequencing.</items>
                </term_definitions>
                <term_definitions code="at0037">
                  <items id="text">Comment</items>
                  <items id="description">Comment on the sequencing assay that was not captured in other fields.</items>
                </term_definitions>
                <term_definitions code="at0038">
                  <items id="text">Reference genome</items>
                  <items id="description">Structured details about the specific version of the human sequence assembly used for annotation.</items>
                </term_definitions>
                <term_definitions code="at0039">
                  <items id="text">Bioinformatic analysis</items>
                  <items id="description">Structured details about the bioinformatic analysis workflow steps or the protocols that is used (e.g., devices, software, pipelines).</items>
                </term_definitions>
                <term_definitions code="at0064">
                  <items id="text">Chromosome 1</items>
                  <items id="description">Chromosome 1.</items>
                </term_definitions>
                <term_definitions code="at0065">
                  <items id="text">Chromosome 2</items>
                  <items id="description">Chromosome 2.</items>
                </term_definitions>
                <term_definitions code="at0066">
                  <items id="text">Chromosome 3</items>
                  <items id="description">Chromosome 3.</items>
                </term_definitions>
                <term_definitions code="at0067">
                  <items id="text">Chromosome 4</items>
                  <items id="description">Chromosome 4.</items>
                </term_definitions>
                <term_definitions code="at0068">
                  <items id="text">Chromosome 5</items>
                  <items id="description">Chromosome 5.</items>
                </term_definitions>
                <term_definitions code="at0069">
                  <items id="text">Chromosome 6</items>
                  <items id="description">Chromosome 6.</items>
                </term_definitions>
                <term_definitions code="at0070">
                  <items id="text">Chromosome 7</items>
                  <items id="description">Chromosome 7.</items>
