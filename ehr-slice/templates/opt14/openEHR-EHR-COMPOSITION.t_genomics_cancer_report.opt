      <items code="at0000.1">
        <items id="text">Sekvenseringsassay</items>
        <items id="description">Studie-/assaymetadata (sekvenseringstyp, kit, nukleinsyra, enhet).</items>
      </items>
      <items code="at0.1">
        <items id="text">Studieidentifierare</items>
        <items id="description">Identifierare för sekvenserings-/genomikstudien (FHIR GenomicStudy.identifier).</items>
      </items>
      <items code="at0.2">
        <items id="text">Analystyp</items>
        <items id="description">Typ av genomisk studie, t.ex. SNP-detektion eller CNV-detektion (FHIR GenomicStudy.type). Kan förekomma flera gånger.</items>
      </items>
      <items code="at0.4">
        <items id="text">Analysmetod</items>
        <items id="description">Kodad metodtyp för sekvenseringstypen (FHIR GenomicStudy.analysis.methodType).</items>
      </items>
      <items code="at0.10">
        <items id="text">Detektion av alternativ splitsning</items>
        <items id="description">Alternative splicing detection (HL7 genomic-study-type: alt-splc).</items>
      </items>
      <items code="at0.11">
        <items id="text">Kromatinkonformation</items>
        <items id="description">Chromatin conformation (HL7 genomic-study-type: chromatin).</items>
      </items>
      <items code="at0.12">
        <items id="text">CNV-detektion</items>
        <items id="description">CNV detection (HL7 genomic-study-type: cnv).</items>
      </items>
      <items code="at0.13">
        <items id="text">Epigenetiska förändringar – histonmodifieringar</items>
        <items id="description">Epigenetic Alterations - histone modifications (HL7 genomic-study-type: epi-alt-hist).</items>
      </items>
      <items code="at0.14">
        <items id="text">Epigenetiska förändringar – DNA-metylering</items>
        <items id="description">Epigenetic Alterations -DNA methylation (HL7 genomic-study-type: epi-alt-dna).</items>
      </items>
      <items code="at0.15">
        <items id="text">Familjär variantsegregation</items>
        <items id="description">Familial variant segregation (HL7 genomic-study-type: fam-var-segr).</items>
      </items>
      <items code="at0.16">
        <items id="text">Detektion av funktionell variation</items>
        <items id="description">Functional variation detection (HL7 genomic-study-type: func-var).</items>
      </items>
      <items code="at0.17">
        <items id="text">Genuttrycksprofilering</items>
        <items id="description">Gene expression profiling (HL7 genomic-study-type: gene-expression).</items>
      </items>
      <items code="at0.18">
        <items id="text">Identifiering av posttranslationell modifiering</items>
        <items id="description">Post-translational Modification Identification (HL7 genomic-study-type: post-trans-mod).</items>
      </items>
      <items code="at0.19">
        <items id="text">SNP-detektion</items>
        <items id="description">SNP Detection (HL7 genomic-study-type: snp).</items>
      </items>
      <items code="at0.20">
        <items id="text">STR-räkning</items>
        <items id="description">STR count (HL7 genomic-study-type: str).</items>
      </items>
      <items code="at0.21">
        <items id="text">Detektion av strukturell variation</items>
        <items id="description">Structural variation detection (HL7 genomic-study-type: struc-var).</items>
      </items>
      <items code="at0.30">
        <items id="text">Sekvensanalys av utvalda exon (riktad NGS-panel)</items>
        <items id="description">HL7 genomic-study-method-type: sequence-analysis-of-select-exons.</items>
      </items>
      <items code="at0.31">
        <items id="text">Sekvensanalys av hela den kodande regionen (WES/WGS)</items>
        <items id="description">HL7 genomic-study-method-type: sequence-analysis-of-the-entire-coding-region.</items>
      </items>
      <items code="at0.32">
        <items id="text">Nästa generations / massivt parallell sekvensering</items>
        <items id="description">HL7 genomic-study-method-type: ngs-mps.</items>
      </items>
      <items code="at0.33">
        <items id="text">Fluorescens in situ-hybridisering (FISH)</items>
        <items id="description">HL7 genomic-study-method-type: fish.</items>
      </items>
      <items code="at0.34">
        <items id="text">PCR</items>
        <items id="description">HL7 genomic-study-method-type: pcr.</items>
      </items>
      <items code="at0.35">
        <items id="text">Dubbelriktad Sanger-sekvensanalys</items>
        <items id="description">HL7 genomic-study-method-type: bi-directional-sanger-sequence-analysis.</items>
      </items>
      <items code="at0.36">
        <items id="text">Karyotypering</items>
        <items id="description">HL7 genomic-study-method-type: karyotyping.</items>
      </items>
      <items code="at0.37">
        <items id="text">Multiplex ligeringsberoende probamplifiering (MLPA)</items>
        <items id="description">HL7 genomic-study-method-type: mlpa.</items>
      </items>
      <items code="at0.38">
        <items id="text">Metyleringsanalys</items>
        <items id="description">HL7 genomic-study-method-type: methylation-analysis.</items>
      </items>
      <items code="at0036.0">
        <items id="text">Sekvenseringsenhet / panel</items>
        <items id="description">Instrument eller kit/panelprodukt för sekvensering.</items>
      </items>
      <items code="at0038.0">
        <items id="text">Referensgenom</items>
        <items id="description">Referenssekvens för alignment (t.ex. GRCh38).</items>
      </items>
    </term_definitions>
  </component_ontologies>
  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.device.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Sequencing device / panel</items>
        <items id="description">Instrument or kit/panel product used for sequencing.</items>
      </items>
      <items code="at0001">
        <items id="text">Device name</items>
        <items id="description">Identification of the medical device, preferably by a common name, a formal fully descriptive name or, if required, by class or category of device.</items>
      </items>
      <items code="at0002">
        <items id="text">Description</items>
        <items id="description">Narrative description of the medical device.</items>
      </items>
      <items code="at0003">
        <items id="text">Type</items>
        <items id="description">The category or kind of device.</items>
      </items>
      <items code="at0004">
        <items id="text">Manufacturer</items>
        <items id="description">Name of manufacturer.</items>
      </items>
      <items code="at0005">
        <items id="text">Date of manufacture</items>
        <items id="description">Date the device was manufactured.</items>
      </items>
      <items code="at0006">
        <items id="text">Batch/Lot number</items>
        <items id="description">The number assigned by the manufacturer which identifies a group of items manufactured at the same time, usually found on the label or packaging material.</items>
      </items>
      <items code="at0007">
        <items id="text">Date of expiry</items>
        <items id="description">Date after which the device/product is no longer fit for use, usually found on the device itself or printed on the accompanying packaging.</items>
      </items>
      <items code="at0008">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the device not captured in other fields.</items>
      </items>
      <items code="at0009">
        <items id="text">Properties</items>
        <items id="description">Further details about specific properties about the medical device.</items>
      </items>
      <items code="at0018">
        <items id="text">Components</items>
        <items id="description">Additional structured informations about identified components of the device.</items>
      </items>
      <items code="at0019">
        <items id="text">Asset management</items>
        <items id="description">Further details about management and maintenance of the device.</items>
      </items>
      <items code="at0020">
        <items id="text">Serial number</items>
        <items id="description">Number assigned by the manufacturer which can be found on the device, and should be specific to each device., its label, or accompanying packaging.</items>
      </items>
      <items code="at0021">
        <items id="text">Unique device identifier (UDI)</items>
        <items id="description">A numeric or alphanumeric string that is associated with this device within a given system.</items>
      </items>
      <items code="at0022">
        <items id="text">Catalogue number</items>
        <items id="description">The exact number assigned by the manufacturer, as it appears in the manufacturer's catalogue, device labeling, or accompanying packaging.</items>
      </items>
      <items code="at0023">
        <items id="text">Model number</items>
        <items id="description">The exact model number assigned by the manufacturer and found on the device label or accompanying packaging.</items>
      </items>
      <items code="at0024">
        <items id="text">Other identifier</items>
        <items id="description">Unspecified identifier, which can be further specified in a template or at run time.</items>
      </items>
      <items code="at0025">
        <items id="text">Software version</items>
        <items id="description">Identification of the version of software being used in the medical device.</items>
      </items>
      <items code="at0026">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items>
      </items>
      <items code="at0027">
        <items id="text">Multimedia</items>
        <items id="description">Digital representation of the device.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Sekvenseringsenhet / panel</items>
        <items id="description">Instrument eller kit/panelprodukt för sekvensering.</items>
      </items>
      <items code="at0001">
        <items id="text">Namn på medicinteknisk produkt</items>
        <items id="description">Identifiering av den medicintekniska produkten, helst med ett vanligt namn, ett formellt fullständigt beskrivande namn eller om det är ett krav med klass eller kategori.</items>
      </items>
      <items code="at0002">
        <items id="text">Beskrivning</items>
        <items id="description">Beskrivning av den medicintekniska produkten.</items>
      </items>
      <items code="at0003">
        <items id="text">Typ</items>
        <items id="description">Kategorin eller typ av medicinteknisk produkt.</items>
      </items>
      <items code="at0004">
        <items id="text">Tillverkare</items>
        <items id="description">Namn på tillverkaren</items>
      </items>
      <items code="at0005">
        <items id="text">Tillverkningsdatum</items>
        <items id="description">Det datum då den medicintekniska produkten tillverkades.</items>
      </items>
      <items code="at0006">
        <items id="text">Batch/LOT-nummer</items>
        <items id="description">Det nummer som tilldelats av tillverkaren och som identifierar en grupp artiklar som tillverkas samtidigt. Finns vanligtvis på etiketten eller förpackningen.</items>
      </items>
      <items code="at0007">
        <items id="text">Utgångsdatum</items>
        <items id="description">Datum från då den medicintekniska produkten inte längre är lämplig att användas, vanligtvis finns datumet på den medicintekniska produkten eller tryckt på den medföljande förpackningen.</items>
      </items>
      <items code="at0008">
        <items id="text">Kommentar</items>
        <items id="description">Kommentarer avseende den medicintekniska produkten som inte beskrivs i övriga fält.</items>
      </items>
      <items code="at0009">
        <items id="text">Egenskaper</items>
        <items id="description">Ytterligare information om specifika egenskaper för den medicintekniska produkten.</items>
      </items>
      <items code="at0018">
        <items id="text">Komponenter</items>
        <items id="description">Ytterligare strukturerad information om identifierade komponenter i den medicintekniska produkten.</items>
      </items>
      <items code="at0019">
        <items id="text">Tillgångshantering</items>
        <items id="description">Mer information om underhåll och hantering av den medicintekniska produkten.</items>
      </items>
      <items code="at0020">
        <items id="text">Serienummer</items>
        <items id="description">Tilldelat nummer av tillverkaren av den medicintekniska produkten, bör vara specifik för varje medicinteknisk produkt, dess etikett eller medföljande förpackning.</items>
      </items>
      <items code="at0021">
        <items id="text">Unik produktidentifierare (UDI)</items>
        <items id="description">En numerisk eller alfanumerisk sträng som är associerad med den medicintekniska produkten i ett givet system.</items>
      </items>
      <items code="at0022">
        <items id="text">Katalognummer</items>
        <items id="description">Det exakta nummer som tilldelats av tillverkaren som visas i tillverkarens katalog, produktens märkning eller medföljande förpackning.</items>
      </items>
      <items code="at0023">
        <items id="text">Modellnummer</items>
        <items id="description">Det exakta modellnummer som tilldelats av tillverkaren och som finns på den medicintekniska produktens etikett eller medföljande förpackning.</items>
      </items>
      <items code="at0024">
        <items id="text">Annan identifierare</items>
        <items id="description">Ospecificerad identifierare, som kan specificeras ytterligare i en template eller kan genereras automatiskt av vissa IT-system.</items>
      </items>
      <items code="at0025">
        <items id="text">Mjukvaruversion</items>
        <items id="description">Identifiering av mjukvaruversionen som används i den medicintekniska produkten.</items>
      </items>
      <items code="at0026">
        <items id="text">Tilläggsinformation</items>
        <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
      </items>
      <items code="at0027">
        <items id="text">Multimedia</items>
        <items id="description">Digital representation av den medicintekniska produkten.</items>
      </items>
    </term_definitions>
  </component_ontologies>
