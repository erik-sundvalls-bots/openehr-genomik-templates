  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.genomic_copy_number_variant-cancer.v1">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Genomic copy number variant</items>
        <items id="description">A human genetic sequence change where, compared to a genomic reference sequence, a DNA segment, usually larger than 1 kilobase (kb), was deleted or duplicated.</items>
      </items>
      <items code="at0001">
        <items id="text">Start</items>
        <items id="description">Position or range of possible positions of the first nucleotide of the CNV.</items>
      </items>
      <items code="at0002">
        <items id="text">End</items>
        <items id="description">Position or range of possible positions of the last nucleotide of the CNV.</items>
      </items>
      <items code="at0003">
        <items id="text">Total copy number</items>
        <items id="description">Number of appearance of the allele.</items>
      </items>
      <items code="at0004">
        <items id="text">Reference sequence</items>
        <items id="description">The sequence file used as a reference to describe this variant.</items>
      </items>
      <items code="at0005">
        <items id="text">Copy number change type</items>
        <items id="description">Type of sequence alteration.</items>
      </items>
      <items code="at0006">
        <items id="text">Gain</items>
        <items id="description">A sequence alteration whereby the copy number of a given region is greater than the reference sequence.</items>
      </items>
      <items code="at0007">
        <items id="text">Loss</items>
        <items id="description">A sequence alteration whereby the copy number of a given region is less than the reference sequence.</items>
      </items>
      <items code="at8999">
        <items id="text">Qualified real</items>
        <items id="description">Qualified real</items>
      </items>
      <items code="at0000.1">
        <items id="text">Copy number variant (cancer)</items>
        <items id="description">CNV with Gain/Loss/Amplification/Homozygous deletion.</items>
      </items>
      <items code="at9007.1">
        <items id="text">Copy number change type value</items>
        <items id="description">Coded value for copy number change type including amplification and homozygous deletion.</items>
      </items>
      <items code="at0006.1">
        <items id="text">Amplification</items>
        <items id="description">High-level copy number gain (typically &gt;4–6 copies; laboratory-specific threshold). SO:0001742 used clinically for amplification events such as ERBB2 or MYC.</items>
      </items>
      <items code="at0007.1">
        <items id="text">Homozygous deletion</items>
        <items id="description">Both alleles deleted (0 copies). Aligns with SO:0002210 presence_absence_variation / homozygous deletion (e.g. CDKN2A).</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Genomisk kopietalsvariant</items>
        <items id="description">En genetisk sekvensförändring hos människa där ett DNA-segment, vanligen större än 1 kilobas (kb), jämfört med en genomisk referenssekvens har deleterats eller duplicerats.</items>
      </items>
      <items code="at0001">
        <items id="text">Start</items>
        <items id="description">Position eller intervall av möjliga positioner för CNV:ns första nukleotid.</items>
      </items>
      <items code="at0002">
        <items id="text">Slut</items>
        <items id="description">Position eller intervall av möjliga positioner för CNV:ns sista nukleotid.</items>
      </items>
      <items code="at0003">
        <items id="text">Totalt kopietal</items>
        <items id="description">Antal förekomster av allelen.</items>
      </items>
      <items code="at0004">
        <items id="text">Referenssekvens</items>
        <items id="description">Sekvensfilen som används som referens för att beskriva varianten.</items>
      </items>
      <items code="at0005">
        <items id="text">Typ av kopietalsförändring</items>
        <items id="description">Typ av sekvensförändring.</items>
      </items>
      <items code="at0006">
        <items id="text">Ökning</items>
        <items id="description">En sekvensförändring där kopietalet för en given region är större än i referenssekvensen.</items>
      </items>
      <items code="at0007">
        <items id="text">Förlust</items>
        <items id="description">En sekvensförändring där kopietalet för en given region är mindre än i referenssekvensen.</items>
      </items>
      <items code="at8999">
        <items id="text">Kvalificerat reellt tal</items>
        <items id="description">Kvalificerat reellt tal</items>
      </items>
      <items code="at0000.1">
        <items id="text">Kopietalsvariant (cancer)</items>
        <items id="description">CNV med Gain/Loss/Amplifiering/Homozygot deletion.</items>
      </items>
      <items code="at9007.1">
        <items id="text">Kopietalsändringstyp värde</items>
        <items id="description">Kodad kopietalsändringstyp inklusive amplifiering och homozygot deletion.</items>
      </items>
      <items code="at0006.1">
        <items id="text">Amplifiering</items>
        <items id="description">Hög kopietalsökning (typiskt &gt;4–6 kopior; labspecifik tröskel).</items>
      </items>
      <items code="at0007.1">
        <items id="text">Homozygot deletion</items>
        <items id="description">Båda alleler deleterade (0 kopior).</items>
      </items>
    </term_definitions>
    <term_bindings terminology="openehr">
      <items code="at8999">
        <value>
          <terminology_id>
            <value>openehr</value>
          </terminology_id>
          <code_string>380</code_string>
        </value>
      </items>
    </term_bindings>
  </component_ontologies>
