                  <items id="description">Chromosome 11.</items>
                </term_definitions>
                <term_definitions code="at0075">
                  <items id="text">Chromosome 12</items>
                  <items id="description">Chromosome 12.</items>
                </term_definitions>
                <term_definitions code="at0076">
                  <items id="text">Chromosome 13</items>
                  <items id="description">Chromosome 13.</items>
                </term_definitions>
                <term_definitions code="at0077">
                  <items id="text">Chromosome 14</items>
                  <items id="description">Chromosome 14.</items>
                </term_definitions>
                <term_definitions code="at0078">
                  <items id="text">Chromosome 15</items>
                  <items id="description">Chromosome 15.</items>
                </term_definitions>
                <term_definitions code="at0079">
                  <items id="text">Chromosome 16</items>
                  <items id="description">Chromosome 16.</items>
                </term_definitions>
                <term_definitions code="at0080">
                  <items id="text">Chromosome 17</items>
                  <items id="description">Chromosome 17.</items>
                </term_definitions>
                <term_definitions code="at0081">
                  <items id="text">Chromosome 18</items>
                  <items id="description">Chromosome 18.</items>
                </term_definitions>
                <term_definitions code="at0082">
                  <items id="text">Chromosome 19</items>
                  <items id="description">Chromosome 19.</items>
                </term_definitions>
                <term_definitions code="at0083">
                  <items id="text">Chromosome 20</items>
                  <items id="description">Chromosome 20.</items>
                </term_definitions>
                <term_definitions code="at0084">
                  <items id="text">Chromosome 21</items>
                  <items id="description">Chromosome 21.</items>
                </term_definitions>
                <term_definitions code="at0085">
                  <items id="text">Chromosome 22</items>
                  <items id="description">Chromosome 22.</items>
                </term_definitions>
                <term_definitions code="at0086">
                  <items id="text">Chromosome X</items>
                  <items id="description">Chromosome X.</items>
                </term_definitions>
                <term_definitions code="at0087">
                  <items id="text">Chromosome Y</items>
                  <items id="description">Chromosome Y.</items>
                </term_definitions>
                <term_definitions code="at0000.1">
                  <items id="text">Sequencing assay</items>
                  <items id="description">Study / assay metadata (sequencing type, kit, nucleic acid, device).</items>
                </term_definitions>
                <term_definitions code="at0.1">
                  <items id="text">Study identifier</items>
                  <items id="description">Identifier of the sequencing/genomic study (FHIR GenomicStudy.identifier).</items>
                </term_definitions>
                <term_definitions code="at0.2">
                  <items id="text">Study type</items>
                  <items id="description">The type of genomic study performed, e.g. SNP detection or CNV detection (FHIR GenomicStudy.type). Multiple occurrences allowed.</items>
                </term_definitions>
                <term_definitions code="at0.4">
                  <items id="text">Study method type</items>
                  <items id="description">Coded method type for the sequencing type (FHIR GenomicStudy.analysis.methodType).</items>
                </term_definitions>
                <term_definitions code="at0.10">
                  <items id="text">Alternative splicing detection</items>
                  <items id="description">Identification of multiple different processed mRNA transcripts from the same DNA template</items>
                </term_definitions>
                <term_definitions code="at0.11">
                  <items id="text">Chromatin conformation</items>
                  <items id="description">Analysis of the spacial organization of chromatin within a cell</items>
                </term_definitions>
                <term_definitions code="at0.12">
                  <items id="text">CNV detection</items>
                  <items id="description">Detection of a change in the number of copies of a defined region of genomic DNA sequence resulting in structural variation when compared to the reference sequence</items>
                </term_definitions>
                <term_definitions code="at0.13">
                  <items id="text">Epigenetic Alterations - histone modifications</items>
                  <items id="description">Detection of biochemical modifications covalently bound to the N-terminal tail of a histone protein. These modifications may alter chromatin compaction and gene expression</items>
                </term_definitions>
                <term_definitions code="at0.14">
                  <items id="text">Epigenetic Alterations -DNA methylation</items>
                  <items id="description">Detection of the presence of an additional methyl group on a DNA nucleobase, which may alter gene transcription</items>
                </term_definitions>
                <term_definitions code="at0.15">
                  <items id="text">Familial variant segregation</items>
                  <items id="description">Determining if a variant identified in an individual is present in other family members</items>
                </term_definitions>
                <term_definitions code="at0.16">
                  <items id="text">Functional variation detection</items>
                  <items id="description">Detection of sequence variants which may alter gene expression or gene product function when compared to the reference sequence</items>
                </term_definitions>
                <term_definitions code="at0.17">
                  <items id="text">Gene expression profiling</items>
                  <items id="description">Measurement and characterization of activity from all gene products</items>
                </term_definitions>
                <term_definitions code="at0.18">
                  <items id="text">Post-translational Modification Identification</items>
                  <items id="description">Detection of biochemical modifications covalently bound to the amino acid monomers of a processed protein</items>
                </term_definitions>
                <term_definitions code="at0.19">
                  <items id="text">SNP Detection</items>
                  <items id="description">Determination of which nucleotide is base present at a known variable location of the genomic sequence</items>
                </term_definitions>
                <term_definitions code="at0.20">
                  <items id="text">STR count</items>
                  <items id="description">Quantification of the number of sequential microsatellite units in a repetitive sequence region</items>
                </term_definitions>
                <term_definitions code="at0.21">
                  <items id="text">Structural variation detection</items>
                  <items id="description">Detection of deletions, insertions, or rearrangements of DNA segments compared to the reference sequence</items>
                </term_definitions>
                <term_definitions code="at0.30">
                  <items id="text">Sequence analysis of select exons (targeted NGS panel)</items>
                  <items id="description">HL7 genomic-study-method-type: sequence-analysis-of-select-exons.</items>
                </term_definitions>
                <term_definitions code="at0.31">
                  <items id="text">Sequence analysis of the entire coding region (WES/WGS)</items>
                  <items id="description">HL7 genomic-study-method-type: sequence-analysis-of-the-entire-coding-region.</items>
                </term_definitions>
                <term_definitions code="at0.32">
                  <items id="text">Next-generation / massively parallel sequencing</items>
                  <items id="description">HL7 genomic-study-method-type: ngs-mps.</items>
                </term_definitions>
                <term_definitions code="at0.33">
                  <items id="text">Fluorescence in situ hybridization (FISH)</items>
                  <items id="description">HL7 genomic-study-method-type: fish.</items>
                </term_definitions>
                <term_definitions code="at0.34">
                  <items id="text">PCR</items>
                  <items id="description">HL7 genomic-study-method-type: pcr.</items>
                </term_definitions>
                <term_definitions code="at0.35">
                  <items id="text">Bi-directional Sanger sequence analysis</items>
                  <items id="description">HL7 genomic-study-method-type: bi-directional-sanger-sequence-analysis.</items>
                </term_definitions>
                <term_definitions code="at0.36">
                  <items id="text">Karyotyping</items>
                  <items id="description">HL7 genomic-study-method-type: karyotyping.</items>
                </term_definitions>
                <term_definitions code="at0.37">
                  <items id="text">Multiplex ligation-dependent probe amplification (MLPA)</items>
                  <items id="description">HL7 genomic-study-method-type: mlpa.</items>
                </term_definitions>
                <term_definitions code="at0.38">
                  <items id="text">Methylation analysis</items>
                  <items id="description">HL7 genomic-study-method-type: methylation-analysis.</items>
                </term_definitions>
                <term_definitions code="at0036.0">
                  <items id="text">Sequencing device / panel</items>
                  <items id="description">Instrument or kit/panel product used for sequencing.</items>
                </term_definitions>
                <term_definitions code="at0038.0">
                  <items id="text">Reference genome</items>
                  <items id="description">Reference sequence used for alignment (e.g. GRCh38).</items>
                </term_definitions>
              </children>
              <children xsi:type="C_ARCHETYPE_ROOT">
                <rm_type_name>CLUSTER</rm_type_name>
                <occurrences>
                  <lower_included>true</lower_included>
                  <upper_included>false</upper_included>
                  <lower_unbounded>false</lower_unbounded>
                  <upper_unbounded>true</upper_unbounded>
