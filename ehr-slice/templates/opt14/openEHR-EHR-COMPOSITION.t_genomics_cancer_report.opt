    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Prov</items>
        <items id="description">Ursprungs- och/eller extraherat prov (förälder–barn via föräldraprovidentitet).</items>
      </items>
      <items code="at0001">
        <items id="text">Laboritoriets providentifierare</items>
        <items id="description">En unik providentifierare för provmaterialet, vanligen angiven av laboratoriet.</items>
      </items>
      <items code="at0003">
        <items id="text">Ursprungsprovets identifierare</items>
        <items id="description">Unik identifierare för ursprungsprovet, där provmaterialet har delats upp i delprover.</items>
      </items>
      <items code="at0005">
        <items id="text">Riskvarning</items>
        <items id="description">Identifierad hälsofara eller biologisk fara för provtagaren eller laboratoriepersonalen vid exponering för eller kontakt med provmaterialet.</items>
      </items>
      <items code="at0007">
        <items id="text">Provtagningsmetod</items>
        <items id="description">Den metod som används för att ta provet.</items>
      </items>
      <items code="at0008">
        <items id="text">Provtagningskontext</items>
        <items id="description">Den kontext i vilken provet togs.</items>
      </items>
      <items code="at0013">
        <items id="text">Anatomisk lokalisation</items>
        <items id="description">Kroppsplats och lateralitet vid provtagning.</items>
      </items>
      <items code="at0015">
        <items id="text">Datum/tid för provtagning</items>
        <items id="description">Datum och tid för när provtagningen ska äga rum eller har ägt rum.</items>
      </items>
      <items code="at0027">
        <items id="text">Fysiska egenskaper</items>
        <items id="description">Provmaterialets fysiska dimensioner, massa eller icke mätbara egenskaper.</items>
      </items>
      <items code="at0029">
        <items id="text">Provtyp ELLER Typ av provmaterial</items>
        <items id="description">Typ av provmaterial</items>
      </items>
      <items code="at0034">
        <items id="text">Datum/tid ankomst</items>
        <items id="description">Datum och tid när provmaterialet togs emot av laboratoriet.</items>
      </items>
      <items code="at0041">
        <items id="text">Analysbarhet</items>
        <items id="description">Information om huruvida provmaterialet var av tillräcklig kvalitet för analys.</items>
      </items>
      <items code="at0042">
        <items id="text">Provkvalitetsproblem</items>
        <items id="description">Ett specifikt kvalitetsproblem med provmaterialet.</items>
      </items>
      <items code="at0045">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligare fritext om provmaterialet som inte omfattas av andra datafält.</items>
      </items>
      <items code="at0052">
        <items id="text">Hemolyserat</items>
        <items id="description">Provmaterialet var hemolyserat.</items>
      </items>
      <items code="at0053">
        <items id="text">Lipemiskt</items>
        <items id="description">Provmaterialet var lipemiskt.</items>
      </items>
      <items code="at0054">
        <items id="text">Felaktigt additiv</items>
        <items id="description">Ett felaktigt tillsatsmedel, såsom ett transportmedium eller konserveringsmedel, tillsattes till provmaterialet.</items>
      </items>
      <items code="at0055">
        <items id="text">Otillräcklig mängd</items>
        <items id="description">Den tillgängliga mängden provmaterial var otillräcklig för att genomföra undersökningen.</items>
      </items>
      <items code="at0062">
        <items id="text">Tillfredställande</items>
        <items id="description">Provmaterialet är av tillfredsställande kvalitet.</items>
      </items>
      <items code="at0063">
        <items id="text">Otillfredsställande - behandlat</items>
        <items id="description">Provmaterialet är av otillfredsställande kvalitet men har analyserats.</items>
      </items>
      <items code="at0064">
        <items id="text">Otillfredsställande - ej behandlat</items>
        <items id="description">Provmaterialet är av otillfredsställande kvalitet och har inte analyserats.</items>
      </items>
      <items code="at0067">
        <items id="text">Provtagningsmiljö</items>
        <items id="description">Den fysiska miljö i vilken provmaterialet samlades in.</items>
      </items>
      <items code="at0068">
        <items id="text">Information om bearbetning</items>
        <items id="description">Strukturerade detaljer om beredning eller bearbetning av provmaterialet.</items>
      </items>
      <items code="at0070">
        <items id="text">Provtagaridentifierare</items>
        <items id="description">Identifierare av den person eller organisation som ansvarar för provtagningen.</items>
      </items>
      <items code="at0071">
        <items id="text">Detaljer om provtagaren</items>
        <items id="description">Den person eller organisation som ansvarar för provtagningen.</items>
      </items>
      <items code="at0079">
        <items id="text">Beskrivning av provtagning</items>
        <items id="description">Fritextbeskrivning av provtagningen.</items>
      </items>
      <items code="at0080">
        <items id="text">Antal provbehållare</items>
        <items id="description">Det totala antalet enheter som provmaterialet är distribuerat i. 
  </items>
      </items>
      <items code="at0083">
        <items id="text">Provbearbetning</items>
        <items id="description">Fixering och annan bearbetning (t.ex. FFPE); i Additional details-slot.</items>
      </items>
      <items code="at0085">
        <items id="text">Detaljer om provbehållare</items>
        <items id="description">Detaljer om provbehållare som har använts.</items>
      </items>
      <items code="at0087">
        <items id="text">Provkälla</items>
        <items id="description">Identifiering av den anatomiska positionen eller annat ställe som provet är taget från.</items>
      </items>
      <items code="at0088">
        <items id="text">Extern identifierare</items>
        <items id="description">En unik identifierare för provmaterial som anges av en extern part utanför laboratoriet.</items>
      </items>
      <items code="at0089">
        <items id="text">Ikteriskt</items>
        <items id="description">Provmaterialet var ikteriskt.</items>
      </items>
      <items code="at0090">
        <items id="text">Hanteringsfel</items>
        <items id="description">Ett fel inträffade vid hantering av provmaterialet. Till exempel: Felaktig lagring eller trasig behållare.</items>
      </items>
      <items code="at0091">
        <items id="text">Ålder</items>
        <items id="description">Provmaterialet var för gammalt för att analysera eller för att analysera korrekt.</items>
      </items>
      <items code="at0092">
        <items id="text">Tekniskt fel</items>
        <items id="description">Provmaterialet kunde inte analyseras på grund av tekniska skäl.</items>
      </items>
      <items code="at0093">
        <items id="text">Transportdetaljer</items>
        <items id="description">Strukturerade detaljer om transport av provmaterialet.</items>
      </items>
      <items code="at0094">
        <items id="text">Koagulerat</items>
        <items id="description">Provmaterialet var koagulerat.</items>
      </items>
      <items code="at0095">
        <items id="text">Felaktig märkning</items>
        <items id="description">Provmaterialet var felaktigt märkt.</items>
      </items>
      <items code="at0096">
        <items id="text">Digital representation</items>
        <items id="description">Strukturerade detaljer om digital representation av provmaterialet.</items>
      </items>
      <items code="at0097">
        <items id="text">Beskrivning av provmaterial ELLER Provbeskrivning</items>
        <items id="description">Beskrivning av det provmaterial som undersöks.</items>
      </items>
      <items code="at0098">
        <items id="text">Provmaterialets benämning</items>
        <items id="description">Namn eller etikett som beskriver provmaterialet.</items>
      </items>
      <items code="at0099">
        <items id="text">Antal fragment</items>
        <items id="description">Antal vävnadsfragment som ingår i provmaterialet.</items>
      </items>
      <items code="at0100">
        <items id="text">Lagringsdetaljer</items>
        <items id="description">Strukturerade detaljer om förvaringen av provmaterialet.</items>
      </items>
