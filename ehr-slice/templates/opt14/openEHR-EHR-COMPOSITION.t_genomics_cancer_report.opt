  <component_ontologies archetype_id="openEHR-EHR-CLUSTER.genetic_variant_presence.v0">
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Genetic variant presence</items>
        <items id="description">Detected / not detected (draft archetype).</items>
      </items>
      <items code="at0001">
        <items id="text">Variant name</items>
        <items id="description">The name of the variant.</items>
      </items>
      <items code="at0002">
        <items id="text">Finding</items>
        <items id="description">The presence or absence of the variant.</items>
      </items>
      <items code="at0003">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the genetic variant presence not captured in other elements.</items>
      </items>
      <items code="at0004">
        <items id="text">Present</items>
        <items id="description">The target variant is present.</items>
      </items>
      <items code="at0005">
        <items id="text">Absent</items>
        <items id="description">The target variant is absent.</items>
      </items>
      <items code="at0006">
        <items id="text">No call</items>
        <items id="description">No data are available to confirm the presence/absence of the variant.</items>
      </items>
      <items code="at0007">
        <items id="text">Indeterminate</items>
        <items id="description">The result is indeterminate.</items>
      </items>
    </term_definitions>
    <term_definitions language="sv">
      <items code="at0000">
        <items id="text">Genetisk variantförekomst</items>
        <items id="description">Påvisad / ej påvisad (utkastarketyp).</items>
      </items>
      <items code="at0001">
        <items id="text">Variantnamn</items>
        <items id="description">Variantens namn.</items>
      </items>
      <items code="at0002">
        <items id="text">Fynd</items>
        <items id="description">Förekomst eller frånvaro av varianten.</items>
      </items>
      <items code="at0003">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligare fritext om förekomst av den genetiska varianten som inte fångas i andra element.</items>
      </items>
      <items code="at0004">
        <items id="text">Förekommer</items>
