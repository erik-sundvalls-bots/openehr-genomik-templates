template (adl_version=2.0.6; rm_release=1.1.0; uid=1b90427e-54d8-4bee-8b2f-0835e385b19a)
	openEHR-EHR-COMPOSITION.t_genomics_cancer_report.v1.0.0

specialize
	openEHR-EHR-COMPOSITION.report-result.v1

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"Erik Sundvall / RCC Genomik (draft)">
				["organisation"] = <"Regionala cancercentrum i samverkan / Karolinska">
			>
		>
	>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"Erik Sundvall / RCC Genomik (draft)">
		["organisation"] = <"Regionala cancercentrum i samverkan">
		["date"] = <"2026-10-15">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Swedish RCC cancer genomics result report (Konfigurationsunderlag genomik / T1 Genomikrapport). Event Assessment composition: report-result wrapping laboratory_test_result with specimen (+ anatomical_location, specimen_processing), receiving organisation, sequencing_assay (+ device), genomic_variant_result-cancer (+ CNV-cancer, clinical implication, presence, translocation, substitution), and TMB/MSI/HRD/tumour-cellularity analytes. Request linkage via protocol Test request details / Requester order identifier.">
			use = <"Fill slots per inventory. Genomic findings and sequencing_assay follow CKM Molecular Pathology Report placement (Test result / Testing details) even where current laboratory_test_result.v1.2.8 slot regexes list only analyte|panel and device — see docs/template-oet-gaps.md. Narrow value sets in Better/OPT after ADL2→1.4.">
			keywords = <"genomics", "cancer", "report", "RCC", "molecular pathology", "TMB", "MSI", "HRD">
			copyright = <"© Regionala cancercentrum i samverkan">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Svensk RCC cancergenomikrapport (Konfigurationsunderlag genomik / T1 Genomikrapport). Event Assessment: report-result med laboratorieresultat, prov, organisation, sekvenseringsassay, cancer-varianter och TMB/MSI/HRD.">
			use = <"Fyll slotar enligt inventering. Se docs/template-oet-gaps.md för slot-/OET-luckor. Begränsa värdemängder i Better/OPT efter ADL2→1.4.">
			keywords = <"genomik", "cancer", "rapport", "RCC", "TMB", "MSI", "HRD">
			copyright = <"© Regionala cancercentrum i samverkan">
		>
	>
	licence = <"Creative Commons Attribution-ShareAlike 4.0 International">
	custodian_namespace = <"se.rcc">
	custodian_organisation = <"Regionala cancercentrum i samverkan">

definition
	COMPOSITION[id1.1] matches {	-- Genomics cancer report
		content matches {
			use_archetype OBSERVATION[id0.1, openEHR-EHR-OBSERVATION.t_genomics_lab_result.v1] occurrences matches {1}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Genomics cancer report">
				description = <"Result report for cancer genomic testing (Swedish RCC).">
			>
			["id0.1"] = <
				text = <"Genomic laboratory test result">
				description = <"Laboratory test result constrained for cancer genomics: specimens, assay, variants and biomarkers.">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Genomikrapport – cancer">
				description = <"Resultatrapport för cancergenomisk testning (RCC).">
			>
			["id0.1"] = <
				text = <"Genomiskt laboratorieresultat">
				description = <"Laboratorieresultat begränsat för cancergenomik: prover, assay, varianter och biomarkörer.">
			>
		>
	>

-----------------------------------------------------------------------------------------------
template_overlay
	openEHR-EHR-OBSERVATION.t_genomics_lab_result.v1.0.0

specialize
	openEHR-EHR-OBSERVATION.laboratory_test_result.v1

definition
	OBSERVATION[id1.1] matches {	-- Genomic laboratory test result
		/data[id2]/events[id3]/data[id4]/items matches {
			use_archetype CLUSTER[id66.1, openEHR-EHR-CLUSTER.t_specimen_genomics.v1] occurrences matches {1..*}
			use_archetype CLUSTER[id98.1, openEHR-EHR-CLUSTER.t_analyte_tmb.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id98.2, openEHR-EHR-CLUSTER.t_analyte_msi.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id98.3, openEHR-EHR-CLUSTER.t_analyte_hrd.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id98.4, openEHR-EHR-CLUSTER.t_analyte_tumour_cellularity.v1] occurrences matches {0..*}
			use_archetype CLUSTER[id98.5, openEHR-EHR-CLUSTER.t_gvr_cancer.v1] occurrences matches {0..*}
		}
		/protocol[id5]/items matches {
			use_archetype CLUSTER[id18.1, openEHR-EHR-CLUSTER.organisation.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id111.1, openEHR-EHR-CLUSTER.t_sequencing_assay.v1] occurrences matches {0..*}
			use_archetype CLUSTER[id111.2, openEHR-EHR-CLUSTER.device.v1] occurrences matches {0..*}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Genomic laboratory test result">
				description = <"Laboratory test result for cancer genomic analysis.">
			>
			["id66.1"] = <
				text = <"Specimen">
				description = <"Source and/or extracted specimen (parent–child via Parent specimen identifier).">
			>
			["id98.1"] = <
				text = <"TMB">
				description = <"Tumor mutational burden analyte (mut/Mb).">
			>
			["id98.2"] = <
				text = <"MSI">
				description = <"Microsatellite instability status analyte.">
			>
			["id98.3"] = <
				text = <"HRD">
				description = <"Homologous recombination deficiency score / interpretation analyte.">
			>
			["id98.4"] = <
				text = <"Tumour cellularity">
				description = <"Pathologist and/or bioinformatic tumour cellularity / fraction.">
			>
			["id98.5"] = <
				text = <"Genomic variant result (cancer)">
				description = <"Cancer genomic finding with ASCO/AMP, ESCAT, origin, and clinical implications.">
			>
			["id18.1"] = <
				text = <"Receiving laboratory">
				description = <"Laboratory organisation (HSA identifiers).">
			>
			["id111.1"] = <
				text = <"Sequencing assay">
				description = <"Study / assay metadata (sequencing type, kit, nucleic acid, device).">
			>
			["id111.2"] = <
				text = <"Sequencing / panel device">
				description = <"Device or panel product when not nested under sequencing_assay.">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Genomiskt laboratorieresultat">
				description = <"Laboratorieresultat för cancergenomisk analys.">
			>
			["id66.1"] = <
				text = <"Prov">
				description = <"Ursprungs- och/eller extraherat prov (förälder–barn via föräldraprovidentitet).">
			>
			["id98.1"] = <
				text = <"TMB">
				description = <"Tumörmutationsbörda (mut/Mb).">
			>
			["id98.2"] = <
				text = <"MSI">
				description = <"Mikrosatellitinstabilitetsstatus.">
			>
			["id98.3"] = <
				text = <"HRD">
				description = <"Homolog rekombinationsbrist – poäng / tolkning.">
			>
			["id98.4"] = <
				text = <"Tumörcellshalt">
				description = <"Patologens och/eller bioinformatisk tumörcellshalt / fraktion.">
			>
			["id98.5"] = <
				text = <"Genetiskt variantresultat (cancer)">
				description = <"Cancergenomiskt fynd med ASCO/AMP, ESCAT, ursprung och kliniska implikationer.">
			>
			["id18.1"] = <
				text = <"Mottagande laboratorium">
				description = <"Laboratorieorganisation (HSA-identiteter).">
			>
			["id111.1"] = <
				text = <"Sekvenseringsassay">
				description = <"Studie-/assaymetadata (sekvenseringstyp, kit, nukleinsyra, enhet).">
			>
			["id111.2"] = <
				text = <"Sekvenserings-/panelenhet">
				description = <"Enhet eller panelprodukt när den inte nästlas under sequencing_assay.">
			>
		>
	>

