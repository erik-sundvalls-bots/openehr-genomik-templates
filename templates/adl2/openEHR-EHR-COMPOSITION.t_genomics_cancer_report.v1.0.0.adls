			>
			["id9002.1"] = <
				text = <"Analyte name">
				description = <"Constrained to tumour cellularity / fraction labels.">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Tumörcellshalt">
				description = <"Patologens eller bioinformatisk tumörcellshalt / fraktion.">
			>
			["id9002.1"] = <
				text = <"Analytnamn">
				description = <"Begränsat till tumörcellshalt / fraktion-etiketter.">
