template_overlay
	openEHR-EHR-CLUSTER.t_sequencing_assay.v1.0.0

specialize
	openEHR-EHR-CLUSTER.sequencing_assay.v0

definition
	CLUSTER[id1.1] matches {	-- Sequencing assay filled
		/items matches {
			use_archetype CLUSTER[id37.1, openEHR-EHR-CLUSTER.device.v1] occurrences matches {0..*}
			use_archetype CLUSTER[id39.1, openEHR-EHR-CLUSTER.reference_sequence.v1] occurrences matches {0..1}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Sequencing assay">
				description = <"Genomic study / assay metadata.">
			>
			["id37.1"] = <
				text = <"Sequencing device / panel">
				description = <"Instrument or kit/panel product used for sequencing.">
			>
			["id39.1"] = <
				text = <"Reference genome">
				description = <"Reference sequence used for alignment (e.g. GRCh38).">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Sekvenseringsassay">
				description = <"Genomisk studie-/assaymetadata.">
			>
			["id37.1"] = <
				text = <"Sekvenseringsenhet / panel">
				description = <"Instrument eller kit/panelprodukt för sekvensering.">
			>
			["id39.1"] = <
				text = <"Referensgenom">
				description = <"Referenssekvens för alignment (t.ex. GRCh38).">
			>
		>
	>

