template_overlay
	openEHR-EHR-CLUSTER.t_analyte_tumour_cellularity.v1.0.0

specialize
	openEHR-EHR-CLUSTER.laboratory_test_analyte.v1

definition
	CLUSTER[id1.1] matches {	-- Tumour cellularity
		/items[id25]/value matches {
			DV_TEXT[id9002.1] matches {
				value matches {"Tumour cellularity", "Tumor cellularity", "Tumörcellshalt", "Tumour fraction", "Tumor fraction", "Tumörfraktion", "Bioinformatic tumour fraction", "Bioinformatisk tumörfraktion"}
			}
		}
	}

