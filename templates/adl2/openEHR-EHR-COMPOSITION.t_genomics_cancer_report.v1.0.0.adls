template_overlay
	openEHR-EHR-CLUSTER.t_analyte_tmb.v1.0.0

specialize
	openEHR-EHR-CLUSTER.laboratory_test_analyte.v1

definition
	CLUSTER[id1.1] matches {	-- TMB
		/items[id25]/value matches {
			DV_TEXT[id9002.1] matches {
				value matches {"TMB", "Tumor mutational burden", "Tumour mutational burden", "Tumörmutationsbörda"}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"TMB">
				description = <"Tumor mutational burden laboratory analyte.">
			>
			["id9002.1"] = <
				text = <"Analyte name">
				description = <"Fixed to TMB / Tumor mutational burden.">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"TMB">
				description = <"Tumörmutationsbörda – laboratorieanalyt.">
			>
			["id9002.1"] = <
				text = <"Analytnamn">
				description = <"Låst till TMB / Tumörmutationsbörda.">
			>
		>
	>

