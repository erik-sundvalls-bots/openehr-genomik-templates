template_overlay
	openEHR-EHR-CLUSTER.t_specimen_genomics.v1.0.0

specialize
	openEHR-EHR-CLUSTER.specimen.v1

definition
	CLUSTER[id1.1] matches {	-- Specimen (genomics)
		/items matches {
			use_archetype CLUSTER[id14.1, openEHR-EHR-CLUSTER.anatomical_location.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id84.1, openEHR-EHR-CLUSTER.specimen_processing.v1] occurrences matches {0..*}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Specimen">
				description = <"Laboratory specimen for genomic testing.">
			>
			["id14.1"] = <
				text = <"Anatomical location">
				description = <"Body site and laterality of collection.">
			>
			["id84.1"] = <
				text = <"Specimen processing">
				description = <"Fixation and other processing (e.g. FFPE); in Additional details slot.">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Prov">
				description = <"Laboratorieprov för genomisk analys.">
			>
			["id14.1"] = <
				text = <"Anatomisk lokalisation">
				description = <"Kroppsplats och lateralitet vid provtagning.">
			>
			["id84.1"] = <
				text = <"Provbearbetning">
				description = <"Fixering och annan bearbetning (t.ex. FFPE); i Additional details-slot.">
			>
		>
	>

