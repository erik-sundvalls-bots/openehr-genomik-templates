specialize
	openEHR-EHR-CLUSTER.specimen.v1

definition
	CLUSTER[id1.1] matches {	-- Specimen (genomics)
		/items[id30]/value matches {
			DV_CODED_TEXT[id9002.1] matches {
				defining_code matches {[ac0.1]}	-- Specimen type (genomics)
			}
		}
		/items[id8]/value matches {
			DV_CODED_TEXT[id9012.1] matches {
				defining_code matches {[ac0.2]}	-- Collection method (genomics)
			}
		}
		/items matches {
			use_archetype CLUSTER[id14.1, openEHR-EHR-CLUSTER.anatomical_location.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id84.1, openEHR-EHR-CLUSTER.t_specimen_processing_genomics.v1] occurrences matches {0..*}
		}
	}

