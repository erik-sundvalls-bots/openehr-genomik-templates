template_overlay
	openEHR-EHR-CLUSTER.t_gvr_cancer.v1.0.0

specialize
	openEHR-EHR-CLUSTER.genomic_variant_result-cancer.v1

definition
	CLUSTER[id1.1] matches {	-- Genomic variant result (cancer) filled
		/items matches {
			use_archetype CLUSTER[id46.1, openEHR-EHR-CLUSTER.genomic_copy_number_variant-cancer.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.2, openEHR-EHR-CLUSTER.genomic_substitution_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.3, openEHR-EHR-CLUSTER.genomic_deletion_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.4, openEHR-EHR-CLUSTER.genomic_insertion_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.5, openEHR-EHR-CLUSTER.genomic_deletion_insertion_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id0.7.1, openEHR-EHR-CLUSTER.variant_clinical_implication.v1] occurrences matches {0..*}
			use_archetype CLUSTER[id99.1, openEHR-EHR-CLUSTER.genetic_variant_presence.v0] occurrences matches {0..1}
			use_archetype CLUSTER[id99.2, openEHR-EHR-CLUSTER.translocation_variant.v0] occurrences matches {0..1}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Genomic variant result (cancer)">
				description = <"Cancer genomic finding with nested structured variant and implications.">
			>
			["id46.1"] = <
				text = <"Copy number variant (cancer)">
				description = <"CNV with Gain/Loss/Amplification/Homozygous deletion.">
			>
			["id46.2"] = <
				text = <"Substitution variant">
				description = <"SNV / substitution structured detail.">
			>
			["id46.3"] = <
				text = <"Deletion variant">
				description = <"Deletion structured detail.">
			>
			["id46.4"] = <
				text = <"Insertion variant">
				description = <"Insertion structured detail.">
			>
			["id46.5"] = <
				text = <"Deletion-insertion variant">
				description = <"Indel structured detail.">
			>
			["id0.7.1"] = <
				text = <"Clinical implication">
				description = <"Diagnostic and/or therapeutic implication for this variant.">
			>
			["id99.1"] = <
				text = <"Genetic variant presence">
				description = <"Detected / not detected (draft archetype).">
			>
			["id99.2"] = <
				text = <"Translocation / fusion structure">
				description = <"Structural detail for rearrangements (draft; REVIEWSUSPENDED on CKM).">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Genetiskt variantresultat (cancer)">
				description = <"Cancergenomiskt fynd med nästlad strukturerad variant och implikationer.">
			>
			["id46.1"] = <
				text = <"Kopietalsvariant (cancer)">
				description = <"CNV med Gain/Loss/Amplifiering/Homozygot deletion.">
			>
			["id46.2"] = <
				text = <"Substitutionsvariant">
				description = <"SNV / substitution – strukturerad detalj.">
			>
			["id46.3"] = <
				text = <"Deletionsvariant">
				description = <"Deletion – strukturerad detalj.">
			>
			["id46.4"] = <
				text = <"Insertionsvariant">
				description = <"Insertion – strukturerad detalj.">
			>
			["id46.5"] = <
				text = <"Deletions-insertionsvariant">
				description = <"Indel – strukturerad detalj.">
			>
			["id0.7.1"] = <
				text = <"Klinisk implikation">
				description = <"Diagnostisk och/eller terapeutisk implikation för varianten.">
			>
			["id99.1"] = <
				text = <"Genetisk variantförekomst">
				description = <"Påvisad / ej påvisad (utkastarketyp).">
			>
			["id99.2"] = <
				text = <"Translokation / fusionsstruktur">
				description = <"Strukturdetalj för rearrangemang (utkast).">
			>
		>
	>

