template_overlay
	openEHR-EHR-CLUSTER.t_gvr_cancer.v1.0.0

specialize
	openEHR-EHR-CLUSTER.genomic_variant_result-cancer.v1

definition
	CLUSTER[id1.1.1] matches {	-- Genomic variant result (cancer) filled
		/items matches {
			use_archetype CLUSTER[id46.0.1, openEHR-EHR-CLUSTER.genomic_copy_number_variant-cancer.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.0.2, openEHR-EHR-CLUSTER.genomic_substitution_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.0.3, openEHR-EHR-CLUSTER.genomic_deletion_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.0.4, openEHR-EHR-CLUSTER.genomic_insertion_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id46.0.5, openEHR-EHR-CLUSTER.genomic_deletion_insertion_variant.v1] occurrences matches {0..1}
			use_archetype CLUSTER[id0.7.1, openEHR-EHR-CLUSTER.variant_clinical_implication.v1] occurrences matches {0..*}
			use_archetype CLUSTER[id99.0.1, openEHR-EHR-CLUSTER.genetic_variant_presence.v0] occurrences matches {0..1}
			use_archetype CLUSTER[id99.0.2, openEHR-EHR-CLUSTER.translocation_variant.v0] occurrences matches {0..1}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1.1"] = <
