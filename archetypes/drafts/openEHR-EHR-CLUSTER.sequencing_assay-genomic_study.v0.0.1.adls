archetype (adl_version=2.0.6; rm_release=1.1.0; uid=9d1c5a3e-6b0f-4a8e-9a43-0b6f4c7e2a11)
	openEHR-EHR-CLUSTER.sequencing_assay-genomic_study.v0.0.1

specialize
	openEHR-EHR-CLUSTER.sequencing_assay.v0

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"Erik Sundvall">
			>
		>
	>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"Erik Sundvall">
		["date"] = <"2026-10-16">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Local specialisation of CLUSTER.sequencing_assay adding a genomic study identifier and a coded study type, and offering a coded method type for Sequencing type. Fills the gaps 'studie_id' and 'analystyp' until equivalent elements exist in the CKM archetype.">
			use = <"Use in place of CLUSTER.sequencing_assay where the study identifier and study type must be recorded, e.g. for mapping to FHIR GenomicStudy.">
			keywords = <"genomic study", "study type", "sequencing", "GenomicStudy">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Lokal specialisering av CLUSTER.sequencing_assay som lägger till studieidentifierare och kodad analystyp samt kodad metodtyp för Sekvenseringstyp. Täcker luckorna 'studie_id' och 'analystyp' tills motsvarande element finns i CKM-arketypen.">
			use = <"Använd i stället för CLUSTER.sequencing_assay när studieidentifierare och analystyp ska registreras, t.ex. för mappning till FHIR GenomicStudy.">
			keywords = <"genomisk studie", "analystyp", "sekvensering", "GenomicStudy">
		>
	>

definition
	CLUSTER[id1.1] matches {	-- Sequencing assay (genomic study)
		/items[id2]/value matches {
			DV_TEXT[id9002]
			DV_CODED_TEXT[id0.4] matches {
				defining_code matches {[ac0.2]}	-- Genomic study method type
			}
		}
		/items matches {
			ELEMENT[id0.1] occurrences matches {0..1} matches {	-- Study identifier
				value matches {
					DV_IDENTIFIER[id0.5]
				}
			}
			ELEMENT[id0.2] occurrences matches {0..*} matches {	-- Study type
				value matches {
					DV_CODED_TEXT[id0.6] matches {
						defining_code matches {[ac0.1]}	-- Genomic study type
					}
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Sequencing assay (genomic study)">
				description = <"Sequencing assay extended with genomic study identifier and study type, aligned with the FHIR Genomics Reporting GenomicStudy profile.">
			>
			["id0.1"] = <
				text = <"Study identifier">
				description = <"Identifier of the sequencing/genomic study (FHIR GenomicStudy.identifier).">
			>
			["id0.2"] = <
				text = <"Study type">
				description = <"The type of genomic study performed, e.g. SNP detection or CNV detection (FHIR GenomicStudy.type). Multiple occurrences allowed.">
			>
			["id0.4"] = <
				text = <"Study method type">
				description = <"Coded method type for the sequencing type (FHIR GenomicStudy.analysis.methodType).">
			>
			["ac0.1"] = <
				text = <"Genomic study type">
				description = <"HL7 Genomics Reporting genomic-study-type code system.">
			>
			["ac0.2"] = <
				text = <"Genomic study method type">
				description = <"Subset of HL7 Genomics Reporting genomic-study-method-type code system.">
			>
			["at0.10"] = <
				text = <"Alternative splicing detection">
				description = <"Identification of multiple different processed mRNA transcripts from the same DNA template">
			>
			["at0.11"] = <
				text = <"Chromatin conformation">
				description = <"Analysis of the spacial organization of chromatin within a cell">
			>
			["at0.12"] = <
				text = <"CNV detection">
				description = <"Detection of a change in the number of copies of a defined region of genomic DNA sequence resulting in structural variation when compared to the reference sequence">
			>
			["at0.13"] = <
				text = <"Epigenetic Alterations - histone modifications">
				description = <"Detection of biochemical modifications covalently bound to the N-terminal tail of a histone protein. These modifications may alter chromatin compaction and gene expression">
			>
			["at0.14"] = <
				text = <"Epigenetic Alterations -DNA methylation">
				description = <"Detection of the presence of an additional methyl group on a DNA nucleobase, which may alter gene transcription">
			>
			["at0.15"] = <
				text = <"Familial variant segregation">
				description = <"Determining if a variant identified in an individual is present in other family members">
			>
			["at0.16"] = <
				text = <"Functional variation detection">
				description = <"Detection of sequence variants which may alter gene expression or gene product function when compared to the reference sequence">
			>
			["at0.17"] = <
				text = <"Gene expression profiling">
				description = <"Measurement and characterization of activity from all gene products">
			>
			["at0.18"] = <
				text = <"Post-translational Modification Identification">
				description = <"Detection of biochemical modifications covalently bound to the amino acid monomers of a processed protein">
			>
			["at0.19"] = <
				text = <"SNP Detection">
				description = <"Determination of which nucleotide is base present at a known variable location of the genomic sequence">
			>
			["at0.20"] = <
				text = <"STR count">
				description = <"Quantification of the number of sequential microsatellite units in a repetitive sequence region">
			>
			["at0.21"] = <
				text = <"Structural variation detection">
				description = <"Detection of deletions, insertions, or rearrangements of DNA segments compared to the reference sequence">
			>
			["at0.30"] = <
				text = <"Sequence analysis of select exons (targeted NGS panel)">
				description = <"HL7 genomic-study-method-type: sequence-analysis-of-select-exons.">
			>
			["at0.31"] = <
				text = <"Sequence analysis of the entire coding region (WES/WGS)">
				description = <"HL7 genomic-study-method-type: sequence-analysis-of-the-entire-coding-region.">
			>
			["at0.32"] = <
				text = <"Next-generation / massively parallel sequencing">
				description = <"HL7 genomic-study-method-type: ngs-mps.">
			>
			["at0.33"] = <
				text = <"Fluorescence in situ hybridization (FISH)">
				description = <"HL7 genomic-study-method-type: fish.">
			>
			["at0.34"] = <
				text = <"PCR">
				description = <"HL7 genomic-study-method-type: pcr.">
			>
			["at0.35"] = <
				text = <"Bi-directional Sanger sequence analysis">
				description = <"HL7 genomic-study-method-type: bi-directional-sanger-sequence-analysis.">
			>
			["at0.36"] = <
				text = <"Karyotyping">
				description = <"HL7 genomic-study-method-type: karyotyping.">
			>
			["at0.37"] = <
				text = <"Multiplex ligation-dependent probe amplification (MLPA)">
				description = <"HL7 genomic-study-method-type: mlpa.">
			>
			["at0.38"] = <
				text = <"Methylation analysis">
				description = <"HL7 genomic-study-method-type: methylation-analysis.">
			>
		>
		["sv"] = <
			["id1.1"] = <
				text = <"Sekvenseringsanalys (genomisk studie)">
