            >
            ["at76"] = <
                text = <"Benign">
                description = <"Benign variant.">
            >
            ["at77"] = <
                text = <"Heteroplasmic">
                description = <"Heteroplasmic.">
            >
            ["at78"] = <
                text = <"Homoplasmic">
                description = <"Homoplasmic.">
            >
