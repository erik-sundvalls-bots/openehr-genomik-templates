                comment = <"In some situations, a single OBSERVATION.laboratory_test_result archetype will contain multiple CLUSTER.specimen archetypes and multiple CLUSTER.genomic_variant_result archetypes. In these situations, this 'Specimen identifier' data element is needed to be able to connect the results with the correct specimens.">
            >
