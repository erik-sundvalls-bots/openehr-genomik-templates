                text = <"Homozygous">
                description = <"Homozygous.">
            >
            ["at80"] = <
                text = <"Heterozygous">
                description = <"Heterozygous.">
            >
            ["at81"] = <
                text = <"Hemizygous">
                description = <"Hemizygous.">
            >
            ["at86"] = <
                text = <"Wild type">
                description = <"The sequence at a given position is identical to the reference sequence.">
            >
            ["at87"] = <
                text = <"Deletion">
                description = <"A deletion in the amino acid sequence.">
            >
            ["at88"] = <
                text = <"Duplication">
                description = <"A duplication in the amino acid sequence.">
            >
            ["at89"] = <
                text = <"Frameshift">
                description = <"A frameshift in the amino acid sequence.">
            >
            ["at90"] = <
                text = <"Initiating methionine">
                description = <"A variant in a sequence affecting the translation initiation codon.">
            >
            ["at91"] = <
                text = <"Insertion">
                description = <"An insertion in the amino acid sequence.">
            >
            ["at92"] = <
                text = <"Insertion and deletion">
                description = <"An insertion/deletion in the amino acid sequence.">
            >
            ["at93"] = <
                text = <"Missense">
                description = <"One amino acid is replaced by another amino acid.">
            >
            ["at94"] = <
                text = <"Nonsense">
                description = <"An amino acid is replaced by a translational stop codon (termination codon).">
            >
            ["at95"] = <
                text = <"Silent">
                description = <"A variant in a DNA sequence that does not change the amino acid sequence of the encoded protein.">
            >
            ["at96"] = <
                text = <"Stop codon mutation">
                description = <"A variant in a sequence affecting the translational stop codon.">
            >
            ["at97"] = <
                text = <"First">
                description = <"First part of a fusion gene.">
            >
            ["at98"] = <
                text = <"Second">
                description = <"Second part of a fusion gene.">
            >
            ["id99"] = <
                text = <"Additional details">
                description = <"Additional details to be captured.">
                comment = <"*For example, there may be a need to attach a file that contains a representation of the variant description in different recognised format, such as GA4GH VRS or HL7 FHIR. In such cases, the archetype openEHR-EHR-CLUSTER.media_file.v1, or other relevant one, can be included in this slot for this purpose. (en)">
            >
            ["id100"] = <
                text = <"Distance from splicing site">
                description = <"Distance in nucleotides between mutation and exon–intron junction.">
            >
            ["id101"] = <
                text = <"RNA change">
                description = <"Description of the variation at the RNA level following the HGVS nomenclature.">
                comment = <"For example: \"r.76a>u\".">
            >
            ["id102"] = <
                text = <"Variant">
                description = <"Description of the variation at the genomic level following the HGVS nomenclature.">
                comment = <"For example: \"g.33038255C>A\".

If both this element and the \"Structured variant\" SLOT are used simultaneously, they need to represent identical data.">
            >
            ["id103"] = <
                text = <"Variant identification">
                description = <"A reference to a specific variation recorded into an external biological variation database.">
                comment = <"For example: rs123456 (Item name) from dbSNP (Knowledge base name) version 151 (Knowledge base version). This CLUSTER.knowledge_base_reference archetype is repeatable to allow several different IDs from different databases for the same variant.">
            >
            ["ac9000"] = <
                text = <"Amino acid change type (synthesised)">
                description = <"Codified type for associated Amino Acid Marker. (synthesised)">
            >
            ["at9001"] = <
                text = <"* Qualified real (en)">
                description = <"* Qualified real (en)">
            >
            ["ac9002"] = <
                text = <"Part of fusion (synthesised)">
                description = <"States if the Gene is part of a Fusion Gene and if it is the first or second part of the Fusion Gene. (synthesised)">
            >
