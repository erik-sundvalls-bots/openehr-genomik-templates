                description = <"Name of the quality filter.">
                comment = <"For example: 'q10'.">
            >
            ["id64"] = <
                text = <"Description">
                description = <"Quality filter extended description.">
                comment = <"For example: 'at this site the quality is below 10'.">
            >
            ["id65"] = <
                text = <"Filter passed">
                description = <"Did the variant pass the quality filter?">
                comment = <"Record as 'True' if the filter was passed.">
            >
