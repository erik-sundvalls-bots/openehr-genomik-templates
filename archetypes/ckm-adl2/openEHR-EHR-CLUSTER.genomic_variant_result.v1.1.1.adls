        ["nb"] = <
            ["id1"] = <
                text = <"Genetisk variant resultat">
                description = <"Funn og annotasjon av en enkelt variant, funnet ved hjelp av en genetisk undersøkelse, hos et menneskelig individ.">
            >
            ["id2"] = <
                text = <"Bioinformatisk pipeline">
                description = <"Strukturerte detaljer om den bioinformatiske pipeline (Bioinformatics analysis workflow) som er brukt i analysen eller hvilken protokoll som er brukt.">
            >
            ["id3"] = <
                text = <"Referansegenom">
                description = <"Strukturerte detaljer om den spesifikke versjonen av det humane referansegenomet brukt for annoteringen.">
                comment = <"For eksempel: \"GCF_000001405.38\" 

Source name: NCBI
Accession number: GCF_000001405
Version number: GCF_000001405.38
URL: https://www.ncbi.nlm.nih.gov/assembly/GCF_000001405.38/">
            >
            ["id9"] = <
                text = <"Transkript">
                description = <"Strukturerte detaljer om transkriptet som potensielt påvirker varianten.">
            >
            ["id10"] = <
                text = <"Transkriptreferansesekvens">
                description = <"Strukturerte detaljer om den transkriberte referansesekvensen.">
                comment = <"For eksempel: 
Source name: NCBI
Accession number: NM_015557
Version number: NM_015557.2
URL: https://www.ncbi.nlm.nih.gov/nuccore/304361774">
            >
            ["id11"] = <
                text = <"DNA regionnavn">
                description = <"Et menneskelig lesbart navn for den aktuelle DNA regionen.">
                comment = <"For eksempel: Exon nummer (#), intron nummer (#), spleisesete (splice site) eller annet.">
            >
            ["id12"] = <
                text = <"DNA-endring">
                description = <"Beskrivelse av DNA varianten i henhold til HGVS nomenklaturen.">
                comment = <"For eksempel: \"c.5249C>T\".">
            >
            ["id13"] = <
                text = <"Aminosyre-endring">
                description = <"Beskrivelse av varianten i proteinet (aminosyreendringen) i henhold til HGVS nomenklaturen.">
                comment = <"For eksempel: \"p.T1750M\".">
            >
            ["id14"] = <
                text = <"Type aminosyreendring">
                description = <"Kodet verdi for aminosyreendringen.">
            >
            ["id16"] = <
                text = <"Predikert betydning">
                description = <"Antatt betydning varianten kan ha på transkripsjonen.">
            >
            ["id17"] = <
                text = <"Prediksjons kunnskapsbase">
                description = <"Strukturert detaljer om kunnskapbasen som er brukt til å kalkulere den predikerte betydningen.">
                comment = <"For eksempel: \"CADD\", \"SIFT\", m.fl.">
            >
            ["id18"] = <
                text = <"Prediksjonsskår">
                description = <"Den beregnede prediksjonsverdien.">
                comment = <"For eksempel: '30.2'.">
            >
            ["id19"] = <
                text = <"Kvalitativ prediksjon">
                description = <"Menneskelig lesbar versjon av den predikerte betydningen.">
                comment = <"For eksempel: 'sannsynlig skadelig'.">
            >
            ["id20"] = <
                text = <"Gen">
                description = <"Detaljer om genet som inneholder varianten.">
            >
            ["id21"] = <
                text = <"Gensymbol">
                description = <"Det offisielle nomenklaturen til genet godkjent av HGNC, som er en kortversjon av det genetiske navnet.">
                comment = <"For eksempel: \"CHD5\".">
            >
            ["id22"] = <
                text = <"Gen navn">
                description = <"Det fullstendige navnet på genet, godkjent av HGNC, som beskriver karakteren eller funksjonen til genet.
">
                comment = <"For eksempel: \"Chromodomain helicase DNA binding protein 5\".">
            >
            ["id24"] = <
                text = <"Beste transkriptkandidat">
                description = <"ID til det transkriptet med den høyeste predikerte betydningen.">
                comment = <"For eksempel: 'ENST00000413998.7'.">
            >
            ["id25"] = <
                text = <"Bevaring">
                description = <"Strukturerte detaljer om den evolusjonære bevaringen. Engelsk: Conservation.">
            >
            ["id26"] = <
                text = <"Bevaringspoeng kunnskapsbase">
                description = <"Detaljer om verktøyet brukt til å kalkulere bevaringspoeng. Engelsk: conservation score.">
                comment = <"For eksempel: \"PhastCons7-way\".">
            >
            ["id27"] = <
                text = <"Poeng">
                description = <"Det tildelte bevaringspoenget. Engelsk: conservation score.">
            >
            ["id29"] = <
                text = <"Allel dybde">
                description = <"Antall avlesninger (\"reads\") for hvert allel som støtter den rapporterte varianten. På engelsk: Allele depth.">
            >
            ["id30"] = <
                text = <"Populasjonsallelfrekvens detaljer">
                description = <"Den relative frekvensen av et bestemt allel i befolkningen.">
            >
            ["id31"] = <
                text = <"Populasjonsallelfrekvens kunnskapsbase">
                description = <"Strukturert detaljer om kunnskapsbasen som er brukt til å kalkulere allelefrekvensen i populasjonen.">
            >
            ["id32"] = <
                text = <"Poulasjonens allelfrekvens">
                description = <"Populasjonenens allelfrekvens.">
                comment = <"For eksempel: '0.43'.">
            >
            ["id40"] = <
                text = <"Genotype">
                description = <"Genotype kodet som allelverdier.">
                comment = <"Genotypen kodet som en allelverdi separert med enten \"/\" eller \"|\" (0 for referanseallelet, 1 for det første allelet, osv.). For eksempel '1 | 0' or '0/0/1'.">
            >
            ["id41"] = <
                text = <"Allel-tilstand">
                description = <"Nivået på forekomst av en enkelt DNA-markør i et sett med kromosomer.">
                comment = <"Dette er den menneskelige lesbare versjonen av en genotype, f.eks. \"heterozygot\", \"homozygot\".">
            >
            ["id42"] = <
                text = <"Genotypekvalitet">
                description = <"Genotypekvalitet angitt som Phred-kvalitet skår.">
            >
            ["id46"] = <
                text = <"Strukturert variantbeskrivelse">
                description = <"Strukturert beskrivelse av genvarianten.">
                comment = <"Dette elementet kan ha multiple forekomster slik at man i et templat eller brukergrensesnitt kan tilby registrering av flere forskjellige varianttyper. Ved lagring av dataen skal det allikevel ikke brukes mer enn en CLUSTER-arketype her.

Hvis både dette SLOTet og \"Variant\" dataelementet brukes samtidig, må disse representere det samme.">
            >
            ["id48"] = <
                text = <"Allelfrekvens">
                description = <"Den relative frekvensen av et allel i et bestemt lokus Engelsk: Allele frequency.

">
                comment = <"For eksempel: '0.63'.">
            >
            ["id53"] = <
                text = <"Funksjonell betydning">
                description = <"Tolkning av mutasjonen knyttet til en bestemt publikasjon.">
            >
            ["id54"] = <
                text = <"Kilde">
                description = <"Referanse til den spesifikke publikasjonen.">
            >
            ["id55"] = <
                text = <"Betydning">
                description = <"Et enkelt ord eller frase som beskriver den rapporterte innvirkning av den spesifikke varianten.">
                comment = <"For eksempel: 'aktivering', 'deaktivering', 'dysfunksjon', 'økt funksjon'. Koding med termonologi er foretrukket om mulig.">
            >
            ["id57"] = <
                text = <"Kopitalloverlapp">
                description = <"Andelen av genregionen som er dekket av kopitall.">
            >
            ["id58"] = <
                text = <"Fusjonsgen-del">
                description = <"Oppgir om dette genet er en del av et fusjonsgen, og om dette er den første eller andre delen av det fusjonerte genet.">
            >
            ["id59"] = <
                text = <"ACMG klassifikasjon">
                description = <"Klassifisering av genetiske sekvensvarianter med hensyn til patogenitet i henhold til ACMGs anbefalinger.">
            >
            ["id60"] = <
                text = <"Fusjonsekson">
                description = <"Nummeret til eksonet som enten er slutten eller begynnelsen av fusjonen.">
            >
            ["id61"] = <
                text = <"Lesedybde">
                description = <"Lesedybden for det spesifikke området.">
            >
            ["id62"] = <
                text = <"VCF kvalitetsfilter">
                description = <"Detaljer om kvalitetfilteret som har blitt brukt på dataene.">
                comment = <"Dette feltet er avledet fra FILTER-kolonnen til VCF (Variant Call Format).">
            >
            ["id63"] = <
                text = <"Filternavn">
                description = <"Navnet på kvalitetfilteret.">
                comment = <"For eksempel: \"q10\".">
            >
            ["id64"] = <
                text = <"Filterbeskrivelse">
                description = <"Ytterligere beskrivelse av kvalitetfilteret.">
                comment = <"Fot eksempel: \"på dette filteret er kvaliteten under 10\".">
            >
            ["id65"] = <
                text = <"Filter passert">
                description = <"Passerte varianten kvalitetsfilter?">
                comment = <"Registrer som \"sann\" (true) hvis varianten oppfyller (passerer) kvalitetsfilteret.">
            >
            ["id68"] = <
                text = <"Strand bias ratio">
                description = <"Ratioen til strand bias (skjevhet/metodefeil).">
            >
            ["id69"] = <
                text = <"Strand bias p-verdi">
                description = <"Phred-skalaens p-verdi for strand bias.">
            >
            ["id70"] = <
                text = <"Genotypesannsynlighet">
                description = <"Alle mulig sannsynlige genotyper listet opp i en kommaseparert log10 sannsynlighetsskala.">
            >
            ["id71"] = <
                text = <"Prøvemateriale identifikator">
                description = <"Identifikator for prøvematerialet som brukes til den genetiske testen.">
                comment = <"I enkelte tilfeller vil en enkel Laboratorieresultat-arketype inneholde multiple Prøvemateriale-arketyper og multiple Genetisk variant resultat-arketyper. I disse tilfellene trenger man dette \"Prøvemateriale\" dataelementet for å kunne koble disse resultatene til det riktige prøvematerialet.">
            >
