        ["es"] = <
            ["id1"] = <
                text = <"Muestra">
                description = <"Muestra física recogida de un paciente o relacionada con él, con fines de investigación, examen o análisis.">
                comment = <"Por ejemplo: tejido o fluido corporal.">
            >
            ["id2"] = <
                text = <"Identificador de muestra de laboratorio">
                description = <"Un identificador único de la muestra, normalmente asignado por el laboratorio.">
                comment = <"A veces se le llama Identificador de Acceso. Los contenedores de muestras, por ejemplo, viales o casetes de inclusión para tejidos, tienen sus propios identificadores que pueden registrarse en el elemento \"Identificador de contenedor\" en el arquetipo \"Contenedor de muestras\".">
                fhir_mapping = <"Specimen.accessionIdentifier">
            >
            ["id4"] = <
                text = <"Identificador de muestra origen">
                description = <"Identificador único de la muestra original, donde ésta se divide en submuestras.">
                comment = <"Por ejemplo: una muestra de portaobjetos de histología puede tener un bloque de cera de parafina específico como muestra original.">
            >
            ["id6"] = <
                text = <"Aviso de peligro">
                description = <"Riesgo para la salud o riesgo biológico identificado para el recolector o personal del laboratorio debido a la exposición o contacto con la muestra.">
                comment = <"Por ejemplo: 'Hepatitis B'; \"agente nervioso\". Siempre que sea posible, se prefiere codificar el \"aviso de peligro\" con una terminología.">
            >
            ["id8"] = <
                text = <"Método de recogida">
                description = <"Método de recogida utilizado.">
                comment = <"Por ejemplo: venopunción, biopsia, resección. Siempre que sea posible, se prefiere codificar el método de recogida con una terminología. Si el método de recogida se incluye en el 'Tipo de muestra' mediante códigos precoordinados, este elemento de datos se vuelve redundante.">
                fhir_mapping = <"Specimen.collection.method">
            >
            ["id9"] = <
                text = <"Contexto del muestreo">
                description = <"Contexto por el cual se recoge la muestra.">
                comment = <"Por ejemplo: 'ayuno'; 'vejiga llena'; 'campo estéril'; o instrucciones especiales sobre la manipulación o procesamiento inmediato de la muestra, como \"centrifugar al recibirla\". Este elemento de datos también se utilizará para documentar cualquier desviación en la recogida o manipulación, por ejemplo, que el paciente no había ayunado, incluso cuando así se había solicitado originalmente. Siempre que sea posible, se prefiere la codificación del 'contexto del muestreo' con una terminología.

Si este arquetipo se utiliza dentro de un arquetipo de tipo INSTRUCTION, el contexto reflejará las condiciones previstas o deseadas en la recogida de la muestra. Si este arquetipo es utilizado para representar una fase del proceso del arquetipo ACTION que se correlaciona con la recogida que se está realizando o completando, el contexto reflejará las condiciones que existían en la recogida de la muestra y esto también se puede copiar en el elemento \"Factores de confusión\" del arquetipo OBSERVATION.laboratory_test_result.">
            >
            ["id14"] = <
                text = <"Lugar de origen estructurado">
                description = <"Descripción estructurada del área del cuerpo de donde se recoge la muestra.">
                comment = <"Utilizar arquetipos más detallados para describir zonas anatómicas estructuradas o más complejas, o para dar soporte en el registro del lugar de origen en tiempo de ejecución por parte de la aplicación. Si la zona corporal ha sido identificada n el elemento de datos 'Lugar de origen', este SLOT se vuelve redundante.">
                fhir_mapping = <"Specimen.collection.sourceSite">
            >
            ["id16"] = <
                text = <"Fecha/hora de recogida">
                description = <"Fecha y hora en que se ha ordenado o ha tenido lugar la recogida.">
                comment = <"Esta fecha y hora se registrará principalmente en el timing INSTRUCTION, ACTION u OBSERVATION. Sin embargo, como se trata de una información fundamental, puede resultar útil asociarla también directamente con la muestra misma.">
            >
            ["id28"] = <
                text = <"Propiedades físicas">
                description = <"Dimensiones físicas, masa o propiedades no medibles de la muestra.">
                comment = <"Por ejemplo: Volumen, masa, perímetro, color, olor, turbidez. Este elemento se puede utilizar para especificar las propiedades de la muestra que se recogerá, en el contexto de un arquetipo de tipo INSTRUCTION, o las propiedades de la muestra que se recogió, en el contexto de un arquetipo de tipo ACTION u OBSERVATION. Por ejemplo, una INSTRUCTION puede solicitar la recogida de 20 ml de sangre, mientras que la ACTION correspondiente registra que solo se recogieron 15 ml.">
                fhir_mapping = <"Specimen.collection.quantity">
            >
            ["id30"] = <
                text = <"Tipo de muestra">
                description = <"Tipo de muestra.">
                comment = <"Por ejemplo: sangre venosa, cultivo bacteriano, citología o muestra de tejido. Siempre que sea posible, se prefiere codificar el tipo de muestra con una terminología.">
                fhir_mapping = <"Specimen.type">
            >
            ["id35"] = <
                text = <"Fecha/hora de recepción">
                description = <"Fecha y hora en que se recibió la muestra en el laboratorio.">
                fhir_mapping = <"Specimen.receivedTime">
            >
            ["id42"] = <
                text = <"Adecuación para las pruebas">
                description = <"Información sobre si la muestra era adecuada para la prueba.">
                comment = <"Este elemento está destinado a ser utilizado para registrar un juicio sobre si la calidad de la muestra fue lo suficientemente buena para la prueba y si la prueba se llevó a cabo o no. Siempre que sea posible, se prefiere codificar los problemas de calidad de las muestras con una terminología.">
            >
            ["id43"] = <
                text = <"Problema en calidad de la muestra">
                description = <"Problema en calidad con una muestra específica.">
                comment = <"Siempre que sea posible, se prefiere codificar los problemas de calidad de las muestras con una terminología.">
            >
            ["id46"] = <
                text = <"Comentarios">
                description = <"Información adicional sobre la muestra no registrada en otros campos.">
                fhir_mapping = <"Specimen.note">
            >
            ["at53"] = <
                text = <"Hemolizada">
                description = <"La muestra se encuentra hemolizada.">
            >
            ["at54"] = <
                text = <"Lipémica">
                description = <"La muestra se encuentra lipémica.">
            >
            ["at55"] = <
                text = <"Aditivo incorrecto">
                description = <"Se añadió a la muestra un aditivo incorrecto, como un medio de transporte o un conservante.">
            >
            ["at56"] = <
                text = <"Cantidad insuficiente">
                description = <"La cantidad de muestra disponible es insuficiente para realizar el examen.">
            >
            ["at63"] = <
                text = <"Satisfactoria">
                description = <"La muestra es de una calidad suficiente para permitir la emisión de informes.">
            >
            ["at64"] = <
                text = <"Insatisfactoria - analizada">
                description = <"La muestra no es satisfactoria pero ha sido analizada.">
            >
            ["at65"] = <
                text = <"Insatisfactoria - no analizada">
                description = <"La muestra no es satisfactoria y no ha sido analizada.">
            >
            ["id68"] = <
                text = <"Escenario de recogida">
                description = <"Identificación del entorno físico en el que se recoge la muestra.">
                comment = <"Por ejemplo: laboratorio ambulatorio, a domicilio o en la sala de un hospital. Detalla el tipo de ubicación de recogida de muestras dentro del entorno sanitario. El entorno de recogida de muestras puede proporcionar información adicional relevante para el análisis del resultado.">
            >
            ["id69"] = <
                text = <"Detalles del procesado">
                description = <"Detalles estructurados sobre la preparación o procesado de la muestra.">
                comment = <"Por ejemplo: Tinción o fijación.">
            >
            ["id71"] = <
                text = <"Identificador del colector">
                description = <"Identificador de la persona u organización responsable de recoger la muestra.">
                comment = <"Este elemento está pensado para a ser utilizado cuando la muestra ya ha sido recogida y se conoce al colector real.">
                fhir_mapping = <"Specimen.collection.collector">
            >
            ["id72"] = <
                text = <"Detalles del colector">
                description = <"Persona u organización responsable de recoger la muestra.">
                fhir_mapping = <"Specimen.collection.collector">
            >
            ["id80"] = <
                text = <"Descripción de la recogida">
                description = <"Descripción narrativa sobre la recogida de la muestra.">
            >
            ["id81"] = <
                text = <"Número de recipientes">
                description = <"Número total de unidades físicas que contienen esta muestra.">
                comment = <"Por ejemplo: Número de botes, frascos, viales, tubos, bloques, portaobjetos o rejillas.">
            >
            ["id84"] = <
                text = <"Detalles adicionales">
                description = <"Detalles adicionales sobre la muestra.">
                comment = <"Por ejemplo: detalles sobre biopsias de próstata, donde tanto la solicitud como el informe sobre la muestra son detallados y específicos.">
            >
            ["id86"] = <
                text = <"Detalles del recipiente">
                description = <"Detalles sobre los recipientes utilizados.">
            >
            ["id88"] = <
                text = <"Lugar de origen">
                description = <"Identificación de la zona del cuerpo u otro lugar de donde se recoge la muestra.">
                comment = <"Por ejemplo: 'herida en pantorrilla izquierda', 'cánula intravenosa brazo derecho', 'riñón derecho'.
Siempre que sea posible, se prefiere codificar el nombre del lugar de origen con una terminología. Utilice este elemento de datos para registrar lugares de origen precoordinados. Si los requisitos para registrar el lugar de origen los determina la aplicación en tiempo de ejecución o requieren un modelado más complejo, como ubicaciones relativas, utilizar el SLOT 'Lugar de origen estructurado', dentro de este arquetipo. Si el lugar de origen se incluye en el 'Tipo de muestra' mediante códigos precoordinados, este elemento de datos se vuelve redundante.">
            >
            ["id89"] = <
                text = <"Identificador externo">
                description = <"Un identificador único de la muestra, asignado por un equipo externo al laboratorio.">
                comment = <"Por ejemplo: 'ID del solicitante', 'ID del archivo, 'ID del biobanco'.">
                fhir_mapping = <"Specimen.identifier">
            >
            ["at90"] = <
                text = <"Ictérica">
                description = <"La muestra se encuentra ictérica.">
            >
            ["at91"] = <
                text = <"Error de manejo">
                description = <"Surgió un problema al manipular la muestra. Por ejemplo: almacenamiento incorrecto, contenedor roto.">
            >
            ["at92"] = <
                text = <"Anticuada">
                description = <"La muestra era demasiado anticuada para analizarla o analizarla con precisión.">
            >
            ["at93"] = <
                text = <"Fallo técnico">
                description = <"La muestra no pudo analizarse por motivos técnicos.">
            >
            ["id94"] = <
                text = <"Detalles de transporte">
                description = <"Detalles estructurados sobre el transporte de la muestra.">
            >
            ["at95"] = <
                text = <"Coagulada">
                description = <"La muestra se ha coagulado.">
            >
            ["at96"] = <
                text = <"Etiquetada incorrectamente">
                description = <"La muestra fue etiquetada incorrectamente.">
            >
            ["id97"] = <
                text = <"Representación digital">
                description = <"Detalles estructurados sobre una representación digital de la muestra.">
                comment = <"Por ejemplo, imagen escaneada de un portaobjetos de histopatología.">
            >
            ["id98"] = <
                text = <"Descripción de la muestra">
                description = <"Descripción narrativa sobre la muestra a examinar.">
                comment = <"Por ejemplo: color y viscosidad de un fluido; forma de un tejido sólido; o descripción de fragmentos del tejido.">
            >
            ["id99"] = <
                text = <"Etiqueta de la muestra">
                description = <"Nombre o etiqueta que describa la muestra.">
                comment = <"Por lo general, sólo es relevante para muestras de anatomía patológica. Por ejemplo: 'Resección sigmoidea de un trozo de pared de la vejiga' o 'Agregado de múltiples fragmentos de biopsia de piel'.">
            >
            ["id100"] = <
                text = <"Número de fragmentos">
                description = <"Número de fragmentos de tejido que componen la muestra.">
                comment = <"Por lo general, sólo es relevante cuando se examinan varios fragmentos de tejido y se informan como una sola muestra.">
            >
            ["id101"] = <
                text = <"Detalles de almacenamiento">
                description = <"Detalles estructurados sobre el guardado de la muestra.">
            >
            ["ac9000"] = <
                text = <"Problema en calidad de la muestra (synthesised)">
                description = <"Problema en calidad con una muestra específica. (synthesised)">
            >
            ["ac9001"] = <
                text = <"Adecuación para las pruebas (synthesised)">
                description = <"Información sobre si la muestra era adecuada para la prueba. (synthesised)">
            >
        >
