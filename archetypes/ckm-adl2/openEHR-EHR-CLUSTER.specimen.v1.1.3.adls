        ["ca"] = <
            ["id1"] = <
                text = <"Mostra">
                description = <"Mostra física recollida d'un pacient o relacionada amb ell, amb finalitats de recerca, examen o anàlisi.">
                comment = <"Per exemple: teixit o fluid corporal.">
            >
            ["id2"] = <
                text = <"Identificador de mostra de laboratori">
                description = <"Un identificador únic de la mostra, normalment assignat pel laboratori.">
                comment = <"De vegades se'n diu Identificador d'Accés. Els contenidors de mostres, per exemple, vials o cassets d'inclusió per a teixits, tenen els seus propis identificadors que es poden registrar a l'element \"Identificador de contenidor\" a l'arquetip \"Contenidor de mostres\".">
                fhir_mapping = <"Specimen.accessionIdentifier">
            >
            ["id4"] = <
                text = <"Identificador de mostra origen">
                description = <"Identificador únic de la mostra original, on aquesta es divideix en submostres.">
                comment = <"Per exemple: una mostra de portaobjectes d'histologia pot tenir un bloc de cera de parafina específic com a mostra original.">
            >
            ["id6"] = <
                text = <"Avís de perill">
                description = <"Risc per a la salut o risc biològic identificat per al recol·lector o personal del laboratori a causa de l'exposició o el contacte amb la mostra.">
                comment = <"Per exemple: 'Hepatitis B'; \"agent nerviós\". Sempre que sigui possible, es prefereix codificar l'“avís de perill” amb una terminologia.">
            >
            ["id8"] = <
                text = <"Mètode de recollida">
                description = <"Mètode de recollida utilitzat.">
                comment = <"Per exemple: venopunció, biòpsia, resecció. Sempre que sigui possible, es prefereix codificar el mètode de recollida amb una terminologia. Si el mètode de recollida s'inclou al 'Tipus de mostra' mitjançant codis precoordinats, aquest element de dades es torna redundant.">
                fhir_mapping = <"Specimen.collection.method">
            >
            ["id9"] = <
                text = <"Context del mostreig">
                description = <"Context pel qual es recull la mostra.">
                comment = <"Per exemple: 'dejuni'; 'bufeta plena'; 'camp estèril'; o instruccions especials sobre la manipulació o processament immediat de la mostra, com ara \"centrifugar en rebre-la\". Aquest element de dades també s'utilitzarà per documentar qualsevol desviació a la recollida o manipulació, per exemple, que el pacient no havia dejunat, fins i tot quan així s'havia sol·licitat originalment. Sempre que sigui possible, es prefereix la codificació del 'context del mostreig' amb una terminologia.

Si aquest arquetip s'utilitza dins un arquetip de tipus INSTRUCTION, el context reflectirà les condicions previstes o desitjades a la recollida de la mostra. Si aquest arquetip és utilitzat per representar una fase del procés de l'arquetip ACTION que es correlaciona amb la recollida que s'està realitzant o completant, el context reflectirà les condicions que existien a la recollida de la mostra i això també es pot copiar a l'element \" Factors de confusió\" de l'arquetip OBSERVATION.laboratory_test_result.">
            >
            ["id14"] = <
                text = <"Lloc d'origen estructurat">
                description = <"Descripció estructurada de l'àrea del cos on es recull la mostra.">
                comment = <"Utilitzar arquetips més detallats per descriure zones anatòmiques estructurades o més complexes, o per donar suport al registre del lloc dorigen en temps dexecució per part de laplicació. Si la zona corporal ha estat identificada a l'element de dades 'Lloc d'origen', aquest SLOT es torna redundant.">
                fhir_mapping = <"Specimen.collection.sourceSite">
            >
            ["id16"] = <
                text = <"Data/hora de recollida">
                description = <"Data i hora en què s'ha ordenat o ha tingut lloc la recollida.">
                comment = <"Aquesta data i hora es registrarà principalment al timing INSTRUCTION, ACTION o OBSERVATION. No obstant això, com que es tracta d'una informació fonamental, pot ser útil associar-la també directament amb la mateixa mostra.">
            >
            ["id28"] = <
                text = <"Propietats físiques">
                description = <"Dimensions físiques, massa o propietats no mesurables de la mostra.">
                comment = <"Per exemple: Volum, massa, perímetre, color, olor, terbolesa. Aquest element es pot utilitzar per especificar les propietats de la mostra que es recollirà, en el context d'un arquetip de tipus INSTRUCTION, o les propietats de la mostra que es va recollir, en el context d'un arquetip de tipus ACTION o OBSERVATION. Per exemple, una INSTRUCTION pot sol·licitar la recollida de 20 ml de sang, mentre que l'ACTION corresponent registra que només es van recollir 15 ml.">
                fhir_mapping = <"Specimen.collection.quantity">
            >
            ["id30"] = <
                text = <"Tipus de mostra">
                description = <"Tipus de mostra.">
                comment = <"Per exemple: sang venosa, cultiu bacterià, citologia o mostra de teixit. Sempre que sigui possible, es prefereix codificar el tipus de mostra amb una terminologia.">
                fhir_mapping = <"Specimen.type">
            >
            ["id35"] = <
                text = <"Data/hora de recepció">
                description = <"Data i hora en què es va rebre la mostra al laboratori.">
                fhir_mapping = <"Specimen.receivedTime">
            >
            ["id42"] = <
                text = <"Adequació per a les proves">
                description = <"Informació sobre si la mostra era adequada per a la prova.">
                comment = <"Aquest element està destinat a ser utilitzat per registrar un judici sobre si la qualitat de la mostra va ser prou bona per a la prova i si la prova es va fer o no. Sempre que sigui possible, es prefereix codificar els problemes de qualitat de les mostres amb una terminologia.">
            >
            ["id43"] = <
                text = <"Problema en qualitat de la mostra">
                description = <"Problema de qualitat amb una mostra específica.">
                comment = <"Sempre que sigui possible, es prefereix codificar els problemes de qualitat de les mostres amb una terminologia.">
            >
            ["id46"] = <
                text = <"Comentaris">
                description = <"Informació addicional sobre la mostra no registrada a altres camps.">
                fhir_mapping = <"Specimen.note">
            >
            ["at53"] = <
                text = <"Hemolitzada">
                description = <"La mostra es troba hemolitzada.">
            >
            ["at54"] = <
                text = <"Lipèmica">
                description = <"La mostra es troba lipèmica.">
            >
            ["at55"] = <
                text = <"Additiu incorrecte">
                description = <"S'hi va afegir a la mostra un additiu incorrecte, com un mitjà de transport o un conservant.">
            >
            ["at56"] = <
                text = <"Quantitat insuficient">
                description = <"La quantitat de mostra disponible és insuficient per fer l'examen.">
            >
            ["at63"] = <
                text = <"Satisfactòria">
                description = <"La mostra és de qualitat suficient per permetre l'emissió d'informes.">
            >
            ["at64"] = <
                text = <"Insatisfactòria - analitzada">
                description = <"La mostra no és satisfactòria, però ha estat analitzada.">
            >
            ["at65"] = <
                text = <"Insatisfactòria - no analitzada">
                description = <"La mostra no és satisfactòria i no ha estat analitzada.">
            >
            ["id68"] = <
                text = <"Escenari de recollida">
                description = <"Identificació de l'entorn físic on es recull la mostra.">
                comment = <"Per exemple: laboratori ambulatori, a domicili o a la sala d'un hospital. Detalleu el tipus d'ubicació de recollida de mostres dins l'entorn sanitari. L'entorn de recollida de mostres pot proporcionar informació addicional rellevant per a l'anàlisi del resultat.">
            >
            ["id69"] = <
                text = <"Detalls del processament">
                description = <"Detalls estructurats sobre la preparació o el processament de la mostra.">
                comment = <"Per exemple: Tinció o fixació.">
            >
            ["id71"] = <
                text = <"Identificador del col·lector">
                description = <"Identificador de la persona o organització responsable de recollir la mostra.">
                comment = <"Aquest element està pensat per a ser utilitzat quan la mostra ja ha estat recollida i es coneix el col·lector real.">
                fhir_mapping = <"Specimen.collection.collector">
            >
            ["id72"] = <
                text = <"Detalls del col·lector">
                description = <"Persona o organització responsable de recollir la mostra.">
                fhir_mapping = <"Specimen.collection.collector">
            >
            ["id80"] = <
                text = <"Descripció de la recollida">
                description = <"Descripció narrativa sobre la recollida de la mostra.">
            >
            ["id81"] = <
                text = <"Nombre de recipients">
                description = <"Número total d'unitats físiques que contenen aquesta mostra.">
                comment = <"Per exemple: Nombre de pots, flascons, vials, tubs, blocs, portaobjectes o reixetes.">
            >
            ["id84"] = <
                text = <"Detalls addicionals">
                description = <"Detalls addicionals sobre la mostra.">
                comment = <"Per exemple: detalls sobre biòpsies de pròstata, on tant la sol·licitud com l'informe sobre la mostra són detallats i específics.">
            >
            ["id86"] = <
                text = <"Detalls del recipient">
                description = <"Detalls sobre els recipients utilitzats.">
            >
            ["id88"] = <
                text = <"Lloc d'origen">
                description = <"Identificació de la zona del cos o un altre lloc on es recull la mostra.">
                comment = <"Per exemple: 'ferida en panxell esquerre', 'cànula intravenosa braç dret', 'ronyó dret'.
Sempre que sigui possible, cal codificar el nom del lloc d'origen amb una terminologia. Utilitzeu aquest element de dades per registrar llocs d'origen precoordinats. Si els requisits per registrar el lloc d'origen els determina l'aplicació en temps d'execució o requereixen un modelatge més complex, com ara ubicacions relatives, utilitzeu el SLOT 'Lloc d'origen estructurat', dins aquest arquetip. Si el lloc d'origen s'inclou al 'Tipus de mostra' mitjançant codis precoordinats, aquest element de dades es torna redundant.">
            >
            ["id89"] = <
                text = <"Identificador extern">
                description = <"Un identificador únic de la mostra assignat per un equip extern al laboratori.">
                comment = <"Per exemple: 'ID del sol·licitant', 'ID de l'arxiu, 'ID del biobanc'.">
                fhir_mapping = <"Specimen.identifier">
            >
            ["at90"] = <
                text = <"Ictèrica">
                description = <"La mostra es troba ictèrica.">
            >
            ["at91"] = <
                text = <"Error de maneig">
                description = <"Va sorgir un problema en manipular la mostra. Per exemple: emmagatzematge incorrecte, contenidor trencat.">
            >
            ["at92"] = <
                text = <"Antiquada">
                description = <"La mostra era massa antiquada per analitzar-la o analitzar-la amb precisió.">
            >
