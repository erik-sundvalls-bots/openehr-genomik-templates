            ["id71"] = <
                text = <"Identifiant du préleveur de l'échantillon">
                description = <"Identifiant de la personne ou de l'organisation chargé du prélèvement de l'échantillon.">
                comment = <"Cet élément est destiné à être utilisé lorsque l’échantillon a déjà été prélevé et que l’identité de la personne ayant effectué le prélèvement est connue.">
                fhir_mapping = <"Specimen.collection.collector">
            >
            ["id72"] = <
                text = <"Détails du préleveur de l'échantillon">
                description = <"La personne ou l'organisation chargé du prélèvement de l'échantillon.">
                fhir_mapping = <"Specimen.collection.collector">
            >
            ["id80"] = <
                text = <"Description du prélèvement">
                description = <"Description narrative du prélèvement de l'échantillon.">
            >
            ["id81"] = <
                text = <"Nombre de récipients">
                description = <"Nombre total d'unités physiques contenant cet échantillon.">
                comment = <"Par exemple : nombre de seaux, bocaux, flacons, tubes, blocs, lames ou grilles.">
            >
            ["id84"] = <
                text = <"Détails supplémentaires">
                description = <"Informations structurées supplémentaires concernant l'échantillon.">
                comment = <"Par exemple : les informations relatives aux biopsies à l'aiguille dans le cadre d'un cancer de la prostate, où tant la demande que le compte rendu concernant l'échantillon sont détaillés et précis.">
            >
            ["id86"] = <
                text = <"Détails des récipients">
                description = <"Informations relatives aux récipients utilisés.">
            >
            ["id88"] = <
                text = <"Site corporel de prélèvement">
                description = <"Identification du site corporel ou de tout autre endroit où l'échantillon a été prélevé.">
                comment = <"Par exemple : « plaie au mollet gauche », « canule intraveineuse au bras droit », « rein droit ».
Dans la mesure du possible, il est préférable de coder le nom du site source à l’aide d’une terminologie. Utilisez cet élément de données pour enregistrer les sites sources précoordonnés. Si les exigences relatives à l’enregistrement du site source sont déterminées au moment de l’exécution par l’application ou nécessitent une modélisation plus complexe, telle que des emplacements relatifs, utilisez alors le slot « Site corporel de prélèvement structuré » de cet archétype. Si le site source est inclus dans le « Type d’échantillon » via des codes précoordonnés, cet élément de données devient redondant.">
            >
            ["id89"] = <
                text = <"Identifiant externe">
