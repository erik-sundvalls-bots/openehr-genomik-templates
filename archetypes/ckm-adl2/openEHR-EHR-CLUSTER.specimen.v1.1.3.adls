        ["fr"] = <
            ["id1"] = <
                text = <"Échantillon">
                description = <"Échantillon physique prélevé sur une personne ou lié à celle-ci à des fins d’enquête, d’examen ou d’analyse.">
                comment = <"Par exemple : un tissu ou un liquide biologique.">
            >
            ["id2"] = <
                text = <"Identifiant de l'échantillon de laboratoire">
                description = <"Identifiant unique de l'échantillon, généralement attribué par le laboratoire.">
                comment = <"Parfois appelé « identifiant d’enregistrement ». Les récipients contenant les échantillons, par exemple les tubes sous vide ou les cassettes de tissus, possèdent leurs propres identifiants qui peuvent être enregistrés dans l’élément « Identifiant du récipient » de l’archétype « Récipient pour échantillons ».">
                fhir_mapping = <"Specimen.accessionIdentifier">
            >
            ["id4"] = <
                text = <"Identifiant de l'échantillon parent">
                description = <"Identifiant unique de l’échantillon parent, lorsque celui-ci est divisé en sous-échantillons.">
                comment = <"Par exemple : un échantillon spécifique destiné à une préparation histologique peut avoir pour échantillon d'origine un bloc de paraffine spécifique.">
            >
            ["id6"] = <
                text = <"Avertissement de danger">
                description = <"Risque sanitaire ou risque biologique identifié pour le préleveur ou le personnel de laboratoire en raison d’une exposition à l’échantillon ou d’un contact avec celui-ci.">
                comment = <"Par exemple : « hépatite B » ; « agent neurotoxique ». Il est préférable, dans la mesure du possible, de coder l’« avertissement de danger » à l’aide d’une terminologie spécifique.">
            >
            ["id8"] = <
                text = <"Méthode de prélèvement">
                description = <"La méthode de prélèvement utilisée.">
                comment = <"Par exemple : ponction veineuse, biopsie, résection. Il est préférable, dans la mesure du possible, de coder la méthode de prélèvement à l’aide d’une terminologie. Si la méthode de prélèvement est incluse dans le champ « Type d’échantillon » via des codes précoordonnés, cet élément de données devient redondant.">
                fhir_mapping = <"Specimen.collection.method">
            >
            ["id9"] = <
                text = <"Conditions de prélèvement">
                description = <"Le contexte dans lequel l'échantillon est prélevé.">
                comment = <"Par exemple : « à jeun » ; « vessie pleine » ; « champ stérile » ; ou des instructions spéciales concernant la manipulation ou le traitement immédiat de l’échantillon, telles que « centrifuger dès réception ». Cet élément de données peut également servir à consigner tout écart connu par rapport aux instructions de prélèvement ou de manipulation, par exemple le fait que le patient n’ait pas été à jeun, même si cela avait été initialement demandé. Il est préférable, dans la mesure du possible, de coder les « Conditions de prélèvement » à l’aide d’une terminologie.

Si cet archétype est utilisé au sein d’un archétype INSTRUCTION, le contexte reflétera les conditions prévues ou souhaitées lors du prélèvement de l’échantillon. Si cet archétype est utilisé pour représenter une étape d’un parcours d’archétype ACTION qui correspond au prélèvement en cours ou achevé, le contexte reflétera les conditions qui existaient au moment du prélèvement de l’échantillon et celles-ci pourront également être copiées dans l’élément « Facteurs de confusion » de l’archétype OBSERVATION.laboratory_test_result.">
            >
            ["id14"] = <
                text = <"Site corporel de prélèvement structuré">
                description = <"Description structurée de la partie du corps sur laquelle l'échantillon a été prélevé.">
                comment = <"Utiliser les archétypes plus détaillés pour décrire des sites anatomiques structurés ou plus complexes, ou pour faciliter l’enregistrement du site source par l’application lors de son exécution. Si le site corporel a été entièrement identifié dans l’élément de données « Site source », ce slot devient superflu.">
                fhir_mapping = <"Specimen.collection.sourceSite">
            >
            ["id16"] = <
                text = <"Date/heure de prélèvement">
                description = <"La date/heure auxquelles le prélèvement a été prescrit à avoir lieu ou a eu lieu.">
                comment = <"Cette date et cette heure seront principalement saisies dans les champs de timing « INSTRUCTION », ou de date/heure « ACTION » ou « OBSERVATION ». Toutefois, comme il s'agit d'une information essentielle, il peut être utile de l'associer également directement à l'échantillon lui-même.">
            >
            ["id28"] = <
                text = <"Propriétés physiques">
                description = <"Dimensions physiques, masse ou propriétés non mesurables de l’échantillon.">
                comment = <"Par exemple : volume, masse, circonférence, couleur, odeur, turbidité. Cet élément peut être utilisé pour préciser les propriétés de l’échantillon à prélever, dans le cadre d’un archétype INSTRUCTION, ou les propriétés de l’échantillon qui a été prélevé, dans le cadre d’un archétype ACTION ou OBSERVATION. Par exemple, une INSTRUCTION peut demander le prélèvement de 20 ml de sang, tandis que l’ACTION correspondante enregistre que seuls 15 ml ont été prélevés.">
                fhir_mapping = <"Specimen.collection.quantity">
            >
            ["id30"] = <
                text = <"Type d'échantillon">
                description = <"Le type d'échantillon.">
                comment = <"Par exemple : sang veineux, culture bactérienne, cytologie ou échantillon tissulaire. Dans la mesure du possible, il est préférable de coder le type d’échantillon à l’aide d’une terminologie spécifique.">
                fhir_mapping = <"Specimen.type">
            >
            ["id35"] = <
                text = <"Date/heure de réception">
                description = <"Date et heure de réception de l'échantillon au laboratoire.">
                fhir_mapping = <"Specimen.receivedTime">
            >
            ["id42"] = <
                text = <"Aptitude à l'analyse">
                description = <"Informations indiquant si l’échantillon était adapté aux examens">
                comment = <"Cet élément est destiné à permettre d’indiquer si la qualité de l’échantillon était suffisante pour permettre la réalisation d’un test, et si ce test a été effectué ou non. Dans la mesure du possible, il est préférable de coder les problèmes liés à la qualité de l’échantillon à l’aide d’une terminologie spécifique.">
            >
            ["id43"] = <
                text = <"Problèmes de qualité de l'échantillon">
                description = <"Problèmes de qualité spécifiques concernant un échantillon.">
                comment = <"Dans la mesure du possible, il est préférable de recourir à une terminologie spécifique pour codifier les problèmes de qualité des échantillons.">
            >
            ["id46"] = <
                text = <"Remarque">
                description = <"Informations supplémentaires concernant l’échantillon qui ne figurent pas dans les autres champs.">
                fhir_mapping = <"Specimen.note">
            >
            ["at53"] = <
                text = <"Hémolysé">
                description = <"L'échantillon était hémolysé.">
            >
            ["at54"] = <
                text = <"Lipémique">
                description = <"L'échantillon était lipémique.">
            >
            ["at55"] = <
